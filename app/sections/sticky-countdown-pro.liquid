          }, 1800);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(done).catch(fallback);
        } else {
          fallback();
        }
        function fallback() {
          try {
            var ta = document.createElement('textarea');
            ta.value = code;
            ta.setAttribute('readonly', '');
            ta.style.position = 'absolute';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            done();
          } catch (e) {}
        }
      });
    }

    function autoDetectThemeHeader() {
      var probes = ['#header-group', 'header.shopify-section.header-section', 'sticky-header', '.header-wrapper'];
      for (var i = 0; i < probes.length; i++) {
        var el = document.querySelector(probes[i]);
        if (el) return el;
      }
      return null;
    }

    function applyLayout() {
      // Shared with ss-sticky-bar: max-height across all bars sets one header-push value.
      // Each section's script runs this idempotently.
      var bodyBars = document.querySelectorAll('[data-ss-bar-body-pad="1"]');
      var targetBars = document.querySelectorAll('[data-ss-bar-target-pad="1"]');

      function maxBottom(list) {
        var m = 0;
        for (var i = 0; i < list.length; i++) {
          var b = list[i];
          if (b.style.display === 'none') continue;
          var h = b.getBoundingClientRect().height;
          var off = parseInt(b.getAttribute('data-ss-bar-top-offset') || '0', 10);
          if (h + off > m) m = h + off;
        }
        return m;
      }

      // Every top bar (sticky OR fixed) defines how far the theme's sticky header must clear.
      if (bodyBars.length || targetBars.length) {
        var offset = Math.max(maxBottom(bodyBars), maxBottom(targetBars));
        document.documentElement.style.setProperty('--ss-bar-target-margin', offset + 'px');
      } else {
        document.documentElement.style.removeProperty('--ss-bar-target-margin');
      }

      // Only fixed bars are out of flow, so only they pad the page down.
      if (bodyBars.length) {
        document.body.style.paddingBlockStart = maxBottom(bodyBars) + 'px';
      } else {
        document.body.style.removeProperty('padding-block-start');
      }
    }

    function initPositioning() {
      var target = null;
      if (targetSelector) {
        try { target = document.querySelector(targetSelector); } catch (e) {}
      } else if (positionMode === 'fixed') {
        target = autoDetectThemeHeader();
      }

      node.setAttribute('data-ss-bar-top-offset', String(topOffset));
      ns[sid].target = target;

      function syncPadFlags() {
        var onMobile = MOBILE_MQ ? MOBILE_MQ.matches : false;
        // Static-on-mobile under the breakpoint: the bar scrolls inline, so it contributes nothing
        // to the shared offset and needs no page padding.
        if (staticOnMobile && onMobile) {
          node.removeAttribute('data-ss-bar-target-pad');
          node.removeAttribute('data-ss-bar-body-pad');
          return;
        }
        // Both flags feed --ss-bar-target-margin (so the theme's sticky header clears the bar).
        // Fixed bars are out of flow and additionally pad the page; sticky bars sit in flow.
        if (positionMode === 'fixed') {
          node.setAttribute('data-ss-bar-body-pad', '1');
          node.removeAttribute('data-ss-bar-target-pad');
        } else {
          node.setAttribute('data-ss-bar-target-pad', '1');
          node.removeAttribute('data-ss-bar-body-pad');
        }
      }

      syncPadFlags();
      ns[sid].syncPadFlags = syncPadFlags;

      // React to viewport crossing the mobile breakpoint so the bar can leave/re-enter the shared
      // header-push stack without a page reload.
      if (MOBILE_MQ && staticOnMobile) {
        var onMqChange = function () { syncPadFlags(); applyLayout(); };
        if (MOBILE_MQ.addEventListener) MOBILE_MQ.addEventListener('change', onMqChange);
        else if (MOBILE_MQ.addListener) MOBILE_MQ.addListener(onMqChange);
        ns[sid].mqListener = onMqChange;
      }

      applyLayout();

      if (typeof ResizeObserver !== 'undefined') {
        // Coalesce resize bursts (common in the theme editor as the panel/iframe resizes) into one
        // layout pass per frame so applyLayout's getBoundingClientRect + body writes don't thrash.
        var roPending = false;
        var ro = new ResizeObserver(function () {
          if (roPending) return;
          roPending = true;
          requestAnimationFrame(function () { roPending = false; applyLayout(); });
        });
        ro.observe(node);
        ns[sid].ro = ro;
      }
    }

    function hideBarPermanently() {
      // Stop the countdown interval so a hidden bar doesn't keep doing work.
      if (ns[sid] && ns[sid].interval) {
        clearInterval(ns[sid].interval);
        ns[sid].interval = null;
      }
      node.style.display = 'none';
      applyLayout();
    }

    function initClose() {
      if (!showClose) return;
      var btn = node.querySelector('[data-ctbp-close]');
      if (!btn) return;

      // Theme editor stays interactive on close so merchants can repeatedly test the dismissal
      // without clearing storage. On the storefront, dismissal persists for the session.
      var isDesignMode = !!(window.Shopify && window.Shopify.designMode);

      if (!isDesignMode) {
        try {
          if (window.sessionStorage && sessionStorage.getItem(CLOSE_STORAGE_KEY) === '1') {
            hideBarPermanently();
            return;
          }
        } catch (e) {}
      }

      btn.addEventListener('click', function () {
        node.setAttribute('data-ctbp-closing', '1');
        if (!isDesignMode) {
          try { sessionStorage.setItem(CLOSE_STORAGE_KEY, '1'); } catch (e) {}
        }
        setTimeout(hideBarPermanently, CLOSE_ANIM_MS);
      });
    }

    function init() {
      // Clear any prior instance for this sid (theme-editor hot reload, morphed HTML, etc.).
      destroyInstance(sid);
      node = document.querySelector('[data-ctbp-id="' + sid + '"]');
      if (!node) return;
      ns[sid] = { interval: null, ro: null };
      initCountdown();
      initCopy();
      initClose();
      initPositioning();
    }

    function cleanup(sectionId) {
      if (!sectionId) return;
      destroyInstance(sectionId);
      setTimeout(applyLayout, 0);
    }

    // Theme editor only; section:load re-runs this inline script so init re-fires on its own.
    // Bound once per page so re-injections don't stack listeners.
    if (!window.__ssCtbpEvtBound) {
      window.__ssCtbpEvtBound = true;
      document.addEventListener('shopify:section:unload', function (e) {
        cleanup(e.detail && e.detail.sectionId);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
