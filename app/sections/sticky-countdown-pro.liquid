      for (var i = 0; i < padded.length; i++) {
        var c = padded.charAt(i);
        html +=
          '<span class="ss-ctbp__digit" data-current="' + c + '">' +
            '<span class="ss-ctbp__digit-card ss-ctbp__digit-card--top"><span class="ss-ctbp__digit-text">' + c + '</span></span>' +
            '<span class="ss-ctbp__digit-card ss-ctbp__digit-card--bot"><span class="ss-ctbp__digit-text">' + c + '</span></span>' +
            '<span class="ss-ctbp__digit-card ss-ctbp__digit-card--flip-top" aria-hidden="true"><span class="ss-ctbp__digit-text">' + c + '</span></span>' +
            '<span class="ss-ctbp__digit-card ss-ctbp__digit-card--flip-bot" aria-hidden="true"><span class="ss-ctbp__digit-text">' + c + '</span></span>' +
          '</span>';
      }
      el.innerHTML = html;
    }

    function flipDigit(digit, newChar, instant) {
      var current = digit.getAttribute('data-current');
      if (current === newChar) return;

      var topText = digit.querySelector('.ss-ctbp__digit-card--top .ss-ctbp__digit-text');
      var botText = digit.querySelector('.ss-ctbp__digit-card--bot .ss-ctbp__digit-text');
      var flipTopText = digit.querySelector('.ss-ctbp__digit-card--flip-top .ss-ctbp__digit-text');
      var flipBotText = digit.querySelector('.ss-ctbp__digit-card--flip-bot .ss-ctbp__digit-text');
      if (!topText || !botText || !flipTopText || !flipBotText) return;

      if (instant || REDUCE_MOTION) {
        topText.textContent = newChar;
        botText.textContent = newChar;
        flipTopText.textContent = newChar;
        flipBotText.textContent = newChar;
        digit.setAttribute('data-current', newChar);
        return;
      }

      // Pre-animation state:
      //   top      = NEW (revealed when flip-top folds down)
      //   bot      = OLD (still visible until flip-bot covers it)
      //   flip-top = OLD (the card that falls forward)
      //   flip-bot = NEW (the card that swings up from 90deg)
      topText.textContent = newChar;
      flipTopText.textContent = current;
      flipBotText.textContent = newChar;
      // bot keeps OLD until the unfold finishes.

      digit.setAttribute('data-current', newChar);
      digit.classList.remove('ss-ctbp__digit--flipping');
      // Force reflow so removing+adding the class restarts the animation.
      void digit.offsetWidth;
      digit.classList.add('ss-ctbp__digit--flipping');

      if (digit._ctbpFlipTimer) clearTimeout(digit._ctbpFlipTimer);
