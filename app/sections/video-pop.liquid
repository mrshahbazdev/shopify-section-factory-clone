          }
          if(document.querySelector('.fixed-video-template--20127418286409__36052f3a-94ef-492d-9ba6-192474fdd6e7 iframe')) {
            let frame = document.querySelector('.fixed-video-frame-template--20127418286409__36052f3a-94ef-492d-9ba6-192474fdd6e7 iframe');
            if(frame.src.includes("youtube")) {
