          if(document.querySelector('.fixed-video-template--20127418286409__36052f3a-94ef-492d-9ba6-192474fdd6e7 video')) {
            document.querySelector('.fixed-video-template--20127418286409__36052f3a-94ef-492d-9ba6-192474fdd6e7 video').muted = true;
