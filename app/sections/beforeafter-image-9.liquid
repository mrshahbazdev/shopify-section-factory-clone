    if (window.Swiper) {
      callback();
    } else {
      const script = document.createElement('script');
      script.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js";
      script.onload = callback;
      document.head.appendChild(script);
    }
  }

  function initBeforeAfterImage9(sectionId) {
    document.querySelector(`.before-slider-${sectionId}`).classList.remove('preview');
    const slider = new Swiper(`.before-slider-${sectionId}`, {
      speed: 300,
      navigation: {
        nextEl: `.before-btn-next-${sectionId}`,
        prevEl: `.before-btn-prev-${sectionId}`,
      },
      breakpoints: {
        320: {
          spaceBetween: parseInt(document.querySelector(`.before-slider-${sectionId}`).dataset.gapMobile || 0),
          slidesPerView: parseFloat(document.querySelector(`.before-slider-${sectionId}`).dataset.viewMobile || 1),
        },
        768: {
          spaceBetween: parseInt(document.querySelector(`.before-slider-${sectionId}`).dataset.gap || 0),
          slidesPerView: parseFloat(document.querySelector(`.before-slider-${sectionId}`).dataset.view || 3),
        },
        1024: {
          spaceBetween: parseInt(document.querySelector(`.before-slider-${sectionId}`).dataset.gap || 0),
          slidesPerView: parseFloat(document.querySelector(`.before-slider-${sectionId}`).dataset.view || 3),
        }
      }
    });
  }

  function initializeAllBeforeAfterImage9Sections() {
    const sections = document.querySelectorAll('[id^="shopify-section-"]');
    sections.forEach(section => {
      if (section.querySelector('.before-template--23085328957769__ss_before_after_image_9_GUDmgN')) {
        const sectionId = section.id.replace('shopify-section-', '');
        loadSwiper(() => initBeforeAfterImage9(sectionId));
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllBeforeAfterImage9Sections);
  } else {
    initializeAllBeforeAfterImage9Sections();
  }

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', (event) => {
      const sectionId = event.detail.sectionId;
      if (event.target.querySelector('.before-template--23085328957769__ss_before_after_image_9_GUDmgN')) {
        loadSwiper(() => initBeforeAfterImage9(sectionId));
      }
    });
  }
</script>
