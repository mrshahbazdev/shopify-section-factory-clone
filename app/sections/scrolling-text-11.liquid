<script>
  (function() {
    const section = document.querySelector('.section-template--26284372033865__ss_scrolling_text_11_bXVPyy');
    if (!section) return;

    const wrap = section.querySelector('.scrolling-pills-wrap-template--26284372033865__ss_scrolling_text_11_bXVPyy');
    const track = section.querySelector('.scrolling-pills-track-template--26284372033865__ss_scrolling_text_11_bXVPyy');
    const baseList = section.querySelector('.scrolling-pills-list-template--26284372033865__ss_scrolling_text_11_bXVPyy[data-base-list]');

    if (!wrap || !track || !baseList) return;

    let resizeFrame;

    baseList.querySelectorAll('img').forEach((image) => {
      if (!image.complete) {
        image.addEventListener('load', () => requestSync(), { once: true });
        image.addEventListener('error', () => requestSync(), { once: true });
      }
    });

    const syncTicker = () => {
      track.removeAttribute('data-ready');
      track.querySelectorAll('.scrolling-pills-list-template--26284372033865__ss_scrolling_text_11_bXVPyy[data-clone="true"]').forEach((clone) => clone.remove());

      const baseWidth = Math.ceil(baseList.getBoundingClientRect().width);
      const wrapWidth = Math.ceil(wrap.getBoundingClientRect().width);

      if (!baseWidth || !wrapWidth) return;

      track.style.setProperty('--ticker-distance', `${baseWidth}px`);

      let totalWidth = baseWidth;
      let guard = 0;
      const minTrackWidth = wrapWidth + baseWidth;

      while (totalWidth < minTrackWidth && guard < 12) {
        const clone = baseList.cloneNode(true);
        clone.removeAttribute('data-base-list');
        clone.setAttribute('data-clone', 'true');
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
        totalWidth += baseWidth;
        guard += 1;
      }

      track.setAttribute('data-ready', 'true');
    };

    const requestSync = () => {
      window.cancelAnimationFrame(resizeFrame);
      resizeFrame = window.requestAnimationFrame(syncTicker);
    };

    requestSync();
    window.addEventListener('load', requestSync, { once: true });
    window.addEventListener('resize', requestSync);

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(requestSync);
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(requestSync);
      resizeObserver.observe(wrap);
      resizeObserver.observe(baseList);
