<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  function initShopTheLook3() {
    const slider = new Swiper(".shop-slider-template--21479660486985__ss_shop_the_look_3_MYNxxC", {
      speed: 300,
      spaceBetween: 20,
      slidesPerView: 1,
      loop: true,
      navigation: {
        nextEl: '.shop-btn-next-template--21479660486985__ss_shop_the_look_3_MYNxxC',
        prevEl: '.shop-btn-prev-template--21479660486985__ss_shop_the_look_3_MYNxxC',
      },
      pagination: {
        el: '.shop-pagination-template--21479660486985__ss_shop_the_look_3_MYNxxC',
        type: 'bullets',
        clickable: true,
      }
    });

    slider.on('slideChange', function () {
      const activeSlideId = slider.slides[slider.activeIndex].id;
      const collectionItems = document.querySelectorAll('.shop-image-template--21479660486985__ss_shop_the_look_3_MYNxxC');
    
      collectionItems.forEach(item => {
        item.classList.remove('active');
        if (item.getAttribute('data-id') === String(activeSlideId)) {
          item.classList.add('active');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initShopTheLook3);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initShopTheLook3);
     document.addEventListener('shopify:section:load', initShopTheLook3);
  }
</script>
</link>
