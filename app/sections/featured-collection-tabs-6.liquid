<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
<script>
  function initFeaturedCollectionTabs6() {
    document.querySelectorAll('.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025').forEach(slider => { 
      setTimeout(() => {slider.classList.remove('preview') }, 500)
    });
    
    const tabs = document.querySelectorAll('.featured-tab-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
    const sliders = document.querySelectorAll('.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
    const buttons = document.querySelectorAll('.featured-button-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
    
    const sectionContainer = document.querySelector('.featured-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
    if(sectionContainer) {
        sectionContainer.style.transition = 'background 0.4s ease';
    }

    function updateSectionBackground(tab) {
        if (!sectionContainer || !tab) return;
        
        const style = tab.getAttribute('data-bg-style');
        const color = tab.getAttribute('data-bg-color');
        const gradient = tab.getAttribute('data-bg-gradient');

        if (style === 'gradient' && gradient) {
            sectionContainer.style.background = gradient;
        } else if (color) {
            sectionContainer.style.background = color;
        }
    }
    
    if (tabs.length > 0 && sliders.length > 0) {
      tabs.forEach(tab => tab.classList.remove('active'));
      sliders.forEach(slider => slider.classList.remove('active'));
      
      tabs[0].classList.add('active');
      sliders[0].classList.add('active');
      
      updateSectionBackground(tabs[0]);
    }
    
    const shape = document.querySelector('.featured-collection-shape-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
    
    function updateShapeColor(swiper) {
      const activeSlide = swiper.slides[swiper.activeIndex];
      const backgroundColor = activeSlide?.dataset?.background;
      
      if (shape && backgroundColor) {
        shape.style.backgroundColor = backgroundColor;
      }
    }
    
    // Sync button widths - ONLY on mobile when both checkboxes are enabled
    function syncButtonWidths() {
      const buttonFullMobile = false;
      const productButtonFullMobile = false;
      
      if (buttonFullMobile && productButtonFullMobile && window.innerWidth <= 1024) {
        const activeSlider = document.querySelector('.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025.active');
        if (!activeSlider) return;
        
        const productButton = activeSlider.querySelector('.featured-product-button-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
        const shopAllButton = activeSlider.querySelector('.featured-button-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
        
        if (productButton && shopAllButton) {
          const productButtonWidth = productButton.offsetWidth;
          shopAllButton.style.width = productButtonWidth + 'px';
          shopAllButton.style.maxWidth = productButtonWidth + 'px';
        }
      } else {
        // Remove fixed width if conditions are not met
        const shopAllButtons = document.querySelectorAll('.featured-button-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025');
        shopAllButtons.forEach(button => {
          button.style.width = '';
          button.style.maxWidth = '';
        });
      }
    }
    
    function initVideoObserver() {
      const observerOptions = {
        root: null, 
        rootMargin: '0px',
        threshold: 0.4 
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target;
          
          if (entry.isIntersecting) {
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(error => {
                console.log('Autoplay prevented by browser (ensure video is muted/playsinline):', error);
              });
            }
          } else {
            video.pause();
          }
        });
      }, observerOptions);

      const sectionVideos = document.querySelectorAll('.section-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025 video');
      sectionVideos.forEach(video => {
        video.muted = true;
        video.playsInline = true; 
        video.loop = true;
        
        observer.observe(video);
      });
    }
    
    const slider = new Swiper(".featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025", {
      speed: 300,
      loop: true,
      centeredSlides: true,
      navigation: {
        nextEl: '.featured-btn-next-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025',
        prevEl: '.featured-btn-prev-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025',
      },
      on: {
        init: function() {
          updateShapeColor(this);
          initVideoObserver();
          setTimeout(syncButtonWidths, 300);
        },
        slideChange: function() {
          updateShapeColor(this);
        }
      },
      breakpoints: {
        320: {
          spaceBetween: parseInt(document.querySelector(`.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025`).dataset.gapMobile || 0),
          slidesPerView: parseFloat(document.querySelector(`.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025`).dataset.viewMobile || 1),
        },
        768: {
          spaceBetween: parseInt(document.querySelector(`.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025`).dataset.gap || 0),
          slidesPerView: parseFloat(document.querySelector(`.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025`).dataset.view || 3),
        },
        1024: {
          spaceBetween: parseInt(document.querySelector(`.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025`).dataset.gap || 0),
          slidesPerView: parseFloat(document.querySelector(`.featured-slider-template--25059444523337__ss_featured_collection_tabs_6_luxury_2025`).dataset.view || 3),
        }
      }
    });

    // Tab switching logic
    if(tabs) {
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          sliders.forEach(slider => {
            slider.classList.remove('active')
          });
          tabs.forEach(tab => {
            tab.classList.remove('active')
          });            
          buttons.forEach(button => {
            button.classList.remove('active')
          }); 
        
          sliders.forEach(slider => {
            if(tab.id === slider.getAttribute('data-id')) {
              slider.classList.add('active');
              tab.classList.add('active');
              
              updateSectionBackground(tab);
              
              const swiperInstance = slider.swiper;
              if (swiperInstance) {
                updateShapeColor(swiperInstance);
              }
              // Re-run video observer to catch videos in the newly revealed tab
              initVideoObserver();
              // Sync button widths after tab change
              setTimeout(syncButtonWidths, 100);
            } else {
              slider.classList.remove('active');
              tab.classList.add('active');
            }
          })

          buttons.forEach(button => {
            if(tab.id === button.getAttribute('data-id')) {
              button.classList.add('active');
              tab.classList.add('active');                 
            } else {
              button.classList.remove('active');
              tab.classList.add('active');
            }
          })
        })        
      })
    }
    
    // Sync on window resize
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(syncButtonWidths, 150);
    });
  }

  document.addEventListener('DOMContentLoaded', initFeaturedCollectionTabs6);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initFeaturedCollectionTabs6);
    document.addEventListener('shopify:section:load', initFeaturedCollectionTabs6);
  }
</script>
