<script>
  function initProductIngredients9() {
    const items = document.querySelectorAll('.ingredients-button-template--24623173763401__ss_product_ingredients_9_FmifaE');
    const contentItems = document.querySelectorAll('.ingredients-content-template--24623173763401__ss_product_ingredients_9_FmifaE');

    if (items.length > 0) {
      items[0].classList.add('active');
    }
    if (contentItems.length > 0) {
      contentItems[0].classList.add('active');
    }

    items.forEach(item => {
      item.addEventListener('click', () => {
        contentItems.forEach(contentItem => {
          contentItem.classList.remove('active');
        });
        items.forEach(item => {
          item.classList.remove('active');
        });

        contentItems.forEach(contentItem => {
          if(item.id === contentItem.getAttribute('data-id')) {
            item.classList.add('active');
            contentItem.classList.add('active');
          }
        });       
      })
    });
  }

  document.addEventListener('DOMContentLoaded', initProductIngredients9);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initProductIngredients9);
     document.addEventListener('shopify:section:load', initProductIngredients9);
  }
</script>
