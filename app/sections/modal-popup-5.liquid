<script>
  function initModalPopupFullscreen() {
    const toggle = document.querySelector('.modal-button-template--26056441528649__ss_modal_popup_5_tqfbcP');
    const modal = document.querySelector('.modal-popup-template--26056441528649__ss_modal_popup_5_tqfbcP');
    const buttonClose = document.querySelector('.modal-button-close-template--26056441528649__ss_modal_popup_5_tqfbcP');
    const close = document.querySelector('.modal-popup-close-template--26056441528649__ss_modal_popup_5_tqfbcP');
    const noThanksButtons = document.querySelectorAll('.modal-popup-no-thanks-template--26056441528649__ss_modal_popup_5_tqfbcP');
    const modalKey = 'modalDisplayedAt_template--26056441528649__ss_modal_popup_5_tqfbcP';

    function openModal() {
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        document.body.style.transform = 'none';
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        document.body.style.transform = '';
      }
    }

    if (toggle) {
      if (buttonClose) {
        buttonClose.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggle.style.display = 'none';
        });
      }

      toggle.addEventListener('click', () => {
        
          openModal();
        
      });
    }

    if (close) {
      close.addEventListener('click', closeModal);
    }

    noThanksButtons.forEach(function(btn) {
      btn.addEventListener('click', closeModal);
    });

    

    

    

    
  }

  document.addEventListener('DOMContentLoaded', initModalPopupFullscreen);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initModalPopupFullscreen);
    document.addEventListener('shopify:section:load', initModalPopupFullscreen);
  }
</script>
