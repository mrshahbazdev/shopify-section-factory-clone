<script>
  function initProductStats() {
    
    const initAnimation = () => {

      
      
        // Анимация процентов - ищем вставленную секцию, а не template
        const section = document.querySelector('.product-stats-template--25309749215561__ss_product_stats_QbLrrB');

        const percentElements = section.querySelectorAll('.product-stats-feature-percent-template--25309749215561__ss_product_stats_QbLrrB');
        
        console.log('[Product Stats] Found', percentElements.length, 'percent elements');
        
        percentElements.forEach((element, index) => {
          const target = parseInt(element.getAttribute('data-target'));
          
          const tempElement = element.cloneNode(true);
          tempElement.textContent = `${target}%`;
          tempElement.style.position = 'absolute';
          tempElement.style.visibility = 'hidden';
          tempElement.style.whiteSpace = 'nowrap';
          document.body.appendChild(tempElement);
          
          const finalWidth = tempElement.offsetWidth + 15;
          
          document.body.removeChild(tempElement);
          
          element.style.minWidth = `${finalWidth}px`;
          element.style.display = 'inline-block';
          element.style.textAlign = 'left';
          
          console.log('[Product Stats] Reserved width for element', index, ':', finalWidth, 'px');
        });
        
        let animated = false;

        const observerOptions = {
          threshold: 0.3,
          rootMargin: '50px'
        };

        const intersectionObserver = new IntersectionObserver((entries) => {

          entries.forEach(entry => {
            console.log('[Product Stats] Intersection:', {
              isIntersecting: entry.isIntersecting,
              ratio: entry.intersectionRatio,
              rect: entry.boundingClientRect
            });
            
            if (entry.isIntersecting) {
              animated = true;
              console.log('[Product Stats] Starting animation...');
              
              percentElements.forEach((element, index) => {
                const target = parseInt(element.getAttribute('data-target'));
                
                let currentPercent = 0;
                
                const duration = 2000; // 2 секунды в миллисекундах
                const startTime = performance.now();

                function animatePercent() {
                  const elapsed = performance.now() - startTime;
                  const progress = Math.min(elapsed / duration, 1);
                  currentPercent = Math.floor(progress * target);
                  
                  element.textContent = `${currentPercent}%`;

                  if (progress < 1) {
                    requestAnimationFrame(animatePercent);
                  } else {
                    element.textContent = `${target}%`; // точное финальное значение
                    console.log('[Product Stats] Animation complete for element', index);
                  }
                }
                
                animatePercent();
              });
              
              intersectionObserver.disconnect();
            }
          });
        }, observerOptions);

        intersectionObserver.observe(section);
        
        // Проверяем сразу - может секция уже видна
        setTimeout(() => {
          const rect = section.getBoundingClientRect();
          const isVisible = rect.top < window.innerHeight && rect.bottom > 0 && rect.height > 0;
          
          if (isVisible && !animated) {
            animated = true;
            
            percentElements.forEach((element, index) => {
              const target = parseInt(element.getAttribute('data-target'));
              
              let currentPercent = 0;
              
              function animatePercent() {
                element.textContent = `${currentPercent}%`;

                if (currentPercent < target) {
                  currentPercent += 1;
                  requestAnimationFrame(animatePercent);
                }
              }
              
              animatePercent();
            });
            
            intersectionObserver.disconnect();
          }
        }, 200);
      
    };

    

    const checkSection = () => {
      const section = document.querySelector('.product-stats-template--25309749215561__ss_product_stats_QbLrrB');
      
      if (section && !section.closest('template')) {
        setTimeout(() => {
          initAnimation();
          
        }, 150);
        return true;
      }
      
      console.log('[Product Stats] Section not inserted yet');
      return false;
    };

    if (checkSection()) return;

    console.log('[Product Stats] Setting up MutationObserver...');
    const mutationObserver = new MutationObserver((mutations) => {
      if (checkSection()) {
        console.log('[Product Stats] Section appeared, stopping observer');
        mutationObserver.disconnect();
      }
    });

    mutationObserver.observe(document.body, {
      childList: true,
      subtree: true
    });
  }

  if (document.readyState === 'loading') {
    console.log('[Product Stats] DOM not ready, waiting for DOMContentLoaded');
    document.addEventListener('DOMContentLoaded', initProductStats);
  } else {
    console.log('[Product Stats] DOM already ready, initializing immediately');
    initProductStats();
  }

  if (Shopify && Shopify.designMode) {
    console.log('[Product Stats] Design mode detected');
    document.addEventListener('shopify:section:unload', () => {
      console.log('[Product Stats] Section unload');
      initProductStats();
    });
    document.addEventListener('shopify:section:load', () => {
      console.log('[Product Stats] Section load');
      initProductStats();
    });
  }
</script>
