<script src="https://cdn.jsdelivr.net/npm/vanilla-lazyload@19.1.3/dist/lazyload.min.js"></script>
<script>
  function loadSwiper(callback) {
    if (window.Swiper) {
      callback();
    } else {
      const script = document.createElement('script');
      script.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js";
      script.onload = callback;
      document.head.appendChild(script);
    }
  }
  
  function initShoppableVideo3(sectionId) {

    
      let lazyLoadInstance = new LazyLoad();
  
      window.addEventListener(
        "LazyLoad::Initialized",
        function (event) {
          window.lazyLoadInstance = event.detail.instance;
        },
        false
      );
    
    
    document.querySelector(`.video-slider-${sectionId}`).classList.remove('preview');
    const slider = new Swiper(`.video-slider-${sectionId}`, {
      speed: 300,
      loop:  true,
      navigation: {
        nextEl: `.video-btn-next-${sectionId}`,
        prevEl: `.video-btn-prev-${sectionId}`
      },
      breakpoints: {
        320: {
          spaceBetween: 8,
          slidesPerView: 1.5
        },
        768: {
          spaceBetween: 8,
          slidesPerView: 4
        },
        1024: {
          spaceBetween: 8,
          slidesPerView: 7
        }
      },
      on: {
        slideChange: function () {
          const slides = this.slides;

          for (let i = 0; i < slides.length; i++) {
            let video = slides[i].querySelector('video');
            
            if (i === this.activeIndex) {
              if (video) {
                video.play();
              }
            } else {
              if (video) {
                video.pause();
              }
            }
          }
        }
      }
    });

    const modalSlider = new Swiper(`.video-modal-slider-${sectionId}`, {
      speed: 300,
      loop:  true,
      direction: 'vertical',
      mousewheel: {
        invert: false,
      },
      slidesPerView: 1,
      navigation: {
        nextEl: `.video-modal-btn-next-${sectionId}`,
        prevEl: `.video-modal-btn-prev-${sectionId}`
      },
      on: {
        slideChange: function () {
          const slides = this.slides;

          for (let i = 0; i < slides.length; i++) {
            let video = slides[i].querySelector('video');
            let sound = slides[i].querySelector(`.video-modal-sound-${sectionId}`);
            
            if (i === this.activeIndex) {
              if (video) {
                video.play();
              }
              
              slides[i].classList.remove('active');
              
            } else {
              if (video) {
                video.pause();
              }
            }
          }
        }
      }
    });

    let slides = document.querySelectorAll(`.video-slide-${sectionId}`);
    let modal = document.querySelector(`.video-modal-${sectionId}`);
    let modalCloses = document.querySelectorAll(`.video-modal-close-${sectionId}`);
    let modalSlides = document.querySelectorAll(`.video-modal-slide-${sectionId}`);

    if(slides) {
      slides.forEach((el, index) => {
        let video = el.querySelector('video');
  
        if(video) {
          video.addEventListener('ended', () => {
            video.pause();
      
            slider.slideNext();
          });
        }
  
        el.addEventListener('click', () => {
          modalSlider.slideToLoop(index);
  
          setTimeout(() => {
            modalSlider.slides.forEach(slide => {
              if(slide.classList.contains('swiper-slide-active')) {
                console.log(slide);
                const video = slide.querySelector('video');
                const sound = slide.querySelector(`.video-modal-sound-${sectionId}`);
                document.body.style.overflow = 'hidden';
                modal.classList.add('active');
                if (video) {
                  video.play();
                } 
              }
            });
          }, 200);  
        })
      }); 
    }

    if(modalCloses) {
      modalCloses.forEach(modalClose => {
        modalClose.addEventListener('click', () => {
          document.body.style.overflow = '';
          modal.classList.remove('active');
          let videos = modal.querySelectorAll('video');
          if(videos){
            videos.forEach(el => {
              el.pause();
            });
          }
        });
      })
    }

    document.addEventListener('click', (e) => {
        if (e.target == modal) {
          document.body.style.overflow = '';
          modal.classList.remove('active');
          let videos = modal.querySelectorAll('video');
          if(videos){
            videos.forEach(el => {
              el.pause();
            });
          }
        }
    });

    if(modalSlides) {
      modalSlides.forEach(el => {
        let content = el.querySelector(`.video-modal-content-top-${sectionId}`);
        let video = el.querySelector('video');
        let progress = el.querySelector('progress');
        let sound = el.querySelector(`.video-modal-sound-${sectionId}`);
        let toggle = el.querySelector(`.video-modal-toggle-${sectionId}`);
        let product = el.querySelector(`.video-modal-product-${sectionId}`);

        if(video) {

          video.addEventListener('ended', () => {
            video.pause();
            video.currentTime = 0;
      
            modalSlider.slideNext();
          });
          
          if(progress) {
              setInterval(function () {
                  if (video.duration && isFinite(video.duration)) {
                      progress.value = Math.round((video.currentTime / video.duration) * 100); 
                  }
              }); 
          }
        }

        content.addEventListener("click", (e) => {
          if(e.target == content) {
            if(el.classList.contains('active')) {
              if(video) {
                video.play(); 
              }
            } else {
              if(video) {
                video.pause(); 
              }
            }
            el.classList.toggle('active');
          }
        });

        if(sound) {
          sound.addEventListener('click', () => {
            if(sound.classList.contains('active')) {
              if(video) {
                video.muted = true;
              }
            } else {
              if(video) {
                video.muted = false;
              }
            }
            sound.classList.toggle('active');
          }) 
        }

        if(toggle) {
          toggle.addEventListener('click', () => {
            product.classList.toggle('active');
            toggle.classList.toggle('active');
          }) 
        }
      })
    }
  }

  function initializeAllShoppableVideo3Sections() {
    const sections = document.querySelectorAll('[id^="shopify-section-"]');
    sections.forEach(section => {
      if (section.querySelector('.video-template--22154773430601__ss_shoppable_video_3_m4HyUc')) {
        const sectionId = section.id.replace('shopify-section-', '');
        loadSwiper(() => initShoppableVideo3(sectionId));
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllShoppableVideo3Sections);
  } else {
    initializeAllShoppableVideo3Sections();
  }

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', (event) => {
      const sectionId = event.detail.sectionId;
      if (event.target.querySelector('.video-template--22154773430601__ss_shoppable_video_3_m4HyUc')) {
        loadSwiper(() => initShoppableVideo3(sectionId));
      }
    });
  }

(function() {
  var sectionId = 'template--22154773430601__ss_shoppable_video_3_m4HyUc';
  var cartApp = 'auto-detect';

  function initShvATC() {
    document.querySelectorAll('.shv-atc-btn-' + sectionId).forEach(function(btn) {
      if (btn.dataset.atcInit) return;
      btn.dataset.atcInit = 'true';

      var sel = btn.closest('[data-shv-product]') ? btn.closest('[data-shv-product]').querySelector('.shv-variant-select-' + sectionId) : null;
      if (sel) {
        sel.addEventListener('change', function() {
          btn.setAttribute('data-variant-id', sel.value);
          var opt = sel.options[sel.selectedIndex];
          btn.disabled = opt ? opt.disabled : false;
          if (opt && !opt.disabled) {
            btn.textContent = btn.getAttribute('data-label') || btn.textContent;
          } else if (opt && opt.disabled) {
            btn.textContent = btn.getAttribute('data-sold-out-label') || btn.textContent;
          }
        });
      }

      btn.addEventListener('click', function() {
        var variantId = btn.getAttribute('data-variant-id');
        if (!variantId || btn.disabled) return;

        var origText = btn.getAttribute('data-label') || btn.textContent;
        var addedLabel = btn.getAttribute('data-added-label') || 'вњ“';
        btn.disabled = true;
        btn.textContent = '...';

        var cartEl = document.querySelector('cart-drawer, cart-notification');
        var sections;
        if (cartEl && typeof cartEl.getSectionsToRender === 'function') {
          sections = cartEl.getSectionsToRender().map(function(s) { return s.id; });
        } else {
          sections = ['cart-notification', 'cart-drawer', 'cart-icon-bubble'];
        }
        document.querySelectorAll('cart-items-component').forEach(function(item) {
          if (item instanceof HTMLElement && item.dataset.sectionId) sections.push(item.dataset.sectionId);
        });

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }], sections: sections })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.status) {
            btn.disabled = false;
            btn.textContent = origText;
            return;
          }
          btn.textContent = addedLabel;
          var theme = ((window.Shopify && window.Shopify.theme && window.Shopify.theme.schema_name) ? window.Shopify.theme.schema_name : '').toLowerCase();
          var isApp = function(n) { return cartApp === n || cartApp === 'auto-detect'; };

          if (isApp('upcart') && window.upcartOpenCart) { window.upcartOpenCart(); if (window.upcartRefreshCart) window.upcartRefreshCart(); return; }
          if (isApp('amp-cart') && window.SLIDECART_OPEN) { if (window.SLIDECART_UPDATE) window.SLIDECART_UPDATE(); window.SLIDECART_OPEN(); return; }
          if (isApp('kaching-cart') && window.kachingCartApi) { window.kachingCartApi.openCart({ refetchCart: true }); return; }

          var el = document.querySelector('cart-drawer, cart-notification');
          if (el && !['prestige', 'symmetry'].includes(theme)) {
            if (typeof el.renderContents === 'function') {
              (data.items || []).forEach(function(item) { item.sections = data.sections; el.renderContents(item); });
              el.classList.remove('is-empty');
            } else if (data.sections) {
              var p = new DOMParser();
              Object.keys(data.sections).forEach(function(id) {
                var src = p.parseFromString(data.sections[id], 'text/html').getElementById(id);
                var dest = document.getElementById(id);
                if (src && dest) dest.innerHTML = src.innerHTML;
              });
            }
            if (typeof el.open === 'function') el.open();
            else if (typeof el.show === 'function') el.show();
            return;
          }
          var modernHorizonDrawer = document.querySelector('theme-drawer#cart-drawer');
          if (modernHorizonDrawer) {
            var shopRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
            var cartUpdatePromise = fetch(shopRoot.replace(/\/?$/, '/') + 'cart.js')
              .then(function(response) {
                if (!response.ok) throw new Error('Unable to refresh the cart.');
                return response.json();
              })
              .then(function(cart) {
                return {
                  cart: { totalQuantity: cart.item_count },
                  detail: {
                    didError: false,
                    itemCount: 1,
                    items: cart.items,
                    productId: String(data.items && data.items[0] ? data.items[0].product_id : 0),
                    sections: data.sections,
                    source: 'ss-shoppable-video'
                  }
                };
              });
            var horizonUpdateEvent = new Event('shopify:cart:lines-update', { bubbles: true });
            horizonUpdateEvent.action = 'add';
            horizonUpdateEvent.context = 'product';
            horizonUpdateEvent.lines = [{ merchandiseId: String(variantId), quantity: 1 }];
            horizonUpdateEvent.promise = cartUpdatePromise;
            modernHorizonDrawer.dispatchEvent(horizonUpdateEvent);
            cartUpdatePromise.then(function() {
              if (modernHorizonDrawer.hasAttribute('open')) return;
              if (window.Shopify && window.Shopify.actions && typeof window.Shopify.actions.openCart === 'function') {
                return window.Shopify.actions.openCart().catch(function() {
                  if (typeof modernHorizonDrawer.open === 'function') modernHorizonDrawer.open();
                  else window.location.href = '/cart';
                });
              }
              if (typeof modernHorizonDrawer.open === 'function') {
                modernHorizonDrawer.open();
              } else {
                window.location.href = '/cart';
              }
            }).catch(function() {
              window.location.href = '/cart';
            });
            return;
          }
          if (document.querySelector('cart-drawer-component')) {
            var ev = new Event('cart:update', { bubbles: true });
            ev.detail = { data: { itemCount: 1, source: 'product-form-component' } };
            document.dispatchEvent(ev);
            setTimeout(function() { var c = document.querySelector('cart-drawer-component'); if (c) c.open(); }, 100);
            return;
          }
          if (theme === 'impulse' && window.theme && window.theme.settings && window.theme.settings.cartType !== 'page') {
            document.dispatchEvent(new CustomEvent('ajaxProduct:added')); return;
          }
          if (theme === 'prestige' && window.themeVariables && window.themeVariables.settings && window.themeVariables.settings.cartType !== 'page') {
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            var pd = document.querySelector('cart-drawer');
            if (pd) pd.show(); else document.dispatchEvent(new CustomEvent('product:added', { detail: {} }));
            return;
          }
          if (theme === 'symmetry') {
            var after = window.theme && window.theme.settings ? (window.theme.settings.afterAddToCart || window.theme.settings.after_add_to_cart) : null;
            if (after === 'drawer') {
              document.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false, detail: { openDrawer: true } }));
              document.dispatchEvent(new CustomEvent('on:cart:change'));
              document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh'));
              document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open'));
              return;
            } else if (after === 'notification') {
              document.documentElement.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false }));
              return;
            }
          }
          window.location.href = (window.theme && window.theme.routes && window.theme.routes.cartPage) ? window.theme.routes.cartPage : '/cart';
        })
        .catch(function() { btn.disabled = false; btn.textContent = origText; })
        .finally(function() { setTimeout(function() { btn.disabled = false; btn.textContent = origText; }, 2500); });
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initShvATC);
  else initShvATC();
  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', initShvATC);
  }
})();

</script>
