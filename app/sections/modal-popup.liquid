<script>
  function initModalPopup() {

    const toggle = document.querySelector('.modal-button-template--20852120125769__ss_modal_popup_gkWik6');
    const modal = document.querySelector('.modal-popup-template--20852120125769__ss_modal_popup_gkWik6');
    const close = document.querySelector('.modal-popup-close-template--20852120125769__ss_modal_popup_gkWik6');
    const modalKey = 'modalDisplayedAt_template--20852120125769__ss_modal_popup_gkWik6';

    if(toggle) {
      toggle.addEventListener('click', () => {
        if(modal) {
          
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
            document.body.style.transform = 'none';
          
        }
      })
    }

    if(close) {
       close.addEventListener('click', () => {
        document.body.style.overflow = '';
        document.body.style.transform = '';
        modal.classList.remove('active');
      });
    }

    document.addEventListener('click', (e) => {
        if (e.target == modal) {
          document.body.style.overflow = '';
          document.body.style.transform = '';
          modal.classList.remove('active');
        }
    });

    

    

    

    

  }

  document.addEventListener('DOMContentLoaded', initModalPopup);

  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initModalPopup);
     document.addEventListener('shopify:section:load', initModalPopup);
  }
</script>
