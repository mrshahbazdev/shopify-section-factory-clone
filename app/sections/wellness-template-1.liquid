              (function () {
                var els = document.querySelectorAll('.lst-stats-stats_D3tdQ4 [data-countup]');
                if (!els.length) return;
                var ran = false;
                var obs = new IntersectionObserver(
                  function (entries) {
                    if (ran || !entries[0].isIntersecting) return;
                    ran = true;
                    obs.disconnect();
                    els.forEach(function (el) {
                      var raw = el.getAttribute('data-countup');
                      var match = raw.match(/^([^0-9]*)(\d+(?:\.\d+)?)(.*)$/);
                      if (!match) return;
                      var pre = match[1],
                        num = parseFloat(match[2]),
                        suf = match[3];
                      var dur = 1400,
                        start = null;
                      function step(ts) {
                        if (!start) start = ts;
                        var p = Math.min((ts - start) / dur, 1);
                        var ease = 1 - Math.pow(1 - p, 3);
                        var cur = num % 1 === 0 ? Math.round(ease * num) : (ease * num).toFixed(1);
                        el.textContent = pre + cur + suf;
                        if (p < 1) requestAnimationFrame(step);
                      }
                      requestAnimationFrame(step);
                    });
                  },
                  { threshold: 0.4 }
                );
                var card = document.querySelector('.lst-stats-cards-stats_D3tdQ4');
                if (card) obs.observe(card);
              })();
            </script>
