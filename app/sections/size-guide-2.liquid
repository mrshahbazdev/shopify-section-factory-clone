<script>
  function initSizeGuide() {
    setTimeout(() => {

      let toggle = document.querySelector('.size-toggle-template--22090900635977__ss_size_guide_2_tdHCK7');
      const modal = document.querySelector('.size-modal-template--22090900635977__ss_size_guide_2_tdHCK7');
      const close = document.querySelector('.size-modal-close-template--22090900635977__ss_size_guide_2_tdHCK7');
      if(toggle) {
        toggle.addEventListener('click', () => {
          document.body.style.overflow = 'hidden';
          modal.classList.add('active');
        })
      }

      close.addEventListener('click', () => {
          document.body.style.overflow = '';
          modal.classList.remove('active');
      });
      
      document.addEventListener('click', (e) => {
          if (e.target == modal) {
            document.body.style.overflow = '';
            modal.classList.remove('active');
          }
      });

    let toggles = document.querySelector('.size-modal-toggles-template--22090900635977__ss_size_guide_2_tdHCK7');
    let tables = document.querySelector('.size-modal-tables-template--22090900635977__ss_size_guide_2_tdHCK7');
    if(toggles) {
      toggles.addEventListener('click', () => {
        toggles.classList.toggle('active');
        tables.classList.toggle('active');
      })
    }
      
    }, 400)
  }
  
  document.addEventListener('DOMContentLoaded', initSizeGuide);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initSizeGuide);
     document.addEventListener('shopify:section:load', initSizeGuide);
  }
</script>
