<script src="https://cdn.jsdelivr.net/npm/vanilla-lazyload@19.1.3/dist/lazyload.min.js"></script>
<script>
  

  function initHero() {
    const toggle = document.querySelector('.hero-modal-button-template--25172705739081__ss_hero_45_L69E9K');
    const modal = document.querySelector('.hero-modal-popup-template--25172705739081__ss_hero_45_L69E9K');
    const close = document.querySelector('.hero-modal-popup-close-template--25172705739081__ss_hero_45_L69E9K');

    if(toggle) {
      toggle.addEventListener('click', () => {
        if(modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
          document.body.style.transform = 'none';

          const iframe = modal.querySelector('iframe');
          const video = modal.querySelector('video');

          // Обработка iframe (YouTube/Vimeo)
          if(iframe) {
            const dataSrc2 = iframe.getAttribute('data-src2');
            if(dataSrc2) {
              iframe.src = dataSrc2;
            }
          }

          // Обработка uploaded video
          if(video) {
            
              video.play().catch(err => console.log('Autoplay prevented:', err));

              // Синхронизация кнопки play
              const videoPlay = modal.querySelector('.hero-video-play-template--25172705739081__ss_hero_45_L69E9K');
              if(videoPlay) {
                videoPlay.classList.add('active');
              }
            
          }
        }
      });
    }

    if(close) {
      close.addEventListener('click', () => {
        closeModal();
      });
    }

    if(modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    function closeModal() {
      if(!modal) return;

      document.body.style.overflow = '';
      document.body.style.transform = '';
      modal.classList.remove('active');

      const iframe = modal.querySelector('iframe');
      const video = modal.querySelector('video');

      // Остановка iframe
      if(iframe) {
        const originalSrc = iframe.getAttribute('data-src1');
        if(originalSrc) {
          iframe.src = originalSrc;
        }
      }

      // Остановка uploaded video
      if(video) {
        video.pause();
        video.currentTime = 0;

        // Сброс кнопки play
        const videoPlay = modal.querySelector('.hero-video-play-template--25172705739081__ss_hero_45_L69E9K');
        if(videoPlay) {
          videoPlay.classList.remove('active');
        }
      }
    }

    
      const imageWrapper = document.querySelector('.hero-image-wrapper-template--25172705739081__ss_hero_45_L69E9K');
      if (!imageWrapper) return;

      const allImages = imageWrapper.querySelectorAll('.hero-image-item-template--25172705739081__ss_hero_45_L69E9K');

      if (allImages.length < 2) return;

      let currentIndex = 0;
      let switchInterval;

      function getVisibleImages() {
        return Array.from(allImages).filter(img => {
          const style = window.getComputedStyle(img);
          return style.display !== 'none';
        });
      }

      function switchImages() {
        const visibleImages = getVisibleImages();
        if (visibleImages.length < 2) return;

        visibleImages[currentIndex].classList.remove('active');
        currentIndex = (currentIndex + 1) % visibleImages.length;
        visibleImages[currentIndex].classList.add('active');
      }

      function startInterval() {
        if (switchInterval) clearInterval(switchInterval);
        switchInterval = setInterval(switchImages, 3000);
      }

      function resetSlider() {
        const visibleImages = getVisibleImages();

        // Убираем active со всех
        allImages.forEach(img => img.classList.remove('active'));

        // Добавляем active на первую видимую
        if (visibleImages.length > 0) {
          visibleImages[0].classList.add('active');
          currentIndex = 0;
        }

        // Перезапускаем интервал
        startInterval();
      }

      // Запускаем слайдер
      startInterval();

      // Обработка ресайза
      let resizeTimeout;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(resetSlider, 100);
      });
    
  }

  function initVideo() {
    
      const modal = document.querySelector('.hero-modal-popup-template--25172705739081__ss_hero_45_L69E9K');
      if(!modal) return;

      const videoContainer = modal.querySelector('.hero-video-template--25172705739081__ss_hero_45_L69E9K');
      if(!videoContainer) return;

      const video = videoContainer.querySelector('video');
      const videoPlay = videoContainer.querySelector('.hero-video-play-template--25172705739081__ss_hero_45_L69E9K');
      const videoSound = videoContainer.querySelector('.hero-video-sound-template--25172705739081__ss_hero_45_L69E9K');

      // Play/Pause контрол
      if(video && videoPlay) {
        videoPlay.addEventListener('click', function() {
          if (videoPlay.classList.contains('active')) {
            video.pause();
            videoPlay.classList.remove('active');
          } else {
            video.play().catch(err => console.log('Play prevented:', err));
            videoPlay.classList.add('active');
          }
        });

        // Синхронизация кнопки при окончании видео
        video.addEventListener('ended', function() {
          videoPlay.classList.remove('active');
        });

        // Синхронизация кнопки при паузе/воспроизведении
        video.addEventListener('play', function() {
          videoPlay.classList.add('active');
        });

        video.addEventListener('pause', function() {
          videoPlay.classList.remove('active');
        });
      }

      // Sound контрол
      if(video && videoSound) {
        videoSound.addEventListener('click', () => {
          if(video.muted) {
            video.muted = false;
            videoSound.classList.add('active');
          } else {
            video.muted = true;
            videoSound.classList.remove('active');
          }
        });
      }
    
  }

  function initSlider() {
    const cards = document.querySelectorAll('.hero-testimonial-card-template--25172705739081__ss_hero_45_L69E9K');
    if (cards.length === 0) return;

    let index = 0;

    function showNextCard() {
      cards[index].classList.remove('active');
      index = (index + 1) % cards.length;
      cards[index].classList.add('active');
    }

    setInterval(showNextCard, 5000);
  }

  document.addEventListener('DOMContentLoaded', initHero);
  document.addEventListener('DOMContentLoaded', initVideo);
  document.addEventListener('DOMContentLoaded', initSlider);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initHero);
    document.addEventListener('shopify:section:load', initHero);
    document.addEventListener('shopify:section:unload', initVideo);
    document.addEventListener('shopify:section:load', initVideo);
    document.addEventListener('shopify:section:unload', initSlider);
    document.addEventListener('shopify:section:load', initSlider);
  }
</script>
