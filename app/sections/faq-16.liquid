<script>
  function initFaq16() {
    
      let lazyLoadInstance = new LazyLoad();
      window.addEventListener(
        "LazyLoad::Initialized",
        function (event) {
          window.lazyLoadInstance = event.detail.instance;
        },
        false
      );
    

    const faqTabsOpen = false;

    const items = document.querySelectorAll('.faq-item-template--23679278481737__ss_faq_16_LMPbWA');

    const answerPaddingTop = 16;
    const answerPaddingBottom = 0;

    const buttons = document.querySelectorAll('.faq-item-toggle-template--23679278481737__ss_faq_16_LMPbWA');
    const answers = document.querySelectorAll('.faq-answer-template--23679278481737__ss_faq_16_LMPbWA');
    const answersHeightCalElements = document.querySelectorAll('.faq-height-cal-template--23679278481737__ss_faq_16_LMPbWA');
    const faqIcons = document.querySelectorAll('.faq-icon-template--23679278481737__ss_faq_16_LMPbWA');

    let activeIndex = -1;

    function openAnswer(index) {
        const height = answersHeightCalElements[index].offsetHeight;

        answers[index].style.display = 'block';
        setTimeout(() => {
            answers[index].style.paddingTop = `${answerPaddingTop}px`;
            answers[index].style.paddingBottom = `${answerPaddingBottom}px`;
            answers[index].style.height = `${height}px`;
        });

        items[index].classList.add('active');
        faqIcons[index].classList.add('active');
    }

    function closeAnswer(index) {
        answers[index].style.paddingTop = 0;
        answers[index].style.paddingBottom = 0;
        answers[index].style.height = 0;

        setTimeout(() => {
            answers[index].style.display = 'none';
        }, 300);

        items[index].classList.remove('active');
        faqIcons[index].classList.remove('active');
    }

    function toggleAnswer(index) {
      const isOpen = answers[index].style.display !== 'none';

      if (isOpen) {
        closeAnswer(index);
        if (!faqTabsOpen) {
          activeIndex = -1;
        }
      } else {
        openAnswer(index);
        if (!faqTabsOpen) {
          closeAllAnswerBut(index);
          activeIndex = index;
        }
      }
    }

    function closeAllAnswerBut(index) {
        answers.forEach((answer, i) => {
            if (i !== index) {
                closeAnswer(i);
            }
        });
    }

    buttons.forEach((button, index) => {
        button.addEventListener('click', () => {
            toggleAnswer(index);
        });
    });

    openAnswer(0);
    activeIndex = 0;

    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            if (activeIndex !== -1) {
                const height = answersHeightCalElements[activeIndex].offsetHeight;
                answers[activeIndex].style.height = `${height}px`;
            }
        }, 250);
    });
  }

  document.addEventListener('DOMContentLoaded', initFaq16);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initFaq16);
    document.addEventListener('shopify:section:load', initFaq16);
  }
</script>
