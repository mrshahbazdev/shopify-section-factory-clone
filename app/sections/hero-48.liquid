<script>
  function initHero48() {
    

    const heroBlock = document.querySelector('.hero-block-template--26221960593737__ss_hero_48_gzh9hb');
    const heroContent = document.querySelector('.hero-content-template--26221960593737__ss_hero_48_gzh9hb');
    const heroContentWrap = document.querySelector('.hero-content-wrap-template--26221960593737__ss_hero_48_gzh9hb');

    if (!heroBlock || !heroContent || !heroContentWrap) return;

    function updateContentVisibility() {
      const scrolledIn = -heroBlock.getBoundingClientRect().top;
      const totalScroll = heroBlock.offsetHeight - window.innerHeight;

      if (totalScroll <= 0) return;

      const progress = Math.max(0, Math.min(1, scrolledIn / totalScroll));

      // Fade out в последние 40% скролла
      const fadeStart = 0.6;
      let opacity = 1;
      if (progress >= fadeStart) {
        const p = (progress - fadeStart) / (1 - fadeStart);
        opacity = 1 - p;
      }
      const translateY = progress * (window.innerHeight * 0.4);

      heroContent.style.opacity = opacity;
      heroContent.style.transform = `translateY(${translateY}px)`;
      heroContentWrap.style.pointerEvents = opacity < 0.05 ? 'none' : 'auto';
    }

    window.addEventListener('scroll', updateContentVisibility, { passive: true });
    updateContentVisibility();
  }

  document.addEventListener('DOMContentLoaded', initHero48);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initHero48);
    document.addEventListener('shopify:section:load', initHero48);
  }
</script>
