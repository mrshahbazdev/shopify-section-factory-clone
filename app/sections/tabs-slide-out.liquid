<script>
  function initTabs() {
    const tabs = document.querySelectorAll('.tabs-tab-template--22429479010633__ss_tabs_Fy6MfG');
    const modal = document.querySelector('.tabs-modal-template--22429479010633__ss_tabs_Fy6MfG');
    const modalInner = document.querySelector('.tabs-modal-inner-template--22429479010633__ss_tabs_Fy6MfG');
    const modalText = document.querySelectorAll('.tabs-modal-content-template--22429479010633__ss_tabs_Fy6MfG');
    const closeModal = document.querySelector('.tabs-close-modal-template--22429479010633__ss_tabs_Fy6MfG');
    const section = document.querySelector('.section-template--22429479010633__ss_tabs_Fy6MfG');


    if (tabs.length > 0 && section) {
      const defaultBgColor = tabs[0].getAttribute('data-color');
      const defaultBgImage = tabs[0].getAttribute('data-image');
      
      if (defaultBgImage) {
          section.style.backgroundImage = defaultBgImage;
      } else if (defaultBgColor) {
          section.style.backgroundColor = defaultBgColor;
      }

      tabs.forEach(tab => {
        tab.addEventListener('mouseenter', () => {
          const bgColor = tab.getAttribute('data-color');
          const bgImage = tab.getAttribute('data-image');

          if (bgImage) {
            section.style.backgroundImage = bgImage;
            section.style.backgroundColor = ''; 
          } else if (bgColor) {
            section.style.backgroundColor = bgColor;
            section.style.backgroundImage = '';
          }
        });

        tab.addEventListener('mouseleave', () => {
          if (defaultBgImage) {
            section.style.backgroundImage = defaultBgImage;
            section.style.backgroundColor = '';
          } else if (defaultBgColor) {
            section.style.backgroundColor = defaultBgColor;
            section.style.backgroundImage = '';
          }
        });
      });
    }

    if(tabs) {
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {              
          if(modalText) {
            document.body.style.overflow = 'hidden';     
            if(modal) {
              modal.classList.add('active');
              setTimeout(() => {
                modalInner.classList.add('active');
              }, 200)
            } else {              
              modalInner.classList.remove('active');             
              setTimeout(() => {
                modal.classList.remove('active');      
              }, 200)        
            }
            modalText.forEach(e => {
              if(tab.id === e.getAttribute('data-id')) {
                e.classList.add('active');
              } else {
                setTimeout(() => {
                  e.classList.remove('active')  
                }, 200)               
              }
            })
          }
        })
      })
    }

    if(closeModal) {
      closeModal.addEventListener("click", () => {
        document.body.style.overflow = '';   
        if(modal) {     
          modalInner.classList.remove('active');             
          setTimeout(() => {
            modal.classList.remove('active');      
          }, 200)            
        }
        modalText.forEach(e => {          
          setTimeout(() => {
            e.classList.remove('active')  
          }, 200)      
        })
      })
    }

    document.addEventListener('click', function(e) {
      if (e.target == modal) {
        document.body.style.overflow = '';   
        modalInner.classList.remove('active');             
        setTimeout(() => {
          modal.classList.remove('active');      
        }, 200)
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initTabs);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initTabs);
    document.addEventListener('shopify:section:load', initTabs);
  }
</script>
