<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
<script>
  function initHotspots12template24891400782153__ss_hotspots_12_kkAHNY() {
    if (typeof Swiper === 'undefined') return;

    new Swiper('.hotspot-slider-template--24891400782153__ss_hotspots_12_kkAHNY', {
      slidesPerView: 1,
      spaceBetween: 16,
      breakpoints: {
        1024: {
          spaceBetween: 60,
          slidesPerView: 1,
        },
      },
      navigation: {
        nextEl: '.hotspot-btn-next-template--24891400782153__ss_hotspots_12_kkAHNY',
        prevEl: '.hotspot-btn-prev-template--24891400782153__ss_hotspots_12_kkAHNY',
      },
    });

    initHotspotstemplate24891400782153__ss_hotspots_12_kkAHNY();
  }

  function initHotspotstemplate24891400782153__ss_hotspots_12_kkAHNY() {
    const hotspots = document.querySelectorAll('.hotspot-item-dot-template--24891400782153__ss_hotspots_12_kkAHNY');
    const sliderWrapper = document.querySelector('.hotspot-slider-wrapper-template--24891400782153__ss_hotspots_12_kkAHNY');
    const popup = document.querySelector('.hotspot-modal-popup-template--24891400782153__ss_hotspots_12_kkAHNY');
    const close = document.querySelector('.hotspot-modal-popup-close-template--24891400782153__ss_hotspots_12_kkAHNY');
    const body = document.querySelector('body');
    
    const swiperElements = document.querySelectorAll('.hotspot-slider-template--24891400782153__ss_hotspots_12_kkAHNY');
    const swiperInstances = Array.from(swiperElements)
    .map(el => el.swiper)
    .filter(swiper => swiper);

    const isCarouselUnfoldedDesktop = true;
    const isDesktop = window.innerWidth >= 1024;

    if (isCarouselUnfoldedDesktop && isDesktop) {
      sliderWrapper.classList.add('active');
      
      const firstHotspot = document.querySelector('.hotspot-item-dot-template--24891400782153__ss_hotspots_12_kkAHNY[data-slide-index="0"]');
      if (firstHotspot) {
        firstHotspot.classList.add('active');
      }

      if (swiperInstances.length > 0) {
        swiperInstances.forEach((slider) => {
          slider.slideTo(0);
        });
      }
    }

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener('click', function() {
        if (window.innerWidth < 1024) {
          popup.classList.add('active');
          body.style.overflow = 'hidden';
          hotspots.forEach(h => h.classList.remove('active'));
          this.classList.add('active-mobile');
        } else {
          hotspots.forEach(h => h.classList.remove('active'));
          this.classList.add('active');
        }

        sliderWrapper.classList.add('active');

        const slideIndex = parseInt(this.getAttribute('data-slide-index'));
        
        if (swiperInstances.length > 0 && !isNaN(slideIndex)) {
          swiperInstances.forEach((slider) => {
            slider.slideTo(slideIndex);
          });
        }
      });
    });

    if (swiperInstances.length > 0) {
      swiperInstances.forEach((slider) => {
        slider.on('slideChange', function() {
          const activeIndex = slider.activeIndex;
          
          hotspots.forEach(h => h.classList.remove('active'));
          
          const activeHotspot = document.querySelector(
            `.hotspot-item-dot-template--24891400782153__ss_hotspots_12_kkAHNY[data-slide-index="${activeIndex}"]`
          );
          if (activeHotspot) {
            activeHotspot.classList.add('active');
          }
        });
      })
    }

    popup.addEventListener('click', (e) => {
      if (e.target === popup) {
        popup.classList.remove('active');
        body.style.overflow = 'auto';
        hotspots.forEach(h => h.classList.remove('active-mobile'));
      }
    });

    close.addEventListener('click', () => {
      popup.classList.remove('active');
      body.style.overflow = 'auto';
      hotspots.forEach(h => h.classList.remove('active-mobile'));
    });
  }


  document.addEventListener('DOMContentLoaded', initHotspots12template24891400782153__ss_hotspots_12_kkAHNY);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initHotspots12template24891400782153__ss_hotspots_12_kkAHNY);
    document.addEventListener('shopify:section:load', initHotspots12template24891400782153__ss_hotspots_12_kkAHNY);
  }
</script>
