<script>
    function initStats() {
      const section = document.querySelector('.section-template--26457305776457__ss_stats_6_WYHFJG');
      if (!section) return;

      const animateCounters = true;

      if (section._statsInterval) {
        clearInterval(section._statsInterval);
      }

      if (section._statsObserver) {
        section._statsObserver.disconnect();
      }

      if (section._statsResizeHandler) {
        window.removeEventListener('resize', section._statsResizeHandler);
      }

      const spans = section.querySelectorAll('.stats-item-percent-template--26457305776457__ss_stats_6_WYHFJG');
      const wraps = section.querySelectorAll('.stats-item-percent-wrap-template--26457305776457__ss_stats_6_WYHFJG');
      const progressBars = section.querySelectorAll('.stats-item-progress-bar-template--26457305776457__ss_stats_6_WYHFJG');

      if (!spans.length) return;

      const clearWidths = () => {
        wraps.forEach(wrap => {
          wrap.style.minWidth = '';
          wrap.style.width = '';
        });
      };

      const targets = Array.from(spans).map((span, i) => ({
        el: span,
        bar: progressBars[i] || null,
        target: parseInt(span.dataset.target, 10) || 0,
        current: 0,
      }));
      const widthBuffer = 10;

      if (!animateCounters) {
        clearWidths();
        targets.forEach(t => {
          if (t.bar) {
            t.bar.style.transition = 'none';
            t.bar.style.width = t.target + '%';
          }
        });
        return;
      }

      const syncWidths = () => {
        clearWidths();

        const originalValues = Array.from(spans).map(span => span.textContent);

        targets.forEach(t => {
          t.el.textContent = t.target;
        });

        if (animateCounters) {
          wraps.forEach(wrap => {
            wrap.style.minWidth = Math.ceil(wrap.getBoundingClientRect().width) + widthBuffer + 'px';
          });
        }

        originalValues.forEach((value, index) => {
          spans[index].textContent = value;
        });
      };

      if (animateCounters) {
        spans.forEach(span => {
          span.textContent = '0';
        });

        targets.forEach(t => {
          if (t.bar) {
            t.bar.style.transition = 'none';
            t.bar.style.width = '0%';
          }
        });
      }

      syncWidths();

      section._statsResizeHandler = () => {
        syncWidths();
      };
      window.addEventListener('resize', section._statsResizeHandler);

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          if (!document.body.contains(section)) return;
          syncWidths();
        });
      }

      if (!animateCounters) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;

          observer.disconnect();

          targets.forEach(t => {
            t.current = 0;
            t.el.textContent = '0';

            if (t.bar) {
              t.bar.style.transition = 'none';
              t.bar.style.width = '0%';
            }
          });

          syncWidths();

          const maxValue = Math.max(...targets.map(t => t.target));
          const isMobile = window.innerWidth < 1024;
          const DURATION = (isMobile ? 2 : 2) * 1000;
          const tickInterval = maxValue > 0 ? Math.floor(DURATION / maxValue) : DURATION;

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              targets.forEach(t => {
                if (t.bar) {
                  t.bar.style.transition = `width ${DURATION}ms linear`;
                  t.bar.style.width = t.target + '%';
                }
              });
            });
          });

          const interval = setInterval(() => {
            let allDone = true;

            targets.forEach(t => {
              if (t.current < t.target) {
                t.current++;
                t.el.textContent = t.current;
                allDone = false;
              }
            });

            if (allDone) {
              clearInterval(interval);
            }
          }, tickInterval);

          section._statsInterval = interval;
        });
      }, { threshold: 0.3 });

      observer.observe(section);
      section._statsObserver = observer;
    }

    document.addEventListener('DOMContentLoaded', initStats);

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:unload', () => {
        const section = document.querySelector('.section-template--26457305776457__ss_stats_6_WYHFJG');
        if (!section) return;
        if (section._statsInterval) clearInterval(section._statsInterval);
        if (section._statsObserver) section._statsObserver.disconnect();
        if (section._statsResizeHandler) {
          window.removeEventListener('resize', section._statsResizeHandler);
        }
      });
      document.addEventListener('shopify:section:load', initStats);
    }
  </script>
