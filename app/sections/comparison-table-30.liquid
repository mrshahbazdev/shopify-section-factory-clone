<script>
  (function () {
    var icons = Array.from(document.querySelectorAll('.comparison-check-template--26139171062089__ss_comparison_table_30_eFpPnc'));
    if (!icons.length) return;

    var lastPassedCount = 0;

    function animateIcon(icon) {
      if (icon._animating) return;
      icon._animating = true;
      icon.style.transition = 'transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
      icon.style.transform = 'translateY(-6px)';
      setTimeout(function () {
        icon.style.transform = 'translateY(0)';
        setTimeout(function () {
          icon._animating = false;
        }, 400);
      }, 200);
    }

    function checkIcons() {
      var triggerPoint = window.innerHeight * 0.6;

      // Считаем сколько иконок центр которых выше триггера
      var passedCount = 0;
      icons.forEach(function (icon) {
        var rect = icon.getBoundingClientRect();
        var center = rect.top + rect.height / 2;
        if (center < triggerPoint) {
          passedCount++;
        }
      });

      if (passedCount > lastPassedCount) {
        // Скролл вниз — анимируем иконку которая только что пересекла
        animateIcon(icons[passedCount - 1]);
      } else if (passedCount < lastPassedCount) {
        // Скролл вверх — анимируем иконку которая вернулась обратно
        animateIcon(icons[lastPassedCount - 1]);
      }

      lastPassedCount = passedCount;
    }

    window.addEventListener('scroll', checkIcons, { passive: true });
    checkIcons();
  })();
</script>
