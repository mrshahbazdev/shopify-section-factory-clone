        }

        const spans = section.querySelectorAll('.hero-stats-percent-template--26558381621577__ss_hero_pro_2_eUTBfp');
        const wraps = section.querySelectorAll('.hero-stats-percent-wrap-template--26558381621577__ss_hero_pro_2_eUTBfp');
        if (!spans.length) return;

        const clearWidths = () => {
          wraps.forEach(wrap => {
            wrap.style.minWidth = '';
            wrap.style.width = '';
          });
        };

        const targets = Array.from(spans).map(span => ({
          el: span,
          target: parseInt(span.dataset.target, 10) || 0,
          current: 0,
