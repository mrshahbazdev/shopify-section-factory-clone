          const originalValues = Array.from(spans).map(span => span.textContent);

          targets.forEach(t => {
            t.el.textContent = t.target;
          });

          if (animateCounters) {
            wraps.forEach(wrap => {
              wrap.style.minWidth = Math.ceil(wrap.getBoundingClientRect().width) + widthBuffer + 'px';
            });
