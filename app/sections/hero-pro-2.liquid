    (function() {
      const initStats = () => {
        const section = document.querySelector('.section-template--26558381621577__ss_hero_pro_2_eUTBfp');
        if (!section) return;

        const animateCounters = true;

        if (section._statsInterval) {
          clearInterval(section._statsInterval);
        }

        if (section._statsObserver) {
          section._statsObserver.disconnect();
        }

        if (section._statsResizeHandler) {
