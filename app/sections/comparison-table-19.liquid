<script>
  function initComparisonTable19() {
    const rows = document.querySelectorAll('.comparison-grid-rows-template--23254557360457__ss_comparison_table_19_FrrDNF');
    
    rows.forEach(row => {
      const items = row.querySelectorAll('.comparison-item-template--23254557360457__ss_comparison_table_19_FrrDNF');
      
      items.forEach((item, index) => {
        if (index === 0) return;
  
        item.addEventListener('mouseenter', () => {
          const isActiveRow = row.classList.contains('active');
          
          rows.forEach(otherRow => {
            const sameColumnItem = otherRow.querySelectorAll('.comparison-item-template--23254557360457__ss_comparison_table_19_FrrDNF')[index];
            if (sameColumnItem) {
              if (otherRow === row) {
                sameColumnItem.style.backgroundColor = isActiveRow ? 
                  '#c1eb48' : 
                  '#d3ff56';
              } else if (otherRow.classList.contains('active')) {
                sameColumnItem.style.backgroundColor = '#c1eb48';
              } else {
                sameColumnItem.style.backgroundColor = '#efe5ff';
              }
            }
          });
        });
  
        item.addEventListener('mouseleave', () => {
          rows.forEach(otherRow => {
            const sameColumnItem = otherRow.querySelectorAll('.comparison-item-template--23254557360457__ss_comparison_table_19_FrrDNF')[index];
            if (sameColumnItem) {
              sameColumnItem.style.backgroundColor = '';
            }
          });
        });
      });
    });

    const updateVisibleItems = () => {
      const grids = document.querySelectorAll('.comparison-grid-template--23254557360457__ss_comparison_table_19_FrrDNF');

      grids.forEach(grid => {
        const items = grid.querySelectorAll('.comparison-item-template--23254557360457__ss_comparison_table_19_FrrDNF');
        const visibleItems = Array.from(items).filter(item => {
          return window.getComputedStyle(item).display !== 'none';
        });

        items.forEach(item => {
          item.classList.remove('first-visible-item', 'last-visible-item');
        });

        if (visibleItems.length > 0) {
          const firstVisibleItem = visibleItems[1];
          firstVisibleItem.classList.add('first-visible-item');
          const lastVisibleItem = visibleItems[visibleItems.length - 1];
          lastVisibleItem.classList.add('last-visible-item');
        }
      });
    };

    updateVisibleItems();
    window.addEventListener('resize', updateVisibleItems);
  }

  document.addEventListener('DOMContentLoaded', initComparisonTable19);
</script>
