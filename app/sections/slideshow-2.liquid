<section id="section-{{ section.id }}" class="section-store-slideshow-2 section-style-3">
<style>
.section-store-slideshow-2 {
  --bg: #fff7ed;
  --fg: #431407;
  --accent: #f59e0b;
  --radius: 8px;
  --align: center;
  --shadow: 0 6px 24px rgba(0,0,0,0.08);
  --sectionPadding: 88px 20px;
  background: var(--bg);
  color: var(--fg);
}
.section-store-slideshow-2 .ss-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--sectionPadding);
  text-align: var(--align);
}
.section-store-slideshow-2 .ss-title {
  font-size: clamp(2.2rem, 5vw, 3.75rem);
  font-weight: 800;
  line-height: 1.05;
  margin: 0 0 18px;
  letter-spacing: -0.02em;
}
.section-store-slideshow-2 .ss-subtitle {
  font-size: 1.15rem;
  line-height: 1.7;
  opacity: 0.85;
  max-width: 680px;
  margin: 0 auto 28px;
}
.section-store-slideshow-2 .ss-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 32px;
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius);
  text-decoration: none;
  font-weight: 600;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.section-store-slideshow-2 .ss-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,0.18);
}
.section-store-slideshow-2 img { max-width: 100%; height: auto; border-radius: var(--radius); }
.section-store-slideshow-2 .placeholder-image {
  border-radius: var(--radius);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
}
</style>
<div class="ss-wrap">
  <h2 class="ss-title">{{ section.settings.heading }}</h2>
  <div class="ss-subtitle">{{ section.settings.subheading }}</div>
  <div style="display: flex; gap: 16px; overflow-x: auto; margin-top: 32px; scroll-snap-type: x mandatory; padding-bottom: 12px;">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div style="flex: 0 0 80%; scroll-snap-align: start; border-radius: var(--radius); overflow: hidden; background: rgba(0,0,0,0.03); min-height: 260px; display: grid; place-items: center; padding: 24px;">
          <h3 style="margin: 0;">{{ block.settings.slide_title }}</h3>
          <p style="margin-top: 8px;">{{ block.settings.slide_text }}</p>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <div style="flex: 0 0 80%; scroll-snap-align: start; border-radius: var(--radius); overflow: hidden; background: rgba(0,0,0,0.03); min-height: 260px; display: grid; place-items: center; padding: 24px;">
          <h3 style="margin: 0;">Slide {{ i }}</h3>
          <p style="margin-top: 8px;">Add your slide content.</p>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Slideshow #2",
  "tag": "section",
  "class": "section-store-slideshow-2",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Add your subheading here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Slideshow #2"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "slide_title",
          "label": "Title",
          "default": "Slide title"
        },
        {
          "type": "richtext",
          "id": "slide_text",
          "label": "Text",
          "default": "<p>Slide content.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ]
}
{% endschema %}
</section>
