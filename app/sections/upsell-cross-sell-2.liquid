                if (nextImageSrc) {
                  productImage.src = shopifyImageUrl(nextImageSrc, 400);
                  productImage.srcset = responsiveImageWidths.map(function (width) {
                    return shopifyImageUrl(nextImageSrc, width) + ' ' + width + 'w';
                  }).join(', ');
                  productImage.sizes = responsiveImageSizes;
                }
                productImage.alt = matchedVariant.featured_image && matchedVariant.featured_image.alt
