<script>
    var formayMoneyForBuyItWith = function(cents, format) {
      if (typeof cents == 'string') { cents = cents.replace('.',''); }
      var value = '';
      var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      var formatString = (format || this.money_format);
    
      function defaultOption(opt, def) {
         return (typeof opt == 'undefined' ? def : opt);
      }
    
      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = defaultOption(precision, 2);
        thousands = defaultOption(thousands, ',');
        decimal   = defaultOption(decimal, '.');
    
        if (isNaN(number) || number == null) { return 0; }
    
        number = (number/100.0).toFixed(precision);
    
        var parts   = number.split('.'),
            dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands),
            cents   = parts[1] ? (decimal + parts[1]) : '';
    
        return dollars + cents;
      }
    
      switch(formatString.match(placeholderRegex)[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = formatWithDelimiters(cents, 0, '.', ',');
          break;
      }
    
      return formatString.replace(placeholderRegex, value);
    };

    document.addEventListener('DOMContentLoaded', function () {
      setTimeout(() => {
        const upsellRoot = document.querySelector('#ss-upsell-root-template--16866905719033__185ca9b8-7997-42e3-a8f3-5db56ac08e3a');
        if (!upsellRoot) return;

        const buttonText = "ADD";
        const soldOutText = "Sold out";
        const addingText = "Adding...";
        const addedText = "Added";
        const errorText = "Error";
        const fallbackErrorText = "Unable to add this item to the cart.";
        const moneyFormat = "${{amount}} USD";
        const responsiveImageWidths = [50, 72, 100, 150, 200, 300, 400];
        const responsiveImageSizes = "(min-width: 1024px) 72px, 72px";
        const shopifyImageUrl = function (src, width) {
          const url = new URL(src, window.location.origin);
          url.searchParams.set('width', width);
          return url.toString();
        };

        const addToCartButtons = upsellRoot.querySelectorAll('[data-mini-add-to-cart]');
        addToCartButtons.forEach(function (button) {
          button.addEventListener('click', async function () {
            const variantId = button.getAttribute('data-variant-id');
            if (!variantId || button.disabled) return;

            const originalHtml = button.innerHTML;
            const errorElement = button.closest('[data-mini-atc]')?.querySelector('[data-mini-atc-error]');
            const showCartError = function (message) {
              if (!errorElement) return;
              errorElement.textContent = message || fallbackErrorText;
              errorElement.hidden = false;
              setTimeout(function () {
                errorElement.hidden = true;
              }, 4000);
            };
            button.disabled = true;
            button.textContent = addingText;

            try {
              

              var cartEl = document.querySelector('cart-drawer, cart-notification');
              var sections;
              if (cartEl && typeof cartEl.getSectionsToRender === 'function') {
                sections = cartEl.getSectionsToRender().map(function(s) { return s.id; });
              } else {
                sections = ['cart-notification', 'cart-drawer', 'cart-icon-bubble'];
              }
              document.querySelectorAll('cart-items-component').forEach(function(item) {
                if (item instanceof HTMLElement && item.dataset.sectionId) sections.push(item.dataset.sectionId);
              });

              const atcRes = await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }], sections: sections })
              });
              const data = await atcRes.json();

              if (!atcRes.ok || data.status) {
                button.innerHTML = originalHtml;
                button.disabled = false;
                showCartError(data.description || data.message);
                return;
              }

              button.textContent = addedText;

              var themeSchemaName = ((window.Shopify && window.Shopify.theme && window.Shopify.theme.schema_name) ? window.Shopify.theme.schema_name : '').toLowerCase();
              var cartApp = 'auto-detect';
              var isCartApp = function(name) { return cartApp === name || cartApp === 'auto-detect'; };

              if (isCartApp('upcart') && window.upcartOpenCart) {
                window.upcartOpenCart();
                if (window.upcartRefreshCart) window.upcartRefreshCart();
              } else if (isCartApp('amp-cart') && window.SLIDECART_OPEN) {
                if (window.SLIDECART_UPDATE) window.SLIDECART_UPDATE();
                window.SLIDECART_OPEN();
              } else if (isCartApp('kaching-cart') && window.kachingCartApi) {
                window.kachingCartApi.openCart({ refetchCart: true });
              } else {
                var cartElTheme = document.querySelector('cart-drawer, cart-notification');
                if (cartElTheme && !['prestige', 'symmetry'].includes(themeSchemaName)) {
                  if (typeof cartElTheme.renderContents === 'function') {
                    (data.items || []).forEach(function(item) { item.sections = data.sections; cartElTheme.renderContents(item); });
                    cartElTheme.classList.remove('is-empty');
                  } else if (data.sections) {
                    var parser = new DOMParser();
                    Object.keys(data.sections).forEach(function(id) {
                      var src = parser.parseFromString(data.sections[id], 'text/html').getElementById(id);
                      var dest = document.getElementById(id);
                      if (src && dest) dest.innerHTML = src.innerHTML;
                    });
                  }
                  if (typeof cartElTheme.open === 'function') cartElTheme.open();
                  else if (typeof cartElTheme.show === 'function') cartElTheme.show();
                } else {
                  var modernHorizonDrawer = document.querySelector('theme-drawer#cart-drawer');
                  if (modernHorizonDrawer) {
                    var shopRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
                    var cartUpdatePromise = fetch(shopRoot.replace(/\/?$/, '/') + 'cart.js')
                      .then(function(response) {
                        if (!response.ok) throw new Error('Unable to refresh the cart.');
                        return response.json();
                      })
                      .then(function(cart) {
                        return {
                          cart: { totalQuantity: cart.item_count },
                          detail: {
                            didError: false,
                            itemCount: 1,
                            items: cart.items,
                            productId: String(data.items && data.items[0] ? data.items[0].product_id : 0),
                            sections: data.sections,
                            source: 'ss-upsell'
                          }
                        };
                      });
                    var horizonUpdateEvent = new Event('shopify:cart:lines-update', { bubbles: true });
                    horizonUpdateEvent.action = 'add';
                    horizonUpdateEvent.context = 'product';
                    horizonUpdateEvent.lines = [{ merchandiseId: String(variantId), quantity: 1 }];
                    horizonUpdateEvent.promise = cartUpdatePromise;
                    modernHorizonDrawer.dispatchEvent(horizonUpdateEvent);
                    cartUpdatePromise.then(function() {
                      if (modernHorizonDrawer.hasAttribute('open')) return;
                      if (window.Shopify && window.Shopify.actions && typeof window.Shopify.actions.openCart === 'function') {
                        return window.Shopify.actions.openCart().catch(function() {
                          if (typeof modernHorizonDrawer.open === 'function') modernHorizonDrawer.open();
                          else window.location.href = '/cart';
                        });
                      }
                      if (typeof modernHorizonDrawer.open === 'function') {
                        modernHorizonDrawer.open();
                      } else {
                        window.location.href = '/cart';
                      }
                    }).catch(function() {
                      window.location.href = '/cart';
                    });
                  } else if (document.querySelector('cart-drawer-component')) {
                    var cartUpdateEvent = new Event('cart:update', { bubbles: true });
                    cartUpdateEvent.detail = { data: { itemCount: 1, productId: parseInt(data.items && data.items[0] ? data.items[0].product_id : 0), source: 'product-form-component' } };
                    document.dispatchEvent(cartUpdateEvent);
                    setTimeout(function() { var c = document.querySelector('cart-drawer-component'); if (c) c.open(); }, 100);
                  } else if (themeSchemaName === 'impulse') {
                    if (window.theme && window.theme.settings && window.theme.settings.cartType !== 'page') {
                      document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
                    }
                  } else if (themeSchemaName === 'prestige') {
                    if (window.themeVariables && window.themeVariables.settings && window.themeVariables.settings.cartType !== 'page') {
                      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                      var prestigeCartDrawer = document.querySelector('cart-drawer');
                      if (prestigeCartDrawer) prestigeCartDrawer.show();
                      else document.dispatchEvent(new CustomEvent('product:added', { detail: {} }));
                    }
                  } else if (themeSchemaName === 'symmetry') {
                    var afterAddToCart = window.theme && window.theme.settings
                      ? (window.theme.settings.afterAddToCart || window.theme.settings.after_add_to_cart)
                      : null;
                    if (afterAddToCart === 'drawer') {
                      document.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false, detail: { openDrawer: true } }));
                      document.dispatchEvent(new CustomEvent('on:cart:change'));
                      document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh'));
                      document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open'));
                    } else if (afterAddToCart === 'notification') {
                      document.documentElement.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false }));
                      (data.items || []).forEach(function(item) {
                        var template = document.getElementById('AddedNotification');
                        if (template) {
                          var notification = template.content.firstElementChild.cloneNode(true);
                          notification.dataset.productTitle = item.product_title;
                          var notificationContainer = document.querySelector('.pageheader--sticky') || document.querySelector('body');
                          notificationContainer.appendChild(notification);
                        }
                      });
                    } else {
                      window.location.href = (window.theme && window.theme.routes && window.theme.routes.cartPage) ? window.theme.routes.cartPage : '/cart';
                    }
                  } else {
                    window.location.href = (window.theme && window.theme.routes && window.theme.routes.cartPage) ? window.theme.routes.cartPage : '/cart';
                  }
                }
              }

              setTimeout(function () {
                button.innerHTML = originalHtml;
                button.disabled = false;
              }, 2500);
            } catch (error) {
              button.textContent = errorText;
              showCartError(fallbackErrorText);
              setTimeout(function () {
                button.innerHTML = originalHtml;
                button.disabled = false;
              }, 1000);
            }
          });
        });

        
          
          let select1 = upsellRoot.querySelector('[data-mini-atc-variant-select--1]');
