  function initializeAllFeaturedCollection12Sections() {
    const sections = document.querySelectorAll('[id^="shopify-section-"]');
    sections.forEach(section => {
      if (section.querySelector('.featured-template--22598299615561__ss_featured_collection_12_pHQwFQ')) {
        const sectionId = section.id.replace('shopify-section-', '');
        loadSwiper(() => initFeaturedCollection12(sectionId));
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllFeaturedCollection12Sections);
  } else {
    initializeAllFeaturedCollection12Sections();
