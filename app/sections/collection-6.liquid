<script>
  function initCollection6() {
    const slider = new Swiper(".collection-slider-template--21312253755721__ss_collection_6_gyChFL", {
      speed: 300,
      spaceBetween: 20,
      loop: true,
      slidesPerView: 'auto',
      centeredSlides: true,
      slideToClickedSlide: true,
      breakpoints: {
        320: {
          spaceBetween: 70,
        },
        768: {
          spaceBetween: 70,
        },
        1024: {
          spaceBetween: 90,
        }
      }
    });

    slider.on('slideChange', function () {
      const activeSlideId = slider.slides[slider.activeIndex].id;
      const collectionItems = document.querySelectorAll('.collection-item-template--21312253755721__ss_collection_6_gyChFL');
    
      collectionItems.forEach(item => {
        item.classList.remove('active');
        if (item.getAttribute('data-id') === String(activeSlideId)) {
          item.classList.add('active');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCollection6);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initCollection6);
     document.addEventListener('shopify:section:load', initCollection6);
  }
</script>
