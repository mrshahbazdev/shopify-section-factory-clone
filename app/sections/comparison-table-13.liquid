<script>
  function initComparisonTable13() {
    let mainRows = document.querySelectorAll('.comparison-main-row-template--22498895298889__ss_comparison_table_13_HKW4tP');
    let products = document.querySelectorAll('.comparison-product-template--22498895298889__ss_comparison_table_13_HKW4tP');
    let headers = document.querySelectorAll('.comparison-column-header-template--22498895298889__ss_comparison_table_13_HKW4tP');

    if(mainRows) {
      mainRows.forEach((el, index) => {
        el.addEventListener('mouseenter', () => {
          el.classList.add('active');
          
          products.forEach((product, productIndex) => {
            if (productIndex !== index) {
              product.classList.add('non-visible');
            }
          });
        });
    
        el.addEventListener('mouseleave', () => {
          el.classList.remove('active');
    
          products.forEach((product) => {
            product.classList.remove('non-visible');
          });
        });
      });
    }

    if(products) {
      products.forEach((el, index) => {

        if(window.innerWidth < 1024) {
          el.addEventListener("click", () => {

            products.forEach(element => {
              element.classList.remove('non-visible-mobile');
            });
  
            products.forEach((element, productIndex) => {
              if(index !== productIndex) {
                element.classList.add('non-visible-mobile');
              }
            });
  
            if(mainRows) {
              mainRows.forEach((row, rowIndex) => {
                if(rowIndex == index) {
                  row.classList.add('active-mobile');
                } else {
                  row.classList.remove('active-mobile');
                }
              }); 
            }
  
            let parametrs = el.getAttribute('data-parametrs');
            if (parametrs.endsWith(',')) {  
              parametrs = parametrs.slice(0, -1);
            }
            const numbers = parametrs.split(',').map(Number);  
            const filteredNumbers = numbers.filter(num => num !== '');

            console.log(filteredNumbers);
            
            if(headers) {
  
              headers.forEach(element => {
                element.classList.remove('active');
              })
              
              filteredNumbers.forEach(number => {
                headers[number].classList.add('active');
              })
            }
            
          }); 
        } else {
          el.addEventListener('mouseenter', () => {
          
            products.forEach((element, productIndex) => {
              if(index !== productIndex) {
                element.classList.add('non-visible');
              }
            })
            
            if(mainRows) {
              mainRows.forEach((row, rowIndex) => {
                if(rowIndex == index) {
                  row.classList.add('active');
                }
              }); 
            }
          });
  
          el.addEventListener('mouseleave', () => {
            
            products.forEach((element, productIndex) => {
              element.classList.remove('non-visible');
            })
            
            if(mainRows) {
              mainRows.forEach((row, rowIndex) => {
                row.classList.remove('active');
              }); 
            }
          });  
        }
        
      });
    }
    
  }

  document.addEventListener('DOMContentLoaded', initComparisonTable13);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initComparisonTable13);
     document.addEventListener('shopify:section:load', initComparisonTable13);
  }
</script>
