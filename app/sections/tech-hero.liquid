<style>
  .tech-hero {
    background: linear-gradient(
      93.9deg,
      var(--tl-color, #4222de) 0%,
      var(--br-color, #a931ee) 101.18%
    );
    display: flex;
    flex-direction: column;
    color: var(--font-color, #fff);
  }
  .tech-hero__button {
    all: unset;
    cursor: pointer;
    border: 1px solid var(--font-color, #fff);
    border-radius: 21px;
    color: var(--font-color, #fff);
    display: inline-block;
    font-size: 25px;
    padding: 1rem 3rem;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
    margin: 40px auto 0;
    display: inline-block;
    width: fit-content;
  }
  .tech-hero__image--desktop {
    display: none;
  }
  @media screen and (min-width: 750px) {
    .tech-hero__button {
      margin: 28px 0 0;
    }
    .tech-hero {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .tech-hero__image--mobile {
      display: none;
    }
    .tech-hero__image--desktop {
      display: block;
    }
  }
  .tech-hero__left-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }
  .tech-hero__image {
    margin-top: 20px;
  }
  .tech-hero__title p {
    font-size: var(--title-font-size-mobile, 25px);
    line-height: 1.25;
    margin: 0;
  }
  @media screen and (min-width: 750px) {
    .tech-hero__left-content {
      padding: 100px;
      padding-right: 30px;
    }
    .tech-hero__image {
      width: 40%;
      margin-right: 40px;
    }
    .tech-hero__title p {
      font-size: var(--title-font-size, 40px);
    }
  }
</style>
<div class="tech-hero" style="
    --tl-color: #4222de;
    --br-color: #a931ee;
