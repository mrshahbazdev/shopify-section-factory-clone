<script>
  function initShopTheLook4() {
    const body = document.querySelector('.shop-look-body-template--22506330358089__ss_shop_the_look_4_xm8igy');
    const leftButtons = document.querySelectorAll('.shop-look-left-toggle-template--22506330358089__ss_shop_the_look_4_xm8igy')
    const rightButtons = document.querySelectorAll('.shop-look-right-toggle-template--22506330358089__ss_shop_the_look_4_xm8igy')
    const toggles = document.querySelectorAll('.shop-look-toggle-template--22506330358089__ss_shop_the_look_4_xm8igy')

    if(toggles) {
      toggles.forEach(toggle => {
        toggle.addEventListener('click', () => {
          body.classList.toggle('active');
        })
      })     
    }

    if(leftButtons) {
      leftButtons.forEach(leftButton => {
        leftButton.addEventListener('click', () => {
          body.classList.remove('active');
        })
      })      
    }

    if(rightButtons) {
      rightButtons.forEach(rightButton => {
        rightButton.addEventListener('click', () => {
          body.classList.add('active');
        })
      })      
    }
  }

  document.addEventListener('DOMContentLoaded', initShopTheLook4);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initShopTheLook4);
    document.addEventListener('shopify:section:load', initShopTheLook4);
  }
</script>
