<script>
  function initVideoGrid6() {
    let lazyLoadInstance = new LazyLoad();

    window.addEventListener(
      "LazyLoad::Initialized",
      function (event) {
        window.lazyLoadInstance = event.detail.instance;
      },
      false
    );

    function handleDesktopBehavior(item) {
      const videoWrapper = item.querySelector('.video-grid-card-video-template--23694161281353__ss_video_grid_6_Dy4QXp');
      const image = item.querySelector('.video-grid-card-image-template--23694161281353__ss_video_grid_6_Dy4QXp');
      const cardVideo = item.querySelector('.video-grid-card-video-template--23694161281353__ss_video_grid_6_Dy4QXp');
      const scrollingText = item.querySelector('.video-scrolling-wrapper-template--23694161281353__ss_video_grid_6_Dy4QXp');
      const video = item.querySelector('.video-grid-card-video-template--23694161281353__ss_video_grid_6_Dy4QXp video');
      const iframe = item.querySelector('.video-grid-card-video-template--23694161281353__ss_video_grid_6_Dy4QXp iframe');

      function onMouseEnter() {
        scrollingText.classList.add('hide-template--23694161281353__ss_video_grid_6_Dy4QXp');
        cardVideo.classList.add('active');
        item.classList.add('active');
        if (image) image.classList.remove('active');

        if (video && video.paused) {
          try {
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(err => console.warn('Play interrupted:', err));
            }
            videoWrapper.classList.add('active');
          } catch (err) {
            console.warn('Video play error:', err);
          }
        }

        if (iframe) {
          iframe.src = iframe.getAttribute('data-src1');
        }
      }

      function onMouseLeave() {
        scrollingText.classList.remove('hide-template--23694161281353__ss_video_grid_6_Dy4QXp');
        cardVideo.classList.remove('active');
        item.classList.remove('active');
        if (image) image.classList.add('active');

        if (video) {
          video.pause();
          video.currentTime = 0;
          videoWrapper.classList.remove('active');
        }

        if (iframe) {
          iframe.src = iframe.getAttribute('data-src2');
        }
      }
      
      if (window.innerWidth > 1024) {
        item.addEventListener('mouseenter', onMouseEnter);
        item.addEventListener('mouseleave', onMouseLeave);
      }
    }

    document.querySelectorAll('.video-grid-card-template--23694161281353__ss_video_grid_6_Dy4QXp').forEach(item => {
      handleDesktopBehavior(item);
    });
  }

  document.addEventListener('DOMContentLoaded', initVideoGrid6);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initVideoGrid6);
    document.addEventListener('shopify:section:load', initVideoGrid6);
  }
</script>
