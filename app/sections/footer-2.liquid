<script>
  function initFooter2() {
    let thanksText = document.querySelector('.footer-newsletter-thanks-text-template--20900714676553__ss_footer_2_EkM33K');
    let submitButton = document.querySelector('.footer-newsletter-submit-template--20900714676553__ss_footer_2_EkM33K');
    
    const url = window.location.href;
    if (url.includes('customer_posted=true')) {
      if(thanksText) { 
        thanksText.classList.add('active');
        setTimeout(() => {
          thanksText.classList.remove('active');
        }, 5000);
      }
      if(submitButton) {
        submitButton.setAttribute('disabled', true);
      }
    }

    
  }

  document.addEventListener('DOMContentLoaded', initFooter2);

  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initFooter2);
     document.addEventListener('shopify:section:load', initFooter2);
  }
</script>
