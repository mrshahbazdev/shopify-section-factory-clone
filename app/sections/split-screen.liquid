<script src="https://cdn.jsdelivr.net/npm/swiper@6.8.4/swiper-bundle.min.js"></script>
<script>
  function init() {
    const sliders = document.querySelectorAll('.split-slider-template--19195714371913__5b1b83c7-47a7-4a45-92c5-14e2e5ae7727');
    if(sliders) {
      sliders.forEach(item => {
        const slider = new Swiper(item, {
          speed: 800,
          spaceBetween: 20,
          
          
            simulateTouch: false,
          
          watchOverflow: false,
          
          autoplay: {
            delay: 5000,
          },
          
          navigation: {
            nextEl: '.split-slide-btn-next-template--19195714371913__5b1b83c7-47a7-4a45-92c5-14e2e5ae7727',
            prevEl: '.split-slide-btn-prev-template--19195714371913__5b1b83c7-47a7-4a45-92c5-14e2e5ae7727',
          },
          pagination: {
            el: '.split-slide-pagination-template--19195714371913__5b1b83c7-47a7-4a45-92c5-14e2e5ae7727',
            type: 'bullets',
            clickable: true,
          },
        });
      })
    }
    const btn = document.querySelector('.split-slide-video-btn-');
    const video = document.querySelector('.split-slide-video- iframe');
    const videoWrapper = document.querySelector('.split-slide-overlay-');
    if (video) {
      btn.addEventListener('click', () => {
        video.src += "?muted=1&autoplay=1";
        video.setAttribute('allow', 'autoplay');
        btn.style.display="none";
      });
      videoWrapper.addEventListener('click', () => {
        video.src += "?muted=1&autoplay=1";
        video.setAttribute('allow', 'autoplay');
        videoWrapper.classList.add('hide');
        btn.classList.add('hide');
      })
    };
  }
  
  document.addEventListener('DOMContentLoaded', init);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', init);
     document.addEventListener('shopify:section:load', init);
  }
</script>
