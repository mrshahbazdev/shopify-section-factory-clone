<script>
          function initSlidertemplate__26457295552841__ss_featured_collection_23_4HhyGW() {
            const gallery = document.querySelector('.section-template--26457295552841__ss_featured_collection_23_4HhyGW .featured-gallery-template--26457295552841__ss_featured_collection_23_4HhyGW');
            const dots = document.querySelectorAll('.section-template--26457295552841__ss_featured_collection_23_4HhyGW .slider-dot-template--26457295552841__ss_featured_collection_23_4HhyGW');
            if (!gallery || !dots.length) return;

            const cards = gallery.querySelectorAll('.featured-card-template--26457295552841__ss_featured_collection_23_4HhyGW');
            let isScrolling;

            gallery.addEventListener('scroll', () => {
              window.clearTimeout(isScrolling);
              isScrolling = setTimeout(() => {
                let activeIndex = 0;
                let minDistance = Infinity;

                cards.forEach((card, index) => {
                  const cardLeft = card.offsetLeft - gallery.offsetLeft;
                  const distance = Math.abs(gallery.scrollLeft - cardLeft);

                  if (distance < minDistance) {
                    minDistance = distance;
                    activeIndex = index;
                  }
                });

                dots.forEach((dot, index) => {
                  dot.classList.toggle('is-active', index === activeIndex);
                });
              }, 50);
            });

            dots.forEach((dot, index) => {
              dot.addEventListener('click', () => {
                if(cards[index]) {
                  const scrollPos = cards[index].offsetLeft - gallery.offsetLeft;
                  gallery.scrollTo({ left: scrollPos, behavior: 'smooth' });
                }
              });
            });
          }

          document.addEventListener('DOMContentLoaded', initSlidertemplate__26457295552841__ss_featured_collection_23_4HhyGW);
          document.addEventListener('shopify:section:load', function(e) {
            if(e.detail.sectionId === 'template--26457295552841__ss_featured_collection_23_4HhyGW') {
