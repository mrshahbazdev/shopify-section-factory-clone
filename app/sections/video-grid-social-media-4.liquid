<script src="https://cdn.jsdelivr.net/npm/swiper@6.8.4/swiper-bundle.min.js"></script>
<script>
(function(){
  // Функция для принудительной загрузки видео
  function forceLoadVideo(element) {
    if (!element) return;
    
    // Для video элементов
    if (element.tagName.toLowerCase() === 'video') {
      // Сохраняем старый src, если он есть
      var src = element.getAttribute('data-src') || element.getAttribute('src');
      if (!src) return;
      
      // Только устанавливаем src, если его еще нет
      if (!element.getAttribute('src')) {
        element.setAttribute('src', src);
        element.classList.remove('lazy');
        
        // Предзагрузка
        try {
          element.load();
        } catch(e) {}
        
        
        element.muted = true;
        
        element.preload = "auto";
      }
    }
    
    // Для iframe элементов (YouTube, Vimeo)
    if (element.tagName.toLowerCase() === 'iframe') {
      var src = element.getAttribute('data-src') || element.getAttribute('src');
      if (!src) return;
      
      // Только устанавливаем src, если его еще нет
      if (!element.getAttribute('src')) {
        element.setAttribute('src', src);
        element.classList.remove('lazy');
      }
    }
  }

  // Предзагрузка всех видео в слайдере, чтобы избежать мигания
  function preloadAllSliderVideos() {
    var allVideos = document.querySelectorAll('.video-grid-slider-template--22563036889417__ss_video_from_social_4_HYyrRY .swiper-slide video, .video-grid-slider-template--22563036889417__ss_video_from_social_4_HYyrRY .swiper-slide iframe');
    for (var i = 0; i < allVideos.length; i++) {
      forceLoadVideo(allVideos[i]);
    }
  }

  // Инициализация слайдера
  function initSlider() {
    var sliderEl = document.querySelector('.video-grid-slider-template--22563036889417__ss_video_from_social_4_HYyrRY');
    if (!sliderEl) return;

    sliderEl.classList.remove('preview');
    
    // Предзагрузка всех видео в слайдере перед инициализацией
    preloadAllSliderVideos();
    
    var swiper = new Swiper('.video-grid-slider-template--22563036889417__ss_video_from_social_4_HYyrRY', {
      speed: 300,
      loop: true,
      slideToClickedSlide: false,
      loopAdditionalSlides: 1,
      slidesPerGroup: 1,
      preloadImages: true,
      
      watchSlidesProgress: true,
      
      navigation: {
        nextEl: '.video-grid-btn-next-template--22563036889417__ss_video_from_social_4_HYyrRY',
        prevEl: '.video-grid-btn-prev-template--22563036889417__ss_video_from_social_4_HYyrRY',
      },
      on: {
        // Предзагрузка видео до начала анимации слайда
        beforeTransition: function() {
          var nextSlide = this.slides[this.activeIndex];
          if (nextSlide) {
            var mediaElements = nextSlide.querySelectorAll('video, iframe');
            for (var i = 0; i < mediaElements.length; i++) {
              forceLoadVideo(mediaElements[i]);
            }
          }
        },
        slideChangeTransitionStart: function() {
          // Предзагрузка видео при начале перехода
          var activeSlide = this.slides[this.activeIndex];
          if (activeSlide) {
            var mediaElements = activeSlide.querySelectorAll('video, iframe');
            for (var i = 0; i < mediaElements.length; i++) {
              forceLoadVideo(mediaElements[i]);
            }
          }
        },
        slideChangeTransitionEnd: function() {
          // И еще раз после завершения перехода
          var activeSlide = this.slides[this.activeIndex];
          if (activeSlide) {
            var mediaElements = activeSlide.querySelectorAll('video, iframe');
            for (var i = 0; i < mediaElements.length; i++) {
              forceLoadVideo(mediaElements[i]);
            }
          }
        }
      },
      breakpoints: {
        320: {
          spaceBetween: parseInt(sliderEl.dataset.gapMobile || 0),
          slidesPerView: parseFloat(sliderEl.dataset.viewMobile || 1),
        },
        768: {
          spaceBetween: parseInt(sliderEl.dataset.gap || 0),
          slidesPerView: parseFloat(sliderEl.dataset.view || 3),
        },
        1024: {
          spaceBetween: parseInt(sliderEl.dataset.gap || 0),
          slidesPerView: parseFloat(sliderEl.dataset.view || 3),
        }
      }
    });
    
    return swiper;
  }

  // Настройка воспроизведения видео
  function setupVideoPlayback() {
    var videoItems = document.querySelectorAll('.video-grid-video-template--22563036889417__ss_video_from_social_4_HYyrRY');
    if (!videoItems || videoItems.length === 0) return;

    for (var i = 0; i < videoItems.length; i++) {
      (function(item) {
        var video = item.querySelector('video');
        var iframe = item.querySelector('iframe');
        var videoButton = item.querySelector('.video-grid-play-template--22563036889417__ss_video_from_social_4_HYyrRY');
        var wrap = item.querySelector('.video-grid-video-wrap-template--22563036889417__ss_video_from_social_4_HYyrRY');
        
        
        if (video) {
          video.addEventListener('click', function(e) {
            e.stopPropagation();
          });
          
          item.addEventListener('click', function(e) {
            forceLoadVideo(video);
            e.stopPropagation();
          });
        }
        
        if (iframe) {
          iframe.addEventListener('click', function(e) {
            e.stopPropagation();
          });
          
          item.addEventListener('click', function(e) {
            forceLoadVideo(iframe);
            e.stopPropagation();
          });
        }
        
        
        
      })(videoItems[i]);
    }
  }

  // Инициализация анимации процентных кругов
  function initPercentCircles() {
    var circles = document.querySelectorAll('.video-grid-circle-template--22563036889417__ss_video_from_social_4_HYyrRY');
    if (!circles || circles.length === 0) return;
    
    var animatedCircles = new Set();
    
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        var circle = entry.target;
        
        if (animatedCircles.has(circle)) {
          return;
        }
        
        var progressColor = circle.getAttribute('data-progress');
        var activeProgressColor = circle.getAttribute('data-active-progress');
        var percent = parseFloat(circle.getAttribute('data-percent')) || 25;
        var lineWidth = parseFloat(circle.getAttribute('data-line')) || 4;
        var size = parseFloat(circle.getAttribute('data-size')) || 100;
        var svgNamespace = "http://www.w3.org/2000/svg";
        
        var existingSvg = circle.querySelector("svg");
        if (existingSvg) {
          existingSvg.remove();
        }
        
        var existingSpan = circle.querySelector("span");
        if (existingSpan) {
          existingSpan.remove();
        }
        
        var svg = document.createElementNS(svgNamespace, "svg");
        svg.setAttribute("width", size);
        svg.setAttribute("height", size);
        svg.setAttribute("viewBox", "0 0 36 36");
        svg.style.backgroundColor = "transparent";
        
        var backgroundCircle = document.createElementNS(svgNamespace, "path");
        backgroundCircle.setAttribute("d", "M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831");
        backgroundCircle.setAttribute("fill", "none");
        backgroundCircle.setAttribute("stroke", progressColor);
        backgroundCircle.setAttribute("stroke-width", lineWidth);
        backgroundCircle.setAttribute("stroke-dasharray", "100, 100");
        
        var activeCircle = document.createElementNS(svgNamespace, "path");
        activeCircle.setAttribute("d", "M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831");
        activeCircle.setAttribute("fill", "none");
        activeCircle.setAttribute("stroke", activeProgressColor);
        activeCircle.setAttribute("stroke-width", lineWidth);
        activeCircle.setAttribute("stroke-dasharray", "0, 100");
        activeCircle.classList.add("active-circle");
        
        svg.appendChild(backgroundCircle);
        svg.appendChild(activeCircle);
        circle.appendChild(svg);
        
        var span = document.createElement("span");
        span.textContent = "0%";
        circle.appendChild(span);
        
        if (entry.isIntersecting) {
          animatedCircles.add(circle);
          
          var currentPercent = 0;
          function animateCircle() {
            var dashArray = currentPercent + ", 100";
            activeCircle.setAttribute("stroke-dasharray", dashArray);
            span.textContent = Math.round(currentPercent) + "%";
            
            if (currentPercent < percent) {
              currentPercent += 1;
              requestAnimationFrame(animateCircle);
            } else {
              observer.unobserve(circle);
            }
          }
          
          animateCircle();
        }
      });
    }, { threshold: 0.5 });
    
    for (var i = 0; i < circles.length; i++) {
      observer.observe(circles[i]);
    }
  }

  // Инициализация всей секции
  function initSection() {
    
    
    // Сначала загружаем видео в первом слайде
    preloadAllSliderVideos();
    
    // Затем инициализируем слайдер
    var slider = initSlider();
    
    // Настройка воспроизведения видео
    setupVideoPlayback();
    
    // Инициализация анимации процентных кругов
    initPercentCircles();
    
    // Дополнительная принудительная загрузка видимых видео
    setTimeout(function() {
      preloadAllSliderVideos();
    }, 300);
  }

  // Инициализация при загрузке DOM
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(initSection, 50);
  });

  // Обработка событий Shopify Design Mode
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === 'template--22563036889417__ss_video_from_social_4_HYyrRY') {
        setTimeout(initSection, 50);
      }
    });
  }
})();
</script>
