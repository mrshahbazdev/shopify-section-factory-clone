    function initStats() {
      const section = document.querySelector('.section-template--26284301713737__ss_stats_4_zTXwCW');
      if (!section) return;

      const animateCounters = true;
      const alignTextColumn = true && !false;

      if (section._statsInterval) {
        clearInterval(section._statsInterval);
      }

      if (section._statsObserver) {
        section._statsObserver.disconnect();
      }

      if (section._statsResizeHandler) {
        window.removeEventListener('resize', section._statsResizeHandler);
      }

      const spans = section.querySelectorAll('.stats-item-percent-template--26284301713737__ss_stats_4_zTXwCW');
      const wraps = section.querySelectorAll('.stats-item-percent-wrap-template--26284301713737__ss_stats_4_zTXwCW');
      if (!spans.length) return;

      const clearWidths = () => {
        wraps.forEach(wrap => {
          wrap.style.minWidth = '';
          wrap.style.width = '';
        });
      };

      const targets = Array.from(spans).map(span => ({
        el: span,
        target: parseInt(span.dataset.target, 10) || 0,
        current: 0,
      }));
      const widthBuffer = 10;

      if (!alignTextColumn && !animateCounters) {
        clearWidths();
        return;
      }

      const syncWidths = () => {
        clearWidths();

        const originalValues = Array.from(spans).map(span => span.textContent);

        targets.forEach(t => {
          t.el.textContent = t.target;
        });

        if (alignTextColumn) {
          let maxWidth = 0;

          wraps.forEach(wrap => {
            maxWidth = Math.max(maxWidth, Math.ceil(wrap.getBoundingClientRect().width));
          });

          if (maxWidth > 0) {
            wraps.forEach(wrap => {
              wrap.style.minWidth = maxWidth + widthBuffer + 'px';
            });
          }
        } else if (animateCounters) {
          wraps.forEach(wrap => {
            wrap.style.minWidth = Math.ceil(wrap.getBoundingClientRect().width) + widthBuffer + 'px';
          });
        }

        originalValues.forEach((value, index) => {
          spans[index].textContent = value;
        });
      };

      if (animateCounters) {
        spans.forEach(span => {
          span.textContent = '0';
        });
      }

      syncWidths();

      section._statsResizeHandler = () => {
        syncWidths();
