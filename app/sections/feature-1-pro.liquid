<section id="section-{{ section.id }}" class="section-store-feature-1-pro section-style-4">
<style>
.section-store-feature-1-pro {
  --bg: #ecfeff;
  --fg: #083344;
  --accent: #06b6d4;
  --radius: 24px;
  --align: left;
  --shadow: 0 6px 28px rgba(0,0,0,0.07);
  --sectionPadding: 80px 20px;
  background: var(--bg);
  color: var(--fg);
}
.section-store-feature-1-pro .ss-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--sectionPadding);
  text-align: var(--align);
}
.section-store-feature-1-pro .ss-title {
  font-size: clamp(2.2rem, 5vw, 3.75rem);
  font-weight: 800;
  line-height: 1.05;
  margin: 0 0 18px;
  letter-spacing: -0.02em;
}
.section-store-feature-1-pro .ss-subtitle {
  font-size: 1.15rem;
  line-height: 1.7;
  opacity: 0.85;
  max-width: 680px;
  margin: 0 auto 28px;
}
.section-store-feature-1-pro .ss-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 32px;
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius);
  text-decoration: none;
  font-weight: 600;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.section-store-feature-1-pro .ss-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,0.18);
}
.section-store-feature-1-pro img { max-width: 100%; height: auto; border-radius: var(--radius); }
.section-store-feature-1-pro .placeholder-image {
  border-radius: var(--radius);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
}
</style>
<div class="ss-wrap">
  <h2 class="ss-title">{{ section.settings.heading }}</h2>
  <div class="ss-subtitle">{{ section.settings.subheading }}</div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-top: 32px; text-align: center;">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div style="padding: 24px; background: rgba(0,0,0,0.03); border-radius: var(--radius);">
          <div style="width: 48px; height: 48px; margin: 0 auto 16px; background: var(--accent); border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 700;">F</div>
          <h3 style="margin: 0 0 8px; font-size: 1.25rem;">{{ block.settings.heading }}</h3>
          <p style="margin: 0; opacity: 0.8;">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div style="padding: 24px; background: rgba(0,0,0,0.03); border-radius: var(--radius);">
          <div style="width: 48px; height: 48px; margin: 0 auto 16px; background: var(--accent); border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 700;">F</div>
          <h3 style="margin: 0 0 8px; font-size: 1.25rem;">Feature {{ i }}</h3>
          <p style="margin: 0; opacity: 0.8;">Describe a key feature here.</p>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Feature #1 Pro 💎",
  "tag": "section",
  "class": "section-store-feature-1-pro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Add your subheading here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Feature #1 Pro 💎"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Describe this feature."
        }
      ]
    }
  ]
}
{% endschema %}
</section>
