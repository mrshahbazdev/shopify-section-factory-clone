            columnWidth: '.gallery-item-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b'
        });
        document.querySelector('.gallery-items-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b').classList.remove('gallery-items-hide-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');
        document.querySelector('.gallery-items-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b').classList.remove('gallery-items-hide-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');
     });
    });
    jQuery( document ).ready(function( $ ) {
      if(document.querySelector('.gallery-load-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b')) {
        document.querySelector('.gallery-load-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b').addEventListener('click', () => {
          let hiddenElements = document.querySelectorAll('.item-hidden-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');
          hiddenElements.forEach((el, index) => {
            if(index < 5) {
              el.classList.remove('item-hidden-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');
              $('.gallery-items-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b').masonry({
                  itemSelector: '.gallery-item-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b',
                  columnWidth: '.gallery-item-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b'
              });
            }
          })
          if(hiddenElements.length <= 5) {
            document.querySelector('.gallery-load-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b').classList.add('load-hidden-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');
          }
        });
      }
    });

    let btns = document.querySelectorAll('.gallery-toggle-item-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');
    let modals = document.querySelectorAll('.gallery-modal-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');

    if(btns) {
      btns.forEach(el => {
        el.addEventListener('click', () => {
          if(modals) {
            modals.forEach(element => {
              let dataId = element.getAttribute('data-id'); 
              if(el.id == dataId) {
                element.classList.add('active');
                document.body.style.overflow = 'hidden';
              }
            })
          }
        })
      })
    }

    if(modals) {
      modals.forEach(el => {
        let close = el.querySelector('.gallery-close-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b');
        
        if(close) {
           close.addEventListener('click', () => {
            document.body.style.overflow = '';
            el.classList.remove('active');
          }); 
        }
    
        document.addEventListener('click', (e) => {
            if (e.target == el) {
              document.body.style.overflow = '';
              el.classList.remove('active');

            }
        });
      })
    }
  }
  
  document.addEventListener('DOMContentLoaded', initGalleryMasonry);
  
  if (Shopify.designMode) {
