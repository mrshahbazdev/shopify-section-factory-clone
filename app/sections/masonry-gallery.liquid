<script>
  function initGalleryMasonry() {
    document.querySelector('.gallery-items-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b').classList.remove('preview');
    jQuery.noConflict();
    jQuery( document ).ready(function( $ ) {
     new imagesLoaded( document.querySelector('.gallery-items-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b'), function(){
        $('.gallery-items-template--19909586682185__e1bee538-9e42-44d7-870a-d50c0d9d0b5b').masonry({
