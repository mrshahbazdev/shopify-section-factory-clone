<script>
  function initHero12() {
    var lazyLoadInstance = new LazyLoad();

    setTimeout(() => {
      window.addEventListener("LazyLoad::Initialized",function (event) {
        window.lazyLoadInstance = event.detail.instance;
      }, false );
    },300)
    
    const slider = new Swiper(".hero-slider-template--21713878876489__ss_hero_12_PqFye3", {
      speed: 600,
      spaceBetween: 20,
      loop: true,
      navigation: {
        nextEl: '.hero-slider-btn-next-template--21713878876489__ss_hero_12_PqFye3',
      },
      breakpoints: {
        320: {
          spaceBetween: 16,
          slidesPerView: 1.5,
          centeredSlides: true
        },
        768: {
          spaceBetween: 16,
          slidesPerView: 3,
          centeredSlides: true
        },
        1024: {
          spaceBetween: 16,
          slidesPerView: 1.75,
          centeredSlides: false
        }
      },
      on: {
        slideChange: function () {
          const slides = this.slides;
    
          for (let i = 0; i < slides.length; i++) {
            let video = slides[i].querySelector('video');
            if (i === this.activeIndex) {
              if (video) {
                video.play();
              }

            } else {
              if (video) {
                video.pause();
              }

            }
          }
        },
      },
    });

    document.querySelectorAll('.hero-slide-template--21713878876489__ss_hero_12_PqFye3').forEach(el => {
      let soundBtn = el.querySelector('.hero-sound-template--21713878876489__ss_hero_12_PqFye3');
      let video = el.querySelector('video');
      let progress = el.querySelector('progress');
      let playBtn = el.querySelector('.hero-play-template--21713878876489__ss_hero_12_PqFye3');

      if(video) {

        video.addEventListener('ended', () => {
          video.pause();
    
          slider.slideNext();
        });
        
        if(progress) {
            setInterval(function () {
                if (video.duration && isFinite(video.duration)) {
                    progress.value = Math.round((video.currentTime / video.duration) * 100); 
                }
            }); 
        }
      }

      el.addEventListener('click', (event) => {
        if(el.classList.contains('swiper-slide-active')) {
          if(event.target == el) {
            if(playBtn) {
              if(playBtn.classList.contains('active')) {
                playBtn.classList.remove('active');
  
                if (video) {
                  video.play();
                }
  
              } else {
                playBtn.classList.add('active');
                if (video) {
                  video.pause();
                }
  
              }
            }  
          }
        }
      })

      if(playBtn) {
        playBtn.addEventListener('click', () => {
          if(playBtn.classList.contains('active')) {
            playBtn.classList.remove('active');

            if (video) {
              video.play();
            }

          } else {
            playBtn.classList.add('active');
            if (video) {
              video.pause();
            }

          }
        })
      }

      if(soundBtn) {
        soundBtn.addEventListener('click', () => {
          soundBtn.classList.toggle('active');
          if(soundBtn.classList.contains('active')) {
            if(video) {
              video.muted = false;
            }
          } else {
            if(video) {
              video.muted = true;
            }
          }
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initHero12);
  
  if (Shopify.designMode) {
