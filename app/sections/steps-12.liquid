<script>
  function initSteps12template25775584739657__ss_steps_12_SoftPop() {
    const wrapElement = document.querySelector('.steps-wrap-template--25775584739657__ss_steps_12_SoftPop');
    if (!wrapElement) return;

    let currentMode = null;
    let scrollHandler = null;
    let resizeTimeout = null;

    function cleanupHandlers() {
      if (scrollHandler) {
        window.removeEventListener('scroll', scrollHandler);
        scrollHandler = null;
      }
    }

    function resetMobileStyles() {
      const progressBarBg = document.querySelector('.steps-progress-bar-background-template--25775584739657__ss_steps_12_SoftPop');
      const progressBarProgress = document.querySelector('.steps-progress-bar-progress-template--25775584739657__ss_steps_12_SoftPop');
      
      if (progressBarBg) progressBarBg.style.background = '';
      if (progressBarProgress) progressBarProgress.style.background = '';
    }

    function resetDesktopStyles() {
      const progressBar = wrapElement.querySelector('.steps-progress-bar-progress-template--25775584739657__ss_steps_12_SoftPop');
      const dots = wrapElement.querySelectorAll('.steps-item-icon-template--25775584739657__ss_steps_12_SoftPop');
      const items = wrapElement.querySelectorAll('.steps-item-template--25775584739657__ss_steps_12_SoftPop');
      
      if (progressBar) progressBar.style.height = '';
      
      dots.forEach((dot) => {
        dot.style.opacity = '';
      });
      
      items.forEach((item) => {
        const itemBadge = item.querySelector('.steps-item-badge-template--25775584739657__ss_steps_12_SoftPop');
        const itemHeading = item.querySelector('.steps-item-heading-template--25775584739657__ss_steps_12_SoftPop');
        const itemText = item.querySelector('.steps-item-text-template--25775584739657__ss_steps_12_SoftPop');
        if (itemBadge) itemBadge.style.opacity = '';
        if (itemHeading) itemHeading.style.opacity = '';
        if (itemText) itemText.style.opacity = '';
      });
    }

    function updateMobileProgressBar() {
      if (window.innerWidth >= 1024) return;

      const progressBarBg = document.querySelector('.steps-progress-bar-background-template--25775584739657__ss_steps_12_SoftPop');
      const progressBarProgress = document.querySelector('.steps-progress-bar-progress-template--25775584739657__ss_steps_12_SoftPop');
      const itemWraps = document.querySelectorAll('.steps-item-wrap-template--25775584739657__ss_steps_12_SoftPop');
      const progressBarElement = document.querySelector('.steps-progress-bar-template--25775584739657__ss_steps_12_SoftPop');
      
      if (!progressBarBg || !progressBarElement || itemWraps.length === 0) return;

      const progressBarRect = progressBarElement.getBoundingClientRect();
      const progressBarTop = progressBarRect.top + window.scrollY;
      const progressBarHeight = progressBarRect.height;

      let gradientStops = [];
      let currentPosition = 0;

      itemWraps.forEach((wrap) => {
        const wrapRect = wrap.getBoundingClientRect();
        const wrapTop = wrapRect.top + window.scrollY;
        const wrapBottom = wrapTop + wrapRect.height;

        const startPercent = Math.max(0, ((wrapTop - progressBarTop) / progressBarHeight) * 100);
        const endPercent = Math.min(100, ((wrapBottom - progressBarTop) / progressBarHeight) * 100);

        if (currentPosition < startPercent) {
          gradientStops.push(`#ffccbc ${currentPosition}%`);
          gradientStops.push(`#ffccbc ${startPercent}%`);
        }

        gradientStops.push(`transparent ${startPercent}%`);
        gradientStops.push(`transparent ${endPercent}%`);

        currentPosition = endPercent;
      });

      if (currentPosition < 100) {
        gradientStops.push(`#ffccbc ${currentPosition}%`);
        gradientStops.push(`#ffccbc 100%`);
      }

      const gradient = `linear-gradient(to bottom, ${gradientStops.join(', ')})`;
      progressBarBg.style.background = gradient;

      if (progressBarProgress) {
        progressBarProgress.style.background = gradient;
      }
    }

    function updateDesktopProgress() {
      if (window.innerWidth < 1024) return;

      const progressBar = wrapElement.querySelector('.steps-progress-bar-progress-template--25775584739657__ss_steps_12_SoftPop');
      const progressBarBg = wrapElement.querySelector('.steps-progress-bar-background-template--25775584739657__ss_steps_12_SoftPop');
      const dots = wrapElement.querySelectorAll('.steps-item-icon-template--25775584739657__ss_steps_12_SoftPop');
      const items = wrapElement.querySelectorAll('.steps-item-template--25775584739657__ss_steps_12_SoftPop');

      if (!progressBar || !progressBarBg || dots.length === 0 ) return;

      const progressBarBgRect = progressBarBg.getBoundingClientRect();
      const dotsPositions = [];
      
      dots.forEach((dot) => {
        const dotRect = dot.getBoundingClientRect();
        const relativeTop = dotRect.top + (dotRect.height / 2) - progressBarBgRect.top;
        dotsPositions.push(relativeTop);
      });

      const wrapRect = wrapElement.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const midScreen = windowHeight / 1.5;
      
      const wrapTop = wrapRect.top;
      const wrapBottom = wrapRect.bottom;
      const wrapHeight = wrapRect.height;
      
      let progressHeight;
      
      if (wrapBottom <= midScreen) {
        progressHeight = 100;
      } else if (wrapTop >= midScreen) {
        progressHeight = 0;
      } else {
        const distanceFromTopToMid = midScreen - wrapTop;
        const scrollProgress = Math.max(0, Math.min(1, distanceFromTopToMid / wrapHeight));
        progressHeight = scrollProgress * 100;
      }
      
      const progressBarHeight = progressBarBgRect.height;
      const currentProgressPx = (progressHeight / 100) * progressBarHeight;
      
      progressBar.style.height = `${progressHeight}%`;

      let activeIndex = 0;
      
      dots.forEach((dot, index) => {
        const item = items[index];
        const itemBadge = item ? item.querySelector('.steps-item-badge-template--25775584739657__ss_steps_12_SoftPop') : null;
        const itemHeading = item ? item.querySelector('.steps-item-heading-template--25775584739657__ss_steps_12_SoftPop') : null;
        const itemText = item ? item.querySelector('.steps-item-text-template--25775584739657__ss_steps_12_SoftPop') : null;
        
        if (currentProgressPx >= dotsPositions[index]) {
          dot.style.opacity = '1';
          if (itemBadge) itemBadge.style.opacity = '1';
          if (itemHeading) itemHeading.style.opacity = '1';
          if (itemText) itemText.style.opacity = '1';
          activeIndex = index;
        } else {
          dot.style.opacity = '0.5';
          if (itemBadge) itemBadge.style.opacity = '0.5';
          if (itemHeading) itemHeading.style.opacity = '0.5';
          if (itemText) itemText.style.opacity = '0.5';
        }
      });
    }

    function initMobile() {
      resetDesktopStyles();
      updateMobileProgressBar();
      scrollHandler = updateMobileProgressBar;
      window.addEventListener('scroll', scrollHandler);
    }

    function initDesktop() {
      resetMobileStyles();
      
      const dots = wrapElement.querySelectorAll('.steps-item-icon-template--25775584739657__ss_steps_12_SoftPop');
      const items = wrapElement.querySelectorAll('.steps-item-template--25775584739657__ss_steps_12_SoftPop');
      
      if (dots[0]) {
        dots[0].style.opacity = '1';
        const firstItemBadge = items[0] ? items[0].querySelector('.steps-item-badge-template--25775584739657__ss_steps_12_SoftPop') : null;
        const firstItemHeading = items[0] ? items[0].querySelector('.steps-item-heading-template--25775584739657__ss_steps_12_SoftPop') : null;
        const firstItemText = items[0] ? items[0].querySelector('.steps-item-text-template--25775584739657__ss_steps_12_SoftPop') : null;
        if (firstItemBadge) firstItemBadge.style.opacity = '1';
        if (firstItemHeading) firstItemHeading.style.opacity = '1';
        if (firstItemText) firstItemText.style.opacity = '1';
      }
      
      scrollHandler = updateDesktopProgress;
      window.addEventListener('scroll', scrollHandler);
      updateDesktopProgress();
    }

    function handleResize() {
      clearTimeout(resizeTimeout);
      
      resizeTimeout = setTimeout(() => {
        const newMode = window.innerWidth >= 1024 ? 'desktop' : 'mobile';
        
        if (newMode !== currentMode) {
          cleanupHandlers();
          currentMode = newMode;
          
          if (currentMode === 'desktop') {
            initDesktop();
          } else {
            initMobile();
          }
        } else {
          if (currentMode === 'desktop') {
            updateDesktopProgress();
          } else {
            updateMobileProgressBar();
          }
        }
      }, 100);
    }

    currentMode = window.innerWidth >= 1024 ? 'desktop' : 'mobile';
    
    if (currentMode === 'desktop') {
      initDesktop();
    } else {
      initMobile();
    }
    
    window.addEventListener('resize', handleResize);
  }

  document.addEventListener('DOMContentLoaded', initSteps12template25775584739657__ss_steps_12_SoftPop);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initSteps12template25775584739657__ss_steps_12_SoftPop);
    document.addEventListener('shopify:section:load', initSteps12template25775584739657__ss_steps_12_SoftPop);
  }
</script>
