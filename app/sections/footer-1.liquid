  function initFooter7() {
    let thanksText = document.querySelector('.footer-newsletter-thanks-text-template--20857682166089__ss_footer_E8UhYL');
    let submitButton = document.querySelector('.footer-newsletter-submit-template--20857682166089__ss_footer_E8UhYL');
    
    const url = window.location.href;
    if (url.includes('customer_posted=true')) {
      if(thanksText) { 
