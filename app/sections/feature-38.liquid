<script>
  function initFeature38() {
    const toggles = document.querySelectorAll('.feature-toggle-template--23671494672713__ss_feature_38_yBz6jn');
    const images = document.querySelectorAll('.feature-image-template--23671494672713__ss_feature_38_yBz6jn');
    const texts = document.querySelectorAll('.feature-text-template--23671494672713__ss_feature_38_yBz6jn');
    const bgs = document.querySelectorAll('.feature-toggle-bg-template--23671494672713__ss_feature_38_yBz6jn');
    const time = 6 * 1000;
    let currentIndex = 1;
    let intervalId = null;
    let userInteracted = false;

    function setMaxHeight() {
      let maxHeight = 0;
      texts.forEach(text => {
        const height = text.offsetHeight;
        if (height > maxHeight) {
          maxHeight = height;
        }
      });
      texts.forEach(text => {
        text.style.minHeight = `${maxHeight}px`;
      });
    }

    function activateByIndex(index, isUser = false) {
      images.forEach(image => image.classList.remove('active'));
      toggles.forEach(toggle => toggle.classList.remove('active'));
      texts.forEach(text => text.classList.remove('active'));
      if (isUser) {
        bgs.forEach(bg => bg.classList.remove('hide-template--23671494672713__ss_feature_38_yBz6jn'));
      }

      const toggle = toggles[index];
      const dataId = toggle.id;

      images.forEach(image => {
        if (image.getAttribute('data-id') === dataId) {
          image.classList.add('active');
        }
      });

      texts.forEach(text => {
        if (text.getAttribute('data-id') === dataId) {
          text.classList.add('active');
        }
      });

      if (isUser) {
        bgs.forEach(bg => {        
          bg.classList.add('hide-template--23671494672713__ss_feature_38_yBz6jn');          
        });
      }

      toggle.classList.add('active');
    }

    function startAutoSwitching() {
      intervalId = setInterval(() => {
        activateByIndex(currentIndex);
        currentIndex = (currentIndex + 1) % toggles.length;
      }, time);
    }

    setMaxHeight();

    window.addEventListener('resize', () => {
      setMaxHeight();
    });

    toggles.forEach((toggle, index) => {
      toggle.addEventListener('click', () => {
        if (!userInteracted) {
          userInteracted = true;
          clearInterval(intervalId);
        }
        activateByIndex(index, true);
        currentIndex = index;
      });
    });

    if (toggles.length > 1) {
      startAutoSwitching();
    }
  }

  document.addEventListener('DOMContentLoaded', initFeature38);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initFeature38);
    document.addEventListener('shopify:section:load', initFeature38);
  }
</script>
