<script>
  function initModalPopupScrolling() {
    const toggle = document.querySelector('.modal-button-template--26013263593801__ss_modal_popup_4_GGUtHM');
    const modal = document.querySelector('.modal-popup-template--26013263593801__ss_modal_popup_4_GGUtHM');
    const buttonClose = document.querySelector('.modal-button-close-template--26013263593801__ss_modal_popup_4_GGUtHM');
    const close = document.querySelector('.modal-popup-close-template--26013263593801__ss_modal_popup_4_GGUtHM');
    const modalKey = 'modalDisplayedAt_template--26013263593801__ss_modal_popup_4_GGUtHM';

        function openModal() {
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        document.body.style.transform = 'none';
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        document.body.style.transform = '';
      }
    }

    if (toggle) {
      if (buttonClose) {
        buttonClose.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggle.style.display = 'none';
        });
      }

      toggle.addEventListener('click', () => {
        
          openModal();
        
      });
    }

    if (close) {
      close.addEventListener('click', closeModal);
    }

    document.addEventListener('click', (e) => {
      if (e.target == modal) {
        closeModal();
      }
    });

    

    

    

    
  }

  document.addEventListener('DOMContentLoaded', initModalPopupScrolling);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initModalPopupScrolling);
    document.addEventListener('shopify:section:load', initModalPopupScrolling);
  }
</script>
