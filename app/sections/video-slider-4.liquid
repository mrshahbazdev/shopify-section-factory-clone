        slidesPerView: parseFloat(document.querySelector(`.video-slider-slider-template--24825164169545__ss_video_slider_4_VKfbki`).dataset.view || 3),
      }
    },
    on: {
      init: function() {
        // Автоплей при инициализации
        if (true) {
          setTimeout(() => {
            handleCenterSlideAutoplay(this);
          }, 100);
        }
      },
      slideChange: function() {
        // Автоплей при смене слайда
        if (true) {
          handleCenterSlideAutoplay(this);
        }
      }
    }
  });

  const videoItems = document.querySelectorAll(`.video-slider-slide-template--24825164169545__ss_video_slider_4_VKfbki`);
  const centerAutoplay = true;

  function handleCenterSlideAutoplay(swiperInstance) {
    // Останавливаем все видео
    swiperInstance.slides.forEach((slide) => {
      const video = slide.querySelector('video');
      const iframeElement = slide.querySelector('iframe');
      const videoButton = slide.querySelector(`.video-slider-action-template--24825164169545__ss_video_slider_4_VKfbki`);
      
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
      if (iframeElement) {
        iframeElement.src = iframeElement.getAttribute('data-src1');
      }
      if (videoButton) {
        videoButton.classList.add('active');
      }
    });

    // Воспроизводим только активный (центральный) слайд
    const activeSlide = swiperInstance.slides[swiperInstance.activeIndex];
    if (activeSlide) {
      const video = activeSlide.querySelector('video');
      const iframeElement = activeSlide.querySelector('iframe');
      const videoButton = activeSlide.querySelector(`.video-slider-action-template--24825164169545__ss_video_slider_4_VKfbki`);
      
      if (video) {
        video.play();
      }
      if (iframeElement) {
        iframeElement.src = iframeElement.getAttribute('data-src2');
      }
      if (videoButton) {
        videoButton.classList.remove('active');
      }
    }
  }

  videoItems.forEach((item) => {
    const video = item.querySelector('video');
    const iframeElement = item.querySelector('iframe');
    const videoButton = item.querySelector(`.video-slider-action-template--24825164169545__ss_video_slider_4_VKfbki`);
    const soundButton = item.querySelector(`.video-slider-sound-template--24825164169545__ss_video_slider_4_VKfbki`);

    if(video || iframeElement) {    
      if(videoButton) {
        videoButton.addEventListener('click', function() {
          if (videoButton.classList.contains('active')) {
            if (video) {      
              video.play();
            }
            if (iframeElement) {
              iframeElement.src = iframeElement.getAttribute('data-src2'); 
            }   
          } else {
            if (video) {
              video.pause();
            }
            if (iframeElement) {
              iframeElement.src = iframeElement.getAttribute('data-src1'); 
            } 
                   
          }
          videoButton.classList.toggle('active'); 
        })  
      }   
    }

    if(video) {
      if(soundButton) {
        soundButton.addEventListener('click', () => {
          soundButton.classList.toggle('active');
          if(soundButton.classList.contains('active')) {
            if(video) {
              video.muted = false;
              video.setAttribute("mute", "false"); 
            }
          } else {
            if(video) {
              video.muted = true;
              video.setAttribute("mute", "true"); 
            }
          }
        }) 
      }
    }    

  });
}

document.addEventListener('DOMContentLoaded', initvideolider4);

if (Shopify.designMode) {
  document.addEventListener('shopify:section:unload', initvideolider4);
  document.addEventListener('shopify:section:load', initvideolider4);
}
