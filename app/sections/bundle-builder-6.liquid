<script>  
  var formatMoneyForBundle6 = function(cents, format) {
    if (typeof cents == 'string') {
      cents = cents.replace('.', '');
    }
    var value = '';
    var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
    var formatString = format || (typeof Shopify !== 'undefined' && Shopify.money_format);

    if (typeof formatString !== 'string') {
      return '';
    }

    function defaultOption(opt, def) {
      return (typeof opt == 'undefined' ? def : opt);
    }

    function formatWithDelimiters(number, precision, thousands, decimal) {
      precision = defaultOption(precision, 2);
      thousands = defaultOption(thousands, ',');
      decimal = defaultOption(decimal, '.');

      if (isNaN(number) || number == null) {
        return 0;
      }

      number = (number / 100.0).toFixed(precision);

      var parts = number.split('.'),
        dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands),
        cents = parts[1] ? (decimal + parts[1]) : '';

      return dollars + cents;
    }

    const matchResult = formatString.match(placeholderRegex);
    if (!matchResult || !matchResult[1]) {
      return formatWithDelimiters(cents, 2);
    }

    switch (matchResult[1]) {
      case 'amount':
        value = formatWithDelimiters(cents, 2);
        break;
      case 'amount_no_decimals':
        value = formatWithDelimiters(cents, 0);
        break;
      case 'amount_with_comma_separator':
        value = formatWithDelimiters(cents, 2, '.', ',');
        break;
      case 'amount_no_decimals_with_comma_separator':
        value = formatWithDelimiters(cents, 0, '.', ',');
        break;
    }

    return formatString.replace(placeholderRegex, value);
  };

  function initBundleBuilder6() {
    const REMOVE_ICON_SVG = '<svg id="Remove" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32" role="img" aria-labelledby="iconCloseTitle"><title id="iconCloseTitle">Close Icon</title><path id="Fill_1" data-name="Fill 1" d="M32,32H0V0H32V32ZM16,18.121h0l5.333,5.333,2.121-2.121L18.122,16l5.333-5.334-2.121-2.12L16,13.877,10.667,8.545l-2.12,2.12L13.879,16,8.546,21.333l2.12,2.121L16,18.121Z" fill="#000"></path></svg>';

    let sizeButtons = document.querySelectorAll('.bundle-size-button-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    let products = document.querySelectorAll('.bundle-product-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    let sidebarContainer = document.querySelector('.bundle-sidebar-products-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    
    let subtotalElement = document.querySelector('.bundle-sidebar-subtotal-value-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    let savingsElement = document.querySelector('.bundle-sidebar-savings-value-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    let totalElement = document.querySelector('.bundle-sidebar-total-value-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    
    let submitButton = document.querySelector('.bundle-submit-button-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    let form = document.querySelector('.bundle-form-template--25377744486729__ss_bundle_builder_6_aAN8ec');

    const firstSizeButton = document.querySelector('.bundle-size-button-template--25377744486729__ss_bundle_builder_6_aAN8ec.active');
    let currentPackSize = firstSizeButton ? parseInt(firstSizeButton.getAttribute('data-pack-size')) : 2;
    let currentPackDiscount = firstSizeButton ? parseInt(firstSizeButton.getAttribute('data-pack-discount')) : 5;
    
    let selectedProducts = {};

    let tagButtons = document.querySelectorAll('.bundle-tag-button-template--25377744486729__ss_bundle_builder_6_aAN8ec');
    let currentFilterTag = 'all';

    function filterProductsByTag(tag) {
      currentFilterTag = tag;
      
      products.forEach(productEl => {
        if (tag === 'all') {
          productEl.style.display = '';
          return;
        }
        
        const productTagsRaw = productEl.getAttribute('data-tags');
        
        if (!productTagsRaw || productTagsRaw.trim() === '') {
          productEl.style.display = 'none';
          return;
        }
        
        const productTags = productTagsRaw.toLowerCase().split(',').map(t => t.trim());
        const hasTag = productTags.includes(tag.toLowerCase());
        
        productEl.style.display = hasTag ? '' : 'none';
      });
    }

    if (tagButtons) {
      tagButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          tagButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          
          const selectedTag = btn.getAttribute('data-tag');
          filterProductsByTag(selectedTag);
        });
      });
    }

    function getTotalProductCount() {
      let total = 0;
      for (let id in selectedProducts) {
        total += selectedProducts[id].quantity;
      }
      return total;
    }

    function updateProductLimitClasses() {
      const totalCount = getTotalProductCount();
      const isLimitReached = totalCount >= currentPackSize;
      
      products.forEach(productEl => {
        const variantSelect = productEl.querySelector('.bundle-product-variant-select-template--25377744486729__ss_bundle_builder_6_aAN8ec');
        const currentVariantId = variantSelect ? variantSelect.value : productEl.getAttribute('data-product-id');
        const isSelected = selectedProducts.hasOwnProperty(currentVariantId);
        
        if (isLimitReached && !isSelected) {
          productEl.classList.add('limit');
        } else {
          productEl.classList.remove('limit');
        }
      });
    }

    function updateQuantityDisplay(productEl, variantId) {
      const quantityEl = productEl.querySelector('.bundle-product-quantity-template--25377744486729__ss_bundle_builder_6_aAN8ec');
      if (quantityEl && selectedProducts[variantId]) {
        quantityEl.textContent = selectedProducts[variantId].quantity;
      }
    }

    function updateProductActiveState(productEl) {
      const variantSelect = productEl.querySelector('.bundle-product-variant-select-template--25377744486729__ss_bundle_builder_6_aAN8ec');
      const currentVariantId = variantSelect ? variantSelect.value : productEl.getAttribute('data-product-id');
      
      if (selectedProducts.hasOwnProperty(currentVariantId)) {
        productEl.classList.add('active');
        updateQuantityDisplay(productEl, currentVariantId);
      } else {
        productEl.classList.remove('active');
      }
    }

    function renderSidebarSlots() {
      sidebarContainer.innerHTML = '';
      
      const totalCount = getTotalProductCount();
      const emptySlots = currentPackSize - totalCount;
      
      for (let variantId in selectedProducts) {
        const product = selectedProducts[variantId];
        const slotDiv = document.createElement('div');
        slotDiv.className = 'bundle-sidebar-product-template--25377744486729__ss_bundle_builder_6_aAN8ec';
        
        slotDiv.innerHTML = `
          <div class="bundle-sidebar-product-image-template--25377744486729__ss_bundle_builder_6_aAN8ec">
            <img src="${product.image}" alt="${product.title}">
            <span class="bundle-sidebar-product-quantity-badge-template--25377744486729__ss_bundle_builder_6_aAN8ec">${product.quantity}</span>
          </div>
          <div class="bundle-sidebar-product-content-template--25377744486729__ss_bundle_builder_6_aAN8ec">
            <p class="bundle-sidebar-product-title-template--25377744486729__ss_bundle_builder_6_aAN8ec">${product.title}${product.variantTitle ? ' - ' + product.variantTitle : ''}</p>
            <a href="${product.url}" target="_blank" class="bundle-sidebar-product-link-template--25377744486729__ss_bundle_builder_6_aAN8ec">View details</a>
          </div>
        `;

        const removeButton = document.createElement('div');
        removeButton.className = 'bundle-sidebar-remove-icon-template--25377744486729__ss_bundle_builder_6_aAN8ec';
        removeButton.innerHTML = REMOVE_ICON_SVG;
        removeButton.setAttribute('data-variant-id', variantId);
        
        removeButton.addEventListener('click', function(e) {
          e.stopPropagation();
          const id = e.currentTarget.getAttribute('data-variant-id');
          removeProductByVariantId(id);
        });

        slotDiv.appendChild(removeButton);
        sidebarContainer.appendChild(slotDiv);
      }
      
      for (let i = 0; i < emptySlots; i++) {
        const emptyDiv = document.createElement('div');
        emptyDiv.className = 'bundle-sidebar-product-template--25377744486729__ss_bundle_builder_6_aAN8ec empty';
        emptyDiv.innerHTML = `
          <div class="bundle-sidebar-product-image-template--25377744486729__ss_bundle_builder_6_aAN8ec empty"></div>
          <div class="bundle-sidebar-product-content-template--25377744486729__ss_bundle_builder_6_aAN8ec">
            <div class="bundle-sidebar-empty-content-template--25377744486729__ss_bundle_builder_6_aAN8ec"></div>
            <div class="bundle-sidebar-empty-content-template--25377744486729__ss_bundle_builder_6_aAN8ec"></div>
          </div>
        `;
        sidebarContainer.appendChild(emptyDiv);
      }
    }

    function removeProductByVariantId(variantId) {
      if (selectedProducts[variantId]) {
        delete selectedProducts[variantId];
        
        // Update all products to check if they should show active state
        products.forEach(productEl => {
          updateProductActiveState(productEl);
        });
        
        renderSidebarSlots();
        updateTotalPrice();
        updateFormInputs();
        updateProductLimitClasses();
      }
    }

    function updateTotalPrice() {
      let subtotal = 0;
      
      for (let id in selectedProducts) {
        const product = selectedProducts[id];
        subtotal += product.price * product.quantity;
      }

      const discountRate = currentPackDiscount / 100;
      const savingsAmount = subtotal * discountRate;
      const total = subtotal - savingsAmount;

      if (subtotalElement) {
        subtotalElement.textContent = subtotal > 0 ? formatMoneyForBundle6(subtotal, "${{amount}}") : '-';
      }

      if (savingsElement) {
        if (savingsAmount > 0) {
          savingsElement.textContent = '- ' + formatMoneyForBundle6(savingsAmount, "${{amount}}");
        } else {
          savingsElement.textContent = '-';
        }
      }

      if (totalElement) {
        totalElement.textContent = total > 0 ? formatMoneyForBundle6(total, "${{amount}}") : '-';
      }

      const totalCount = getTotalProductCount();
      const allSlotsFilled = totalCount === currentPackSize;
      
      submitButton.disabled = !allSlotsFilled;
    }

    function updateFormInputs() {
      const oldInputs = form.querySelectorAll('input[name^="items"]');
      oldInputs.forEach(input => input.remove());

      let index = 0;
      for (let id in selectedProducts) {
        const product = selectedProducts[id];
        
        const idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = `items[${index}][id]`;
        idInput.value = id;
        form.appendChild(idInput);

        const qtyInput = document.createElement('input');
        qtyInput.type = 'hidden';
        qtyInput.name = `items[${index}][quantity]`;
        qtyInput.value = product.quantity;
        form.appendChild(qtyInput);
        
        index++;
      }
    }

    if (sizeButtons) {
      sizeButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          sizeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          currentPackSize = parseInt(btn.getAttribute('data-pack-size'));
          currentPackDiscount = parseInt(btn.getAttribute('data-pack-discount'));
          
          let totalCount = getTotalProductCount();
          if (totalCount > currentPackSize) {
            for (let id in selectedProducts) {
              if (totalCount <= currentPackSize) break;
              
              const product = selectedProducts[id];
              const reduceBy = Math.min(product.quantity, totalCount - currentPackSize);
              product.quantity -= reduceBy;
              totalCount -= reduceBy;
              
              if (product.quantity === 0) {
                delete selectedProducts[id];
              }
            }
          }

          // Update all products
          products.forEach(productEl => {
            updateProductActiveState(productEl);
          });
          
          renderSidebarSlots();
          updateTotalPrice();
          updateFormInputs();
          updateProductLimitClasses();
        });
      });
    }

    if (products) {
      products.forEach(productEl => {
        const productButton = productEl.querySelector('.bundle-product-button-template--25377744486729__ss_bundle_builder_6_aAN8ec');
        const minusButton = productEl.querySelector('.bundle-product-quantity-minus-template--25377744486729__ss_bundle_builder_6_aAN8ec');
        const plusButton = productEl.querySelector('.bundle-product-quantity-plus-template--25377744486729__ss_bundle_builder_6_aAN8ec');
        const variantSelect = productEl.querySelector('.bundle-product-variant-select-template--25377744486729__ss_bundle_builder_6_aAN8ec');

        if (productButton) {
          productButton.addEventListener('click', function() {
            if (productEl.classList.contains('limit')) {
              return;
            }

            const currentVariantId = variantSelect ? variantSelect.value : productEl.getAttribute('data-product-id');
            const totalCount = getTotalProductCount();
            
            if (totalCount >= currentPackSize) {
              return;
            }

            const selectedOption = variantSelect ? variantSelect.options[variantSelect.selectedIndex] : null;
            const productPrice = selectedOption ? parseInt(selectedOption.getAttribute('data-price')) : parseInt(productEl.getAttribute('data-price'));
            const productImage = selectedOption && selectedOption.getAttribute('data-image') ? selectedOption.getAttribute('data-image') : productEl.getAttribute('data-image');
            const productTitle = productEl.getAttribute('data-title');
            const productUrl = productEl.getAttribute('data-url');
            let variantTitle = '';
            
            if (variantSelect) {
              variantTitle = selectedOption.textContent.trim();
            }

              let highResImage = productImage;

              if (productImage.includes('width=')) {
                highResImage = productImage.replace(/([?&]width=)(\d+)/, '$1600');
                if (!highResImage.includes('height=')) {
                  highResImage += '&height=600';
                }
                if (!highResImage.includes('crop=')) {
                  highResImage += '&crop=center';
                }
              }

              else if (/_\d+x/.test(productImage)) {
                highResImage = productImage.replace(/(_\d+x\d+\.)|(_\d+x\.)|(\.\w+$)/, function(match, p1, p2, p3) {
                  if (p3) return '_600x600_crop_center' + p3;
                  return match;
                });
              }

            if (selectedProducts[currentVariantId]) {
              selectedProducts[currentVariantId].quantity++;
            } else {
              selectedProducts[currentVariantId] = {
                id: currentVariantId,
                price: productPrice,
                image: highResImage,
                title: productTitle,
                url: productUrl,
                variantTitle: variantTitle,
                quantity: 1
              };
            }

            updateProductActiveState(productEl);
            renderSidebarSlots();
            updateTotalPrice();
            updateFormInputs();
            updateProductLimitClasses();
          });
        }

        if (minusButton) {
          minusButton.addEventListener('click', function(e) {
            e.stopPropagation();
            const currentVariantId = variantSelect ? variantSelect.value : productEl.getAttribute('data-product-id');
            
            if (selectedProducts[currentVariantId]) {
              selectedProducts[currentVariantId].quantity--;
              
              if (selectedProducts[currentVariantId].quantity === 0) {
                delete selectedProducts[currentVariantId];
              }

              updateProductActiveState(productEl);
              renderSidebarSlots();
              updateTotalPrice();
              updateFormInputs();
              updateProductLimitClasses();
            }
          });
        }

        if (plusButton) {
          plusButton.addEventListener('click', function(e) {
            e.stopPropagation();
            const currentVariantId = variantSelect ? variantSelect.value : productEl.getAttribute('data-product-id');
            const totalCount = getTotalProductCount();
            
            if (totalCount >= currentPackSize) {
              return;
            }

            if (selectedProducts[currentVariantId]) {
              selectedProducts[currentVariantId].quantity++;
              updateProductActiveState(productEl);
              
              renderSidebarSlots();
              updateTotalPrice();
              updateFormInputs();
              updateProductLimitClasses();
            }
          });
        }

        if (variantSelect) {
          variantSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const newVariantId = selectedOption.value;
            const newPrice = selectedOption.getAttribute('data-price');
            const newImage = selectedOption.getAttribute('data-image') || productEl.getAttribute('data-image');
            
            productEl.setAttribute('data-product-id', newVariantId);
            productEl.setAttribute('data-price', newPrice);
            
            const buttonInner = productEl.querySelector('.bundle-product-button-inner-template--25377744486729__ss_bundle_builder_6_aAN8ec');
            if (buttonInner) {
              const priceFormatted = formatMoneyForBundle6(newPrice, "${{amount}}");
              const buttonText = 'ADD';
              buttonInner.childNodes[0].textContent = buttonText + ' - ' + priceFormatted + ' ';
            }
            
            // Check if this new variant is already in selectedProducts
            updateProductActiveState(productEl);
          });
        }
      });
    }

    renderSidebarSlots();
    updateTotalPrice();
    updateProductLimitClasses();
  }

  document.addEventListener('DOMContentLoaded', initBundleBuilder6);
</script>
