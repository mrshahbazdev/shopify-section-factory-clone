<script>
          (function () {
            var blockId = 'buy_box_iVyyPe';

            function initBuyBox_buy_box_iVyyPe() {
              var block = document.querySelector('.listicle-buybox-' + blockId);
              if (!block) return;

              var mainImg = document.getElementById('buybox-main-img-' + blockId);
              var thumbs = block.querySelectorAll('.buybox-thumb-item');
              if (mainImg && thumbs.length) {
                thumbs.forEach(function (thumb) {
                  if (thumb.dataset.initialized) return;
                  thumb.dataset.initialized = "true";

                  thumb.addEventListener('click', function () {
                    var newSrc = this.getAttribute('data-src');
                    var newSrcset = this.getAttribute('data-srcset');
                    var newAlt = this.getAttribute('data-alt');
                    // Clear srcset first so browser picks up the new src immediately
                    if (newSrcset !== null) mainImg.removeAttribute('srcset');
                    if (newSrc) mainImg.setAttribute('src', newSrc);
                    if (newSrcset) mainImg.setAttribute('srcset', newSrcset);
                    if (newAlt) mainImg.setAttribute('alt', newAlt);

                    thumbs.forEach(function (t) { t.classList.remove('active'); });
                    this.classList.add('active');
                  });
                });
              }

              var atcBtn = block.querySelector('.listicle-atc-btn');
              let cartApp = atcBtn?.dataset?.cartApp || 'auto-detect';
              var variantSelect = block.querySelector('.buybox-variant-select');
              if (variantSelect && atcBtn) {
                variantSelect.addEventListener('change', function() {
                  atcBtn.setAttribute('data-variant-id', this.value);
                  var selOpt = this.options[this.selectedIndex];
                  atcBtn.disabled = selOpt ? selOpt.disabled : false;
                });
              }
              var variantPills = block.querySelectorAll('.buybox-variant-pill');
              if (variantPills.length && atcBtn) {
                variantPills.forEach(function(pill) {
                  pill.addEventListener('click', function() {
                    if (this.disabled) return;
                    var variantId = this.getAttribute('data-variant-id');
                    atcBtn.setAttribute('data-variant-id', variantId);
                    variantPills.forEach(function(p) { p.classList.remove('active'); });
                    this.classList.add('active');
                  });
                });
              }
              if (atcBtn && !atcBtn.dataset.atcInit) {
                atcBtn.dataset.atcInit = 'true';
                atcBtn.addEventListener('click', function() {
                  var btn = this;
                  var variantId = btn.getAttribute('data-variant-id');
                  if (!variantId || btn.disabled) return;

                  var inner = btn.querySelector('.listicle-global-btn-inner');
                  var originalHTML = inner.innerHTML;
                  var addedLabel = btn.getAttribute('data-added-label') || '✓';
                  btn.disabled = true;
                  inner.textContent = '...';

                  var _cartEl = document.querySelector('cart-drawer, cart-notification');
                  var _sections;
                  if (_cartEl && typeof _cartEl.getSectionsToRender === 'function') {
                    _sections = _cartEl.getSectionsToRender().map(function(s) { return s.id; });
                  } else {
                    _sections = ['cart-notification', 'cart-drawer', 'cart-icon-bubble'];
                  }

                  const cartItemsComponents = document.querySelectorAll('cart-items-component');
                  let cartItemComponentsSectionIds = [];
                  cartItemsComponents.forEach((item) => {
                    if (item instanceof HTMLElement && item.dataset.sectionId) {
                      _sections.push(item.dataset.sectionId)
                    }
                  });

                  fetch('/cart/add.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ items: [{id: parseInt(variantId, 10), quantity: 1}], sections: _sections })
                  })
                  .then(function(res) { return res.json(); })
                  .then(function(data) {
                    if (data.status) {
                      inner.innerHTML = originalHTML;
                      btn.disabled = false;
                      if (data.description) {
                        var errorEl = block.querySelector('.listicle-atc-error');
                        if (errorEl) {
                          var errorMsgEl = errorEl.querySelector('.listicle-atc-error__message');
                          if (errorMsgEl) errorMsgEl.innerHTML = data.description;
                          errorEl.classList.remove('hidden');
                          setTimeout(function() {
                            errorEl.classList.add('hidden');
                          }, 4000);
                        }
                      }
                      return;
                    }
                    inner.textContent = addedLabel;

                    const themeSchemaName = (window.Shopify?.theme?.schema_name ?? '').toLowerCase()

                    const isCartApp = (name) => (cartApp === name || cartApp === "auto-detect")

                    if (isCartApp("upcart") && window.upcartOpenCart) {
                      window.upcartOpenCart()
                      window.upcartRefreshCart()
                      return
                    }

                    if (isCartApp("amp-cart") && window.SLIDECART_OPEN) {
                      window.SLIDECART_UPDATE()
                      window.SLIDECART_OPEN()
                      return
                    }

                    if (isCartApp("kaching-cart") && window.kachingCartApi) {
                      window.kachingCartApi.openCart({refetchCart: true})
                      return
                    }

                    // Theme Dawn
                    var cartEl = document.querySelector('cart-drawer, cart-notification');
                    if (cartEl && !['prestige','symmetry'].includes(themeSchemaName)) {
                      if (typeof cartEl.renderContents === 'function') {
                        const items = data.items || []
                        items.forEach(item => {
                          item.sections = data.sections
                          cartEl.renderContents(item)
                        });
                        cartEl.classList.remove('is-empty');
                      } else {
                        if (data.sections) {
                          var _parser = new DOMParser();
                          Object.keys(data.sections).forEach(function(id) {
                            var _src = _parser.parseFromString(data.sections[id], 'text/html').getElementById(id);
                            var _dest = document.getElementById(id);
                            if (_src && _dest) _dest.innerHTML = _src.innerHTML;
                          });
                        }
                      }
                      if (typeof cartEl.open === 'function') cartEl.open();
                      else if (typeof cartEl.show === 'function') cartEl.show();
                      return
                    }

                    // Theme Horizon 4
                    const modernHorizonDrawer = document.querySelector('theme-drawer#cart-drawer');
                    if (modernHorizonDrawer) {
                      const shopRoot = window.Shopify?.routes?.root || '/';
                      const cartUpdatePromise = fetch(shopRoot.replace(/\/?$/, '/') + 'cart.js')
                        .then(function(response) {
                          if (!response.ok) throw new Error('Unable to refresh the cart.');
                          return response.json();
                        })
                        .then(function(cart) {
                          return {
                            cart: { totalQuantity: cart.item_count },
                            detail: {
                              didError: false,
                              itemCount: 1,
                              items: cart.items,
                              productId: String(10266547224905),
                              sections: data.sections,
                              source: 'ss-listicle',
                              sourceId: blockId
                            }
                          };
                        });

                      const cartUpdateEvent = new Event('shopify:cart:lines-update', { bubbles: true });
                      cartUpdateEvent.action = 'add';
                      cartUpdateEvent.context = 'product';
                      cartUpdateEvent.lines = [{ merchandiseId: String(variantId), quantity: 1 }];
                      cartUpdateEvent.promise = cartUpdatePromise;
                      modernHorizonDrawer.dispatchEvent(cartUpdateEvent);

                      cartUpdatePromise.then(function() {
                        if (modernHorizonDrawer.hasAttribute('open')) return;
                        if (typeof window.Shopify?.actions?.openCart === 'function') {
                          return window.Shopify.actions.openCart().catch(function() {
                            if (typeof modernHorizonDrawer.open === 'function') modernHorizonDrawer.open();
                            else window.location.href = '/cart';
                          });
                        }
                        if (typeof modernHorizonDrawer.open === 'function') {
                          modernHorizonDrawer.open();
                        } else {
                          window.location.href = '/cart';
                        }
                      }).catch(function() {
                        window.location.href = '/cart';
                      });
                      return
                    }

                    // Theme Horizon 1-3
                    if (document.querySelector("cart-drawer-component")) {
                      const cartUpdateEvent = new Event('cart:update', {bubbles: true})
                      cartUpdateEvent.detail = {
                        data: {
                          itemCount: 1,
                          productId: 10266547224905,
                          source: "product-form-component"
                        }
                      }
                      document.dispatchEvent(cartUpdateEvent);

                      setTimeout(function() {
                        const cartDrawerComponent = document.querySelector("cart-drawer-component")
                        if (cartDrawerComponent) {
                          cartDrawerComponent.open()
                        }
                      }, 100);
                      return
                    }

                    if (themeSchemaName === 'impulse') {
                      if (window.theme?.settings?.cartType !== "page") {
                        document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
                        return
                      }
                    }

                    if (themeSchemaName === 'prestige') {
                      if (window.themeVariables?.settings?.cartType !== "page") {
                        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                        const cartDrawer = document.querySelector("cart-drawer")
                        if (cartDrawer) {
                          cartDrawer.show()
                        } else {
                          document.dispatchEvent(new CustomEvent('product:added', { detail: {} }))
                        }
                        return
                      }
                    }

                    if (themeSchemaName === 'symmetry') {
                      const afterAddToCart = window.theme?.settings?.afterAddToCart ?? window.theme?.settings?.after_add_to_cart
                      if (afterAddToCart === "drawer") {
                        document.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false, detail: { openDrawer: true } })); // Support theme V6 and under
                        document.dispatchEvent(new CustomEvent('on:cart:change'))
                        document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh'))
                        document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open'))
                        return
                      } else if (afterAddToCart === "notification") {
                        document.documentElement.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false })); // Support theme V6 and under
                        const items = data.items || []
                        items.forEach(item => {
                          const notification = document.getElementById('AddedNotification').content.firstElementChild.cloneNode(true);
                          notification.dataset.productTitle = item.product_title;
                          let notificationContainer = document.querySelector('.pageheader--sticky');
                          if (!notificationContainer) {
                            notificationContainer = document.querySelector('body');
                          }
                          notificationContainer.appendChild(notification);
                        });
                        return
                      }
                    }

                    const cartUrl = window.theme?.routes?.cartPage ?? '/cart'
                    window.location.href = cartUrl;
                  })
                  .catch(function() {
                    inner.innerHTML = originalHTML;
                    btn.disabled = false;
                  })
                  .finally(function() {
                    setTimeout(function() {
                      inner.innerHTML = originalHTML;
                      btn.disabled = false;
                    }, 2500);
                  })
                });
              }
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', initBuyBox_buy_box_iVyyPe);
            } else {
              initBuyBox_buy_box_iVyyPe();
            }

            if (typeof Shopify !== 'undefined' && Shopify.designMode) {
              document.addEventListener('shopify:section:load', initBuyBox_buy_box_iVyyPe);
              document.addEventListener('shopify:block:select', function(e) {
                if (e.detail && e.detail.blockId === blockId) initBuyBox_buy_box_iVyyPe();
              });
            }
          })();
        </script>
