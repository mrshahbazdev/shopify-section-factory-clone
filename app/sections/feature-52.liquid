  const prevBtn = document.querySelector('.feature-accordion-btn-prev-template--25189106745673__ss_feature_52_NewDesign');
  const nextBtn = document.querySelector('.feature-accordion-btn-next-template--25189106745673__ss_feature_52_NewDesign');

  if (items.length === 0 || !sectionElement) return;

  let currentIndex = 0;
  let isPlaying = true;
  let isVisible = false;
  let progressInterval = null;
  let progressTimeout = null;
  let progressDuration = 7 * 1000;
  let pausedProgress = 0;
  let progressStartTime = 0;

  const itemsData = Array.from(items).map(item => ({
    item: item,
    heading: item.querySelector('.feature-accordion-heading-template--25189106745673__ss_feature_52_NewDesign'),
    collapsible: item.querySelector('.feature-collapsible-template--25189106745673__ss_feature_52_NewDesign'),
    progressBar: item.querySelector('.feature-progress-bar-progress-template--25189106745673__ss_feature_52_NewDesign')
  }));

  const playIcon = playPauseBtn?.querySelector('.play');
  const pauseIcon = playPauseBtn?.querySelector('.pause');

  // Create intersection observer
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const wasVisible = isVisible;
      isVisible = entry.isIntersecting;
      
      if (!wasVisible && isVisible && isPlaying) {
        // Section became visible and should be playing
        activateItem(currentIndex, true);
      } else if (wasVisible && !isVisible) {
        // Section became invisible - pause animation
        clearTimers();
        const currentData = itemsData[currentIndex];
        if (currentData.progressBar) {
          const currentWidth = parseFloat(currentData.progressBar.style.width) || 0;
          pausedProgress = currentWidth / 100;
        }
      }
    });
  }, {
    threshold: 0.3 // Trigger when 30% of section is visible
  });

  observer.observe(sectionElement);

  if (playIcon) {
    playIcon.style.opacity = '0';
  }
  if (pauseIcon) {
    pauseIcon.style.opacity = '1';
  }

  itemsData.forEach(data => {
    if (data.collapsible) {
      data.collapsible.style.height = '0';
    }
    if (data.progressBar) {
      data.progressBar.style.width = '0';
    }
  });

  function updateNavButtons() {
    if (prevBtn) {
      if (currentIndex === 0) {
        prevBtn.classList.add('btn-disabled');
      } else {
        prevBtn.classList.remove('btn-disabled');
      }
    }
    
    if (nextBtn) {
      if (currentIndex === items.length - 1) {
        nextBtn.classList.add('btn-disabled');
      } else {
        nextBtn.classList.remove('btn-disabled');
      }
    }
  }

  function updatePlayPauseIcon() {
    if (!playIcon || !pauseIcon) return;
    
    if (isPlaying) {
      playIcon.style.opacity = '1';
      pauseIcon.style.opacity = '0';
    } else {
      playIcon.style.opacity = '0';
      pauseIcon.style.opacity = '1';
    }
  }

  function clearTimers() {
    if (progressInterval) {
      cancelAnimationFrame(progressInterval);
      progressInterval = null;
    }
    if (progressTimeout) {
      clearTimeout(progressTimeout);
      progressTimeout = null;
    }
  }

  function animateProgress(currentData, startProgress = 0) {
    if (!currentData.progressBar || !isVisible) return;

    const startTime = performance.now();
    let lastProgress = startProgress;
    
    currentData.progressBar.style.width = (startProgress * 100) + '%';
    
    function animate(currentTime) {
      if (!isPlaying || !isVisible) {
        pausedProgress = lastProgress;
        return;
      }
      
      const elapsed = currentTime - startTime;
      const progress = Math.min(startProgress + (elapsed / progressDuration), 1);
      lastProgress = progress;
      
      currentData.progressBar.style.width = (progress * 100) + '%';
      
      if (progress < 1) {
        progressInterval = requestAnimationFrame(animate);
      } else if (progress >= 1) {
        pausedProgress = 0;
        progressTimeout = setTimeout(() => {
          let nextIndex = currentIndex + 1;
          if (nextIndex >= items.length) {
            nextIndex = 0;
          }
          activateItem(nextIndex);
        }, 0);
      }
    }
    
    progressInterval = requestAnimationFrame(animate);
  }

  function activateItem(index, resumeFromPause = false) {
    clearTimers();
    
    if (!resumeFromPause || index !== currentIndex) {
      pausedProgress = 0;
      
      itemsData.forEach(data => {
        data.item.classList.remove('active');
        if (data.collapsible) {
          data.collapsible.style.height = '0';
        }
        if (data.progressBar) {
          data.progressBar.style.width = '0';
          data.progressBar.style.transition = 'none';
        }
      });
      
      currentIndex = index;
    } else {
      itemsData.forEach((data, idx) => {
        if (idx !== currentIndex) {
          data.item.classList.remove('active');
          if (data.collapsible) {
            data.collapsible.style.height = '0';
          }
          if (data.progressBar) {
            data.progressBar.style.width = '0';
            data.progressBar.style.transition = 'none';
          }
        }
      });
    }
    
    itemsData[currentIndex].item.classList.add('active');
    
    if (currentIndexEl) {
      currentIndexEl.textContent = currentIndex + 1;
    }

    updateNavButtons();
    
    const currentData = itemsData[currentIndex];
    
    if (currentData.collapsible) {
      currentData.collapsible.style.height = currentData.collapsible.scrollHeight + 'px';
    }
    
    if (isPlaying && currentData.progressBar && isVisible) {
      currentData.progressBar.style.transition = 'none';
      animateProgress(currentData, pausedProgress);
    }
  }

  if (playPauseBtn) {
    playPauseBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;
      updatePlayPauseIcon();
      
      if (isPlaying && isVisible) {
        activateItem(currentIndex, true);
      } else {
        clearTimers();
        const currentData = itemsData[currentIndex];
        if (currentData.progressBar) {
          const currentWidth = parseFloat(currentData.progressBar.style.width) || 0;
          pausedProgress = currentWidth / 100;
        }
      }
    });
  }

  itemsData.forEach((data, index) => {
    if (data.heading) {
      data.heading.addEventListener('click', () => {
        if (index !== currentIndex) {
          pausedProgress = 0;
          isPlaying = true;
          updatePlayPauseIcon();
          activateItem(index);
        }
      });
    }
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        pausedProgress = 0;
        isPlaying = true;
        updatePlayPauseIcon();
        activateItem(currentIndex - 1);
      }
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      if (currentIndex < items.length - 1) {
        pausedProgress = 0;
        isPlaying = true;
        updatePlayPauseIcon();
        activateItem(currentIndex + 1);
      }
    });
  }

  updatePlayPauseIcon();
  activateItem(0);
}

document.addEventListener('DOMContentLoaded', initFeature);

if (Shopify.designMode) {
  document.addEventListener('shopify:section:unload', initFeature);
  document.addEventListener('shopify:section:load', initFeature);
}
</script>
