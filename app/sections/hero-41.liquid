<script>
  function initHero41() {
    const sliderEl = document.querySelector(`.hero-slider-template--24604234318153__ss_hero_41_rR9tgh`);
    const sectionId = "template--24604234318153__ss_hero_41_rR9tgh";
    const autoplayDelay = 5 * 1000;

    const style = document.createElement('style');
    style.textContent = `
      .hero-slide-${sectionId} .hero-progress-line-${sectionId}:after {
        animation: none !important;
        transition: width ${autoplayDelay}ms linear;
      }
    `;
    document.head.appendChild(style);

    let slider = new Swiper(sliderEl, {
      speed: 500,
      loop: true,
      navigation: {
        nextEl: `.hero-btn-next-template--24604234318153__ss_hero_41_rR9tgh`,
        prevEl: `.hero-btn-prev-template--24604234318153__ss_hero_41_rR9tgh`,
      },
      
        autoplay: {
          delay: autoplayDelay,
          disableOnInteraction: false,
        },
      
      on: {
        init: function() {
          updateProgressBar(this);
        },
        slideChange: function() {
          updateProgressBar(this);
        },
        
        autoplayStart: function() {
          updateProgressBar(this);
        },
        
      }
    });

    function updateProgressBar(swiper) {
      const allProgressBars = sliderEl.querySelectorAll('.hero-progress-line-template--24604234318153__ss_hero_41_rR9tgh:after');
      const allSlides = sliderEl.querySelectorAll('.hero-slide-template--24604234318153__ss_hero_41_rR9tgh');
      
      allSlides.forEach(slide => {
        const progressBar = slide.querySelector('.hero-progress-line-template--24604234318153__ss_hero_41_rR9tgh');
        if (progressBar) {
          const after = progressBar;
          after.style.setProperty('--progress-width', '0%');
          progressBar.setAttribute('data-active', 'false');
        }
      });

      const activeSlide = swiper.slides[swiper.activeIndex];
      const activeProgressBar = activeSlide?.querySelector('.hero-progress-line-template--24604234318153__ss_hero_41_rR9tgh');
      
      if (activeProgressBar) {
        activeProgressBar.setAttribute('data-active', 'true');
        
        setTimeout(() => {
          activeProgressBar.style.setProperty('--progress-width', '100%');
        }, 50);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initHero41);

