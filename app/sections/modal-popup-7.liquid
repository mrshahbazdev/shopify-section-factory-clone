      if (emailHeading3)   emailHeading3.style.display = 'none';
      if (emailSubheading3) emailSubheading3.style.display = 'none';
      
    }

    // Theme editor preview: show any step without spinning or submitting the form.
    if (window.Shopify && Shopify.designMode) {
      const previewStep = editorPreviewStep;
      const step1 = document.querySelector('.modal-popup-step1-template--26734776549705__ss_modal_popup_7_WGH3gg');
