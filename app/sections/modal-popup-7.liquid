                  const step1 = document.querySelector('.modal-popup-step1-template--26734776549705__ss_modal_popup_7_WGH3gg');
                  const emailStep = document.querySelector('.modal-popup-email-step-template--26734776549705__ss_modal_popup_7_WGH3gg');

                  if (emailStep && promocode) {
                    sessionStorage.setItem('mp7_promo_template--26734776549705__ss_modal_popup_7_WGH3gg', promocode);
                  }

                  if (step1 && emailStep) {
