      const promoValueEl = emailStep ? emailStep.querySelector('.mp7-email-promo-value-template--26734776549705__ss_modal_popup_7_WGH3gg') : null;
      if (promoBox && promoValueEl && storedPromo) {
        promoValueEl.textContent = storedPromo;
