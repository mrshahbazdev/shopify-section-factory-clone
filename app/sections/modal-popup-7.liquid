          const spinTriggers = document.querySelectorAll('.modal-popup-template--26734776549705__ss_modal_popup_7_WGH3gg [data-spin-trigger]');
          let hasSpun = false;

          spinTriggers.forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              if (hasSpun) return;
              hasSpun = true;

              const randomNum = Math.floor(Math.random() * 4) + 1;
              const targetDeg = 3600 - 45 - (randomNum - 1) * 90;

              spinEl.style.animation = 'none';
              void spinEl.offsetWidth;
              spinEl.style.transform = `rotate(${targetDeg}deg)`;

              setTimeout(() => {
                const restAngles = { 1: -45, 2: -135, 3: -225, 4: -315 };
                spinEl.style.transition = 'none';
                spinEl.style.transform = `rotate(${restAngles[randomNum]}deg)`;
                void spinEl.offsetWidth;
                spinEl.classList.add(`modal-popup-swing-animate-${randomNum}-${blockId}`);

                const promocode = spinEl.dataset[`promocode-${randomNum}`];

                // Transition to email step after the wheel settles.
