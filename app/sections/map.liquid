<script>
            (() => {
              let map;
              let targetLocation;

              function showFallback() {
                const mapEl = document.querySelector('.map-template--19484937486665__2a446453-1963-4464-88c5-995f0676dce3');
                const fallback = document.getElementById('map-fallback-template--19484937486665__2a446453-1963-4464-88c5-995f0676dce3');
                if (mapEl) mapEl.innerHTML = '';
                if (fallback) fallback.style.display = 'block';
              }

              function setMapCenter() {
                if (map && targetLocation) {
                  if (window.innerWidth < 750) {
                    map.setCenter({ lat: targetLocation.lat() + 0.005, lng: targetLocation.lng() });
                  } else {
                    map.setCenter({ lat: targetLocation.lat(), lng: targetLocation.lng() - 0.01 });
                  }
                }
              }
              window.addEventListener('resize', setMapCenter);

              async function initMap() {
                try {
                  //@ts-ignore
                  const { Map } = await google.maps.importLibrary('maps');
                  const { PlacesService } = await google.maps.importLibrary('places');

                  const mapEl = document.querySelector('.map-template--19484937486665__2a446453-1963-4464-88c5-995f0676dce3');
                  map = new Map(mapEl, {
                    center: { lat: -33.867, lng: 151.195 },
                    zoom: 15,
                  });

                  const request = {
                    query: 'Havnegade 12, Copenhagen, Denmark',
                    fields: ['name', 'geometry'],
                  };

                  new PlacesService(map).findPlaceFromQuery(request, (results, status) => {
                    if (status === google.maps.places.PlacesServiceStatus.OK && results) {
                      new google.maps.Marker({
                        map,
                        position: results[0].geometry.location,
                      });
                      targetLocation = results[0].geometry.location;
                      setMapCenter();
                    }
                  });
                } catch (e) {
                  showFallback();
                }
              }

              initMap();

              if (window.Shopify && window.Shopify.designMode) {
                document.addEventListener('shopify:section:load', function () {
                  map = null;
                  document.querySelector('.map-template--19484937486665__2a446453-1963-4464-88c5-995f0676dce3').innerHTML = '';
                  const fallback = document.getElementById('map-fallback-template--19484937486665__2a446453-1963-4464-88c5-995f0676dce3');
                  if (fallback) fallback.style.display = 'none';
                  setTimeout(() => { initMap(); }, 100);
                });
              }
            })();
          </script></div>
