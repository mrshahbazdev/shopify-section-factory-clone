<script>
  function initModalPopup2() {
    setTimeout(() => {
      const discountCodes = document.querySelectorAll(".modal-popup-promocode-text-template--23355189723465__ss_modal_popup_2_yD6dQ6");
      const copyIcons = document.querySelectorAll(".modal-popup-promocode-template--23355189723465__ss_modal_popup_2_yD6dQ6");
      const message = document.querySelector(".modal-popup-message-template--23355189723465__ss_modal_popup_2_yD6dQ6");

      function copyToClipboard(text) {
        // Create temporary textarea
        const tempInput = document.createElement("textarea");
        tempInput.value = text;
        document.body.appendChild(tempInput);

        // Select and copy text
        tempInput.select();
        document.execCommand("copy");

        // Remove temporary element
        document.body.removeChild(tempInput);

        // Show message
        message.classList.add('active');

        // Hide message after delay
        setTimeout(() => {
          message.classList.remove('active');
        }, 1000);
      }

      discountCodes.forEach(codeElement => {
        codeElement.addEventListener("click", () => {
          copyToClipboard(codeElement.innerText);
        });
      });

      copyIcons.forEach((copyIcon, index) => {
        copyIcon.addEventListener("click", () => {
          const codeElement = discountCodes[index];
          if (codeElement) {
            copyToClipboard(codeElement.innerText);
          }
        });
      });
    }, 400);

    const toggle = document.querySelector('.modal-button-template--23355189723465__ss_modal_popup_2_yD6dQ6');
    const modal = document.querySelector('.modal-popup-template--23355189723465__ss_modal_popup_2_yD6dQ6');
    const close = document.querySelector('.modal-popup-close-template--23355189723465__ss_modal_popup_2_yD6dQ6');
    const modalKey = 'modalDisplayedAt_template--23355189723465__ss_modal_popup_2_yD6dQ6';

    if(toggle) {
      toggle.addEventListener('click', () => {
        if(modal) {
          
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
            document.body.style.transform = 'none';
          
        }
      })
    }

    if(close) {
       close.addEventListener('click', () => {
        document.body.style.overflow = '';
        document.body.style.transform = '';
        modal.classList.remove('active');
      });
    }

    document.addEventListener('click', (e) => {
        if (e.target == modal) {
          document.body.style.overflow = '';
          document.body.style.transform = '';
          modal.classList.remove('active');
        }
    });

    

    

    

    

    
      
    
      
    
      
    
        
          function startTimer() {
