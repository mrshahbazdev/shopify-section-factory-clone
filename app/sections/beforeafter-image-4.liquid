<script>
  function initScrollingProducts() {
    const slider = new Swiper(".before-after-slider-template--21118315266377__ss_before_after_image_4_VJtan4", {
      speed: 400,
      spaceBetween: 20,
      navigation: {
        nextEl: '.before-after-btn-next-template--21118315266377__ss_before_after_image_4_VJtan4',
        prevEl: '.before-after-btn-prev-template--21118315266377__ss_before_after_image_4_VJtan4',
      },
    });

    slider.on('slideChange', () => {
        const currentSlideIndex = slider.realIndex;
        const totalSlides = slider.slides.length;
        const currentSlideId = slider.slides[currentSlideIndex].id;

        document.querySelector('.before-after-current-template--21118315266377__ss_before_after_image_4_VJtan4').textContent = currentSlideIndex + 1;
        document.querySelector('.before-after-all-template--21118315266377__ss_before_after_image_4_VJtan4').textContent = totalSlides;

        const slideItems = document.querySelectorAll('.before-after-item-template--21118315266377__ss_before_after_image_4_VJtan4');
        slideItems.forEach(item => {
            let dataId = item.getAttribute('data-id');
            if (dataId === currentSlideId) {
                item.classList.add('active');
            } else {
                item.classList.remove('active');
            }
        });
    });
  }

  document.addEventListener('DOMContentLoaded', initScrollingProducts);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initScrollingProducts);
     document.addEventListener('shopify:section:load', initScrollingProducts);
  }
</script>
