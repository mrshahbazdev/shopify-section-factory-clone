<script>
  function initFaq19() {
    const sectionId = 'template--25195734794569__ss_faq_19_KtCk8H';
    const answerPaddingBottom = 0; 
    
    const itemClass = `.faq-item-${sectionId}`;
    const btnClass = `.faq-tab-toggle-${sectionId}`;
    const answerClass = `.faq-answer-${sectionId}`;
    const iconClass = `.faq-icon-${sectionId}`;
    const wrapperClass = `.faq-items-wrapper-template--25195734794569__ss_faq_19_KtCk8H`; 

    const realItems = Array.from(document.querySelectorAll(itemClass));

    const closeItem = (itemToClose) => {
        const answer = itemToClose.querySelector(answerClass);
        const icon = itemToClose.querySelector(iconClass);

        if (!answer || !itemToClose.classList.contains('active')) return;

        answer.style.height = answer.scrollHeight + 'px';
        answer.offsetHeight; // Force reflow
        
        answer.style.height = '0px';
        answer.style.paddingTop = '0px';
        answer.style.paddingBottom = '0px';
        itemToClose.classList.remove('active');
        if (icon) icon.classList.remove('active');
        
        const handleTransitionEnd = (e) => {
            if (e.propertyName === 'height') {
                answer.style.display = 'none';
                answer.removeEventListener('transitionend', handleTransitionEnd);
            }
        };
        answer.addEventListener('transitionend', handleTransitionEnd);
    };

    const closeOtherItems = (currentItem) => {
      const parentWrapper = currentItem.closest(wrapperClass);

      if (parentWrapper) {
          const siblings = parentWrapper.querySelectorAll(itemClass);
          
          siblings.forEach(sibling => {
              if (sibling !== currentItem) {
                  closeItem(sibling);
              }
          });
      } else {
          const allGroupItems = document.querySelectorAll(`.faq-group-item-${sectionId}`);
          
          allGroupItems.forEach(groupItem => {
              if (groupItem !== currentItem) {
                  closeItem(groupItem);
              }
          });
      }
    };

    realItems.forEach(item => {
      const button = item.querySelector(btnClass);
      const answer = item.querySelector(answerClass);
      const icon = item.querySelector(iconClass);

      if (!button || !answer) return;

      button.addEventListener('click', (e) => {
        e.stopPropagation(); 
        
        const isActive = item.classList.contains('active');

        if (isActive) {
          answer.style.height = answer.scrollHeight + 'px';
          answer.offsetHeight;
          
          answer.style.height = '0px';
          answer.style.paddingTop = '0px';
          answer.style.paddingBottom = '0px';
          item.classList.remove('active');
          if (icon) icon.classList.remove('active');
          
          const handleTransitionEnd = (e) => {
              if (e.propertyName === 'height') {
                  answer.style.display = 'none';
                  answer.removeEventListener('transitionend', handleTransitionEnd);
              }
          };
          answer.addEventListener('transitionend', handleTransitionEnd);

        } else {
          closeOtherItems(item);
          
          answer.style.display = 'block';
          answer.style.height = '0px';
          answer.style.paddingTop = '0px'; 
          answer.style.paddingBottom = '0px'; 
          
          const scrollHeight = answer.scrollHeight;
          answer.offsetHeight; // Force reflow

          answer.style.height = scrollHeight + 'px';
          answer.style.paddingBottom = answerPaddingBottom + 'px';
          item.classList.add('active');
          if (icon) icon.classList.add('active');
          
          const handleTransitionEnd = (e) => {
              if (e.propertyName === 'height') {
                  answer.style.height = 'auto';
                  answer.removeEventListener('transitionend', handleTransitionEnd);
              }
          };
          answer.addEventListener('transitionend', handleTransitionEnd);
        }
      });
    });
    
    window.addEventListener('resize', () => {
        realItems.forEach(item => {
            if (item.classList.contains('active')) {
                const answer = item.querySelector(answerClass);
                if (answer) {
                    answer.style.height = 'auto';
                }
            }
        });
    });
  }

  document.addEventListener('DOMContentLoaded', initFaq19);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initFaq19);
    document.addEventListener('shopify:section:load', initFaq19);
  }
</script>
