<script>
  (function () {
    var SEC = 'template--26298635845961__ss_free_shipping_bar_NLqWCb';
    var THRESHOLD = 7500;
    var MONEY_FORMAT = "${{amount}}";
    var PROGRESS_TEXT = "Add {amount} more to unlock free shipping";
    var SUCCESS_TEXT = "You've unlocked free shipping";
    var BAR_HEIGHT = 32;
    var TARGET_SEL = "";
    var INJECT_POS = "none";

    var RATE = 1;
    if (window.Shopify && window.Shopify.currency && window.Shopify.currency.rate) {
      RATE = parseFloat(window.Shopify.currency.rate) || 1;
    }

    var _lastProgress = window['__ssFSProgress_' + SEC] !== undefined
      ? window['__ssFSProgress_' + SEC]
      : 0;

    var _lastCartTotal = window['__ssFSCartTotal_' + SEC] !== undefined
      ? window['__ssFSCartTotal_' + SEC]
      : 0;

    function formatMoney(cents) {
      var val = cents / 100;
      var amount      = val.toFixed(2);
      var amountNoDec = Math.round(val).toString();
      return MONEY_FORMAT
        .replace(/\{\{\s*amount\s*\}\}/g,                                  amount)
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/g,                      amountNoDec)
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g,             amount.replace('.', ','))
        .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, amountNoDec.replace(/\B(?=(\d{3})+(?!\d))/g, ','));
    }

    function clampLeft(pct) {
      var root = document.getElementById('ss-fsbar-' + SEC);
      if (!root) return pct + '%';
      var track = root.querySelector('.ss-fsbar-track-' + SEC);
      if (!track) return pct + '%';
      var trackWidth = track.offsetWidth;
      if (!trackWidth) return pct + '%';
      var halfThumbPct = (BAR_HEIGHT / 2 / trackWidth) * 100;
      var clamped = Math.min(Math.max(pct, halfThumbPct), 100 - halfThumbPct);
      return clamped + '%';
    }

    function updateBar(cartTotalCents) {
      if (!THRESHOLD) return;

      var displayTotal     = Math.round(cartTotalCents * RATE);
      var displayThreshold = Math.round(THRESHOLD * RATE);
      var remaining        = Math.max(0, displayThreshold - displayTotal);
      var progress         = Math.min(100, (cartTotalCents / THRESHOLD) * 100);
      var reached          = cartTotalCents >= THRESHOLD;

      var root = document.getElementById('ss-fsbar-' + SEC);
      if (!root) return;

      var fill      = root.querySelector('.ss-fsbar-fill-'      + SEC);
      var thumbWrap = root.querySelector('.ss-fsbar-thumb-wrap-' + SEC);
      var track     = root.querySelector('.ss-fsbar-track-'     + SEC);
      var msg       = root.querySelector('.ss-fsbar-msg-'        + SEC);
      var amountEnd = root.querySelector('.ss-fsbar-amount-end-' + SEC);

      if (fill)      fill.style.width     = progress + '%';
      if (thumbWrap) thumbWrap.style.left = clampLeft(progress);
      if (amountEnd) amountEnd.textContent = formatMoney(displayThreshold);
      if (track)     track.setAttribute('aria-valuenow', Math.round(progress));

      if (reached) {
        if (msg) msg.textContent = SUCCESS_TEXT;
      } else {
        if (msg) {
          msg.innerHTML = PROGRESS_TEXT.replace(
            '{amount}',
            '<span class="money">' + formatMoney(remaining) + '</span>'
          );
          if (window.Currency && window.Currency.convertAll && window.Shopify && window.Shopify.currency) {
            window.Currency.convertAll(window.Shopify.currency.from, window.Shopify.currency.active);
          }
        }
      }

      _lastProgress = progress;
      _lastCartTotal = cartTotalCents;
      window['__ssFSProgress_' + SEC]  = progress;
      window['__ssFSCartTotal_' + SEC] = cartTotalCents;
    }

    function fetchCart() {
      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) { updateBar(cart.total_price); })
        .catch(function () {});
    }

    var PRODUCT_POSITIONS = ['above_buy', 'below_buy', 'above_title', 'below_title', 'above_description', 'below_description', 'below_price'];

    function buildClone(tpl) {
      var clone = tpl.content.firstElementChild.cloneNode(true);
      var cloneReached = _lastCartTotal >= THRESHOLD;
      var cloneFill      = clone.querySelector('.ss-fsbar-fill-'      + SEC);
      var cloneThumbWrap = clone.querySelector('.ss-fsbar-thumb-wrap-' + SEC);
      if (cloneFill)      cloneFill.style.width     = _lastProgress + '%';
      if (cloneThumbWrap) cloneThumbWrap.style.left = _lastProgress + '%';
      var cloneMsg = clone.querySelector('.ss-fsbar-msg-' + SEC);
      if (cloneMsg) {
        if (cloneReached) {
          cloneMsg.textContent = SUCCESS_TEXT;
        } else {
          var displayThreshold = Math.round(THRESHOLD * RATE);
          var remaining        = Math.max(0, displayThreshold - Math.round(_lastCartTotal * RATE));
          cloneMsg.innerHTML = PROGRESS_TEXT.replace(
            '{amount}',
            '<span class="money">' + formatMoney(remaining) + '</span>'
          );
        }
      }
      return clone;
    }

    function injectBar() {
      var tpl = document.getElementById('ss-fsbar-tpl-' + SEC);
      if (!tpl) return false;

      // Product page positions
      if (PRODUCT_POSITIONS.indexOf(INJECT_POS) > -1) {
        if (document.getElementById('ss-fsbar-' + SEC)) return true;

        var productSel;
        if (INJECT_POS === 'above_title' || INJECT_POS === 'below_title') {
          productSel = '.product__title';
        } else if (INJECT_POS === 'above_description' || INJECT_POS === 'below_description') {
          productSel = '.product__description';
        } else if (INJECT_POS === 'below_price') {
          productSel = '.price.price--large.price--show-badge';
        } else {
          productSel = '.button--add-to-cart, .product .product-form, .product-single__add-to-cart, .shopify-payment-button, .shopify-payment-button__button, .ProductForm__BuyButtons, .add-to-cart';
        }

        var productEl = document.querySelector(productSel);
        if (!productEl) return false;

        var adjacentPos = (INJECT_POS === 'below_buy' || INJECT_POS === 'below_title' || INJECT_POS === 'below_description' || INJECT_POS === 'below_price') ? 'afterend' : 'beforebegin';
        productEl.insertAdjacentElement(adjacentPos, buildClone(tpl));
        updateBar(_lastCartTotal);
        fetchCart();
        return true;
      }

      // Cart drawer / custom selector injection
      if (!TARGET_SEL) { fetchCart(); return true; }

      var target = document.querySelector(TARGET_SEL);
      if (!target) return false;

      if (target.querySelector('#ss-fsbar-' + SEC)) { return true; }

      var stale = document.getElementById('ss-fsbar-' + SEC);
      if (stale) stale.remove();

      var clone = buildClone(tpl);

      if (INJECT_POS === 'prepend') {
        target.insertBefore(clone, target.firstChild);
      } else {
        target.appendChild(clone);
      }

      updateBar(_lastCartTotal);
      fetchCart();
      return true;
    }

    var _ssObs = window['__ssFSObs_' + SEC];
    if (!_ssObs) {
      _ssObs = new MutationObserver(function () {
        if (!TARGET_SEL) return;
        var t = document.querySelector(TARGET_SEL);
        if (t && !t.querySelector('#ss-fsbar-' + SEC)) { injectBar(); }
      });
      window['__ssFSObs_' + SEC] = _ssObs;
    }

    function tryInject() {
      injectBar();
      if (TARGET_SEL) {
        _ssObs.observe(document.body, { childList: true, subtree: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', tryInject);
    } else {
      tryInject();
    }

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function () {
        setTimeout(tryInject, 100);
      });
    }

    ['cart:updated', 'cart.updated', 'Cart:Updated', 'theme:cart:updated',
     'cart-update', 'sections:rendered'].forEach(function (evt) {
      document.addEventListener(evt, fetchCart);
    });

    if (!window.__ssFSBarCartObserver) {
      window.__ssFSBarCartObserver = true;

      var CART_RE = /\/cart\/(add|update|change|clear)(\.js)?(\?|$)/;

      var _fetch = window.fetch;
      window.fetch = function (input, init) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        var p = _fetch.apply(this, arguments);
        if (CART_RE.test(url)) {
          p.then(function () {
            setTimeout(function () {
              document.dispatchEvent(new CustomEvent('ss:cart:updated'));
            }, 200);
          }).catch(function () {});
        }
        return p;
      };

      var _open = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function (method, url) {
        if (typeof url === 'string' && CART_RE.test(url)) {
          this.addEventListener('load', function () {
            setTimeout(function () {
              document.dispatchEvent(new CustomEvent('ss:cart:updated'));
            }, 200);
          });
        }
        return _open.apply(this, arguments);
      };

      document.addEventListener('submit', function (e) {
        var action = (e.target && e.target.action) || '';
        if (action.indexOf('/cart/add') !== -1) {
          setTimeout(function () {
            document.dispatchEvent(new CustomEvent('ss:cart:updated'));
          }, 600);
        }
      });
    }

    document.addEventListener('ss:cart:updated', fetchCart);

  })();
</script>
