  .ss-fsbar-thumb-wrap-template--26298635845961__ss_free_shipping_bar_NLqWCb {
    position: absolute;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    transition: left 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: left;
    z-index: 4;
    pointer-events: none;
  }

  .ss-fsbar-you-template--26298635845961__ss_free_shipping_bar_NLqWCb {
    position: absolute;
    bottom: calc(100% + 5px);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: #ff0000;
    line-height: 150%;
    white-space: nowrap;
  }

  .ss-fsbar-thumb-template--26298635845961__ss_free_shipping_bar_NLqWCb {
    width: 32px;
    height: 32px;
    border: 2px solid #ff0000;
    border-radius: 4px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ss-fsbar-thumb-template--26298635845961__ss_free_shipping_bar_NLqWCb svg {
    width: 55%;
    height: 55%;
    color: #ff0000;
  }

  .ss-fsbar-thumb-template--26298635845961__ss_free_shipping_bar_NLqWCb svg path,
  .ss-fsbar-thumb-template--26298635845961__ss_free_shipping_bar_NLqWCb svg circle,
  .ss-fsbar-thumb-template--26298635845961__ss_free_shipping_bar_NLqWCb svg rect,
  .ss-fsbar-thumb-template--26298635845961__ss_free_shipping_bar_NLqWCb svg polygon {
    fill: #ff0000;
  }

  .ss-fsbar-thumb-template--26298635845961__ss_free_shipping_bar_NLqWCb img {
    width: 58%;
    height: 58%;
    object-fit: contain;
  }

  .ss-fsbar-amounts-template--26298635845961__ss_free_shipping_bar_NLqWCb {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 700;
    color: #ff0000;
    line-height: 150%;
  }

  @media screen and (max-width: 749px) {
    .ss-fsbar-section-template--26298635845961__ss_free_shipping_bar_NLqWCb {
      padding-left: 0px;
      padding-right: 0px;
    }

    .ss-fsbar-msg-template--26298635845961__ss_free_shipping_bar_NLqWCb {
      font-size: 13px;
    }
  }
</style>
<div class="ss-fsbar-section-template--26298635845961__ss_free_shipping_bar_NLqWCb" id="ss-fsbar-template--26298635845961__ss_free_shipping_bar_NLqWCb">
<div class="ss-fsbar-inner-template--26298635845961__ss_free_shipping_bar_NLqWCb">
<p class="ss-fsbar-msg-template--26298635845961__ss_free_shipping_bar_NLqWCb">Add $75.00 more to unlock free shipping</p>
<div class="ss-fsbar-track-area-template--26298635845961__ss_free_shipping_bar_NLqWCb">
<div aria-label="Free shipping progress" aria-valuemax="100" aria-valuemin="0" aria-valuenow="0" class="ss-fsbar-track-template--26298635845961__ss_free_shipping_bar_NLqWCb" role="progressbar">
