    background: linear-gradient(to right, #ff0000, #ff0000);
    transition: width 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: width;
  }

  /* Label is outside the track so it never gets clipped by overflow:hidden */
  .ss-fsbar-ship-label-template--26298635845961__ss_free_shipping_bar_NLqWCb {
    position: absolute;
    right: 0;
    top: 0;
    height: 32px;
    display: flex;
