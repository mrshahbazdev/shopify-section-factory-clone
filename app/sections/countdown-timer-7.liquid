<script>
      function handleTickInit_timer_Qr9iTU(tick) {
        
        function debounce(func, delay) {
          let timeout;
          return function(...args) {
            const context = this;
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(context, args), delay);
          };
        }
        
        const endDateString = `2027/01/01 00:00:00`;
        const endDate = new Date(endDateString);

        const completedMessageElement = document.querySelector('.countdown-completed-text-timer_Qr9iTU');
        const timerWrapperElement = tick.root;

         function setTickFlipWidth() {
          const tickFlipElements = document.querySelectorAll('.countdown-numbers-timer_Qr9iTU .tick-flip');
          let maxWidth = 0;

          tickFlipElements.forEach(el => {
            el.style.width = ''; // Сброс ширины
            const currentWidth = el.offsetWidth;
            if (currentWidth > maxWidth) maxWidth = currentWidth;
          });
      
          if (maxWidth) {
            tickFlipElements.forEach(el => el.style.width = `${maxWidth}px`);
          }
        }
      
        const debouncedSetTickFlipWidth = debounce(setTickFlipWidth, 250);
        setTimeout(debouncedSetTickFlipWidth, 50); 
      
        window.addEventListener('resize', debouncedSetTickFlipWidth);

        const counter = Tick.count.down(endDate, {
          format: ['d', 'h', 'm', 's']
        });

        counter.onupdate = function(value) {
          tick.value = value;

          if (tick.root) {
            tick.root.setAttribute('aria-label',
              `Осталось: ${value.days} дней, ${value.hours} часов, ${value.minutes} минут, ${value.seconds} секунд`);
          }

          const labels = {
            d: "Days",
            h: "Hours",
            m: "Minutes",
            s: "Seconds"
          };

          tick.root.querySelectorAll('[data-key="label"]').forEach((el, index) => {
            const keys = ['d', 'h', 'm', 's'];
            const key = keys[index];
            el.textContent = labels[key];
          });
        };

        counter.onended = function() {
          
            tick.value = { days: 0, hours: 0, minutes: 0, seconds: 0 };
            if (completedMessageElement) {
              completedMessageElement.style.display = 'block';
            }
          
        };
      }

      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', function(event) {
          if (event.detail.sectionId === 'template--23974823887177__ss_countdown_timer_7_iyrEAQ') {
            const tickElements = event.detail.section.querySelectorAll('.tick-timer_Qr9iTU');
            tickElements.forEach(tickElement => {
              if (tickElement.Tick) {
                tickElement.Tick.unmount();
              }
              Tick.mount(tickElement);
            });
          }
        });

        document.addEventListener('shopify:section:unload', function(event) {
          if (event.detail.sectionId === 'template--23974823887177__ss_countdown_timer_7_iyrEAQ') {
            const tickElements = event.detail.section.querySelectorAll('.tick-timer_Qr9iTU');
            tickElements.forEach(tickElement => {
