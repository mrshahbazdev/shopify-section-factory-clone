<script>
          (function () {
            function sliderInit() {
              let activeSlideIndex = 0;

              const productCards = document.querySelectorAll(
                '.product-card-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6'
              );
              const imageButtons = document.querySelectorAll(
                '.button-on-image-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6'
              );
              function switchProduct(index) {
                // use .product-card--active-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6 to toggle active class:
                productCards.forEach((card, i) => {
                  if (i === index) {
                    card.classList.add('product-card--active-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6');
                  } else {
                    card.classList.remove(
                      'product-card--active-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6'
                    );
                  }
                });
                // toggle button-on-image--active-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6
                imageButtons.forEach((button, i) => {
                  if (i === index) {
                    button.classList.add(
                      'button-on-image--active-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6'
                    );
                  } else {
                    button.classList.remove(
                      'button-on-image--active-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6'
                    );
                  }
                });
                activeSlideIndex = index;

                // check if .scroll-area-bleed-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6 exists, if so, scroll to the product card:
                const scrollArea = document.querySelector(
                  '.scroll-area-bleed-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6'
                );
                if (scrollArea) {
                  // scroll to the product-mobile-card-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6:
                  const productCards = document.querySelectorAll(
                    '.product-mobile-card-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6'
                  );
                  // use the activeSlideIndex to find the product card to scroll to:
                  const productCard = productCards[activeSlideIndex];
                  scrollArea.scrollTo({
                    left: productCard.offsetLeft,
                    behavior: 'smooth',
                  });
                }
              }
              imageButtons.forEach((button, i) => {
                button.addEventListener('click', () => {
                  switchProduct(i);
                });
              });
              // find .arrow-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6 data-prev, data-next, on click:
              const prevArrow = document.querySelector(
                '.arrow-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6[data-prev]'
              );
              const nextArrow = document.querySelector(
                '.arrow-template--19238128812361__73648c52-7c04-47b4-9e67-fc363281e4e6[data-next]'
              );
              prevArrow.addEventListener('click', () => {
                if (activeSlideIndex === 0) {
                  switchProduct(productCards.length - 1);
                } else {
                  switchProduct(activeSlideIndex - 1);
                }
              });
              nextArrow.addEventListener('click', () => {
                if (activeSlideIndex === productCards.length - 1) {
                  switchProduct(0);
                } else {
                  switchProduct(activeSlideIndex + 1);
                }
              });
            }
            sliderInit();
            if (window.Shopify && Shopify.designMode) {
              document.addEventListener('shopify:section:load', sliderInit);
            }
          })();
        </script>
