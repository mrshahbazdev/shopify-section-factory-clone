<script>
  function initSizeGuide() {
    setTimeout(() => {

      let toggle = document.querySelector('.size-toggle-template--21545953362249__ss_size_guide_7nzzFh');
      const modal = document.querySelector('.size-modal-template--21545953362249__ss_size_guide_7nzzFh');
      const close = document.querySelector('.size-modal-close-template--21545953362249__ss_size_guide_7nzzFh');
      if(toggle) {
        toggle.addEventListener('click', () => {
          document.body.style.overflow = 'hidden';
          modal.classList.add('active');
        })
      }

      close.addEventListener('click', () => {
          document.body.style.overflow = '';
          modal.classList.remove('active');
      });
      
      document.addEventListener('click', (e) => {
          if (e.target == modal) {
            document.body.style.overflow = '';
            modal.classList.remove('active');
          }
      });

    let toggles = document.querySelectorAll('.size-modal-toggle-template--21545953362249__ss_size_guide_7nzzFh');
    let tabs = document.querySelectorAll('.size-modal-tab-template--21545953362249__ss_size_guide_7nzzFh');
    if(toggles) {
      toggles.forEach(el => {
        el.addEventListener('click', () => {

          toggles.forEach(element => {
            element.classList.remove('active');
          })

          el.classList.add('active');
          
          if(tabs) {
            tabs.forEach(element => {
              let dataId = element.getAttribute('data-id');
              if(el.id == dataId) {
                element.classList.add('active');
              } else {
                element.classList.remove('active');
              }
            })
          };
        })
      })
    }
      
    }, 400)
  }
  
  document.addEventListener('DOMContentLoaded', initSizeGuide);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initSizeGuide);
     document.addEventListener('shopify:section:load', initSizeGuide);
  }
</script>
