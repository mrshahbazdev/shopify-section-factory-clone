<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  function initVideoSlider3() {
  
    const settings = {
      sliderView: document.querySelector('.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae').dataset.sliderView,
      sliderViewMobile: document.querySelector('.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae').dataset.sliderViewMobile,
      sliderViewTablet: document.querySelector('.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae').dataset.sliderViewTablet,
      sliderGap: document.querySelector('.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae').dataset.sliderGap,
      sliderGapMobile: document.querySelector('.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae').dataset.sliderGapMobile,
      sliderRotate: document.querySelector('.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae').dataset.sliderRotate
    };
  
    document.querySelector(`.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae`).classList.remove('preview');
  
    
  
    const slider = new Swiper(`.video-slider-slider-template--23082610327881__ss_video_slider_3_ANDgae`, {
      centeredSlides: true,
      navigation: {
        nextEl: `.video-slider-btn-next-template--23082610327881__ss_video_slider_3_ANDgae`,
        prevEl: `.video-slider-btn-prev-template--23082610327881__ss_video_slider_3_ANDgae`
      },
      loopAdditionalSlides: 4,
      loopedSlides: 4,
      loop: true,
      initialSlide: 0,
      breakpoints: {
        320: {
          slidesPerView: parseFloat(settings.sliderViewMobile),
          spaceBetween: parseInt(settings.sliderGapMobile),
        },
        768: {
          slidesPerView: parseFloat(settings.sliderViewTablet),
          spaceBetween: parseInt(settings.sliderGapMobile),
        },
        1024: {
          slidesPerView: parseFloat(settings.sliderView),
          spaceBetween: parseInt(settings.sliderGap),
        }
      },
      on: {
        slideChange: function() {
          const slides = this.slides;
          let activeSlide = slides[this.activeIndex];
  
          slides.forEach(slide => {
            let video = slide.querySelector('video');
            let frame = slide.querySelector('iframe');
            let btn = slide.querySelector(`.video-slider-action-template--23082610327881__ss_video_slider_3_ANDgae`);
  
            if (video) {
              video.pause();
            }
  
            if(frame) {
              let src2 = frame.getAttribute('data-src2');
              frame.src = src2;
            }
  
            if (btn) {
              btn.classList.remove('active');
            }
          });
  
          if(activeSlide) {
            let video = activeSlide.querySelector('video');
            let frame = activeSlide.querySelector('iframe');
            let btn = activeSlide.querySelector(`.video-slider-action-template--23082610327881__ss_video_slider_3_ANDgae`);
  
            if (video) {
              video.play();
            }
  
            if(frame) {
              let src1 = frame.getAttribute('data-src1');
              frame.src = src1;
            }
  
            if (btn) {
              btn.classList.add('active');
            }
          }   
        }
      }
    });
  
    document.querySelectorAll(`.video-slider-slide-template--23082610327881__ss_video_slider_3_ANDgae`).forEach(el => {
      let btn = el.querySelector(`.video-slider-action-template--23082610327881__ss_video_slider_3_ANDgae`);
      let soundBtn = el.querySelector(`.video-slider-sound-template--23082610327881__ss_video_slider_3_ANDgae`);
      let frame = el.querySelector('iframe');
      let video = el.querySelector('video');
      
      if(btn) {
        btn.addEventListener('click', () => {
          btn.classList.toggle('active');
          if(btn.classList.contains('active')) {
            document.querySelectorAll(`.video-slider-slide-template--23082610327881__ss_video_slider_3_ANDgae`).forEach(element => {
              if(el != element) {
                let btn = element.querySelector(`.video-slider-action-template--23082610327881__ss_video_slider_3_ANDgae`);
                let frame = element.querySelector('iframe');
                let video = element.querySelector('video');
                if(btn) {
                  btn.classList.remove('active');
                }
  
                if(frame) {
                  let src2 = frame.getAttribute('data-src2');
                  frame.src = src2;
                }
                if(video) {
                  video.pause();
                }
              }
            });
  
            if(frame) {
              let src1 = frame.getAttribute('data-src1');
              frame.src = src1;
            }
            if(video) {
              video.play();
            }
          } else {
            if(frame) {
              let src2 = frame.getAttribute('data-src2');
              frame.src = src2;
            }
            if(video) {
              video.pause();
            }
          }
        });
      }
  
      if(soundBtn) {
        soundBtn.addEventListener('click', () => {
          soundBtn.classList.toggle('active');
          if(soundBtn.classList.contains('active')) {
            if(frame) {
              let src = frame.getAttribute("src");
              var muteIndex = src.indexOf("mute=");
              var muteValue = src.charAt(muteIndex + 5);
              if (muteValue === "1") {
                frame.src = src.slice(0, muteIndex + 5) + "0" + src.slice(muteIndex + 6);
              }
            }
            if(video) {
              video.muted = false;
            }
          } else {
            if(frame) {
              let src = frame.getAttribute("src");
              var muteIndex = src.indexOf("mute=");
              var muteValue = src.charAt(muteIndex + 5);
              if (muteValue === "0") {
                frame.src = src.slice(0, muteIndex + 5) + "1" + src.slice(muteIndex + 6);
              }
            }
            if(video) {
              video.muted = true;
            }
          }
        });
      }
    });
  }
  
  document.addEventListener('DOMContentLoaded', initVideoSlider3);
  
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initVideoSlider3);
    document.addEventListener('shopify:section:load', initVideoSlider3);
  }
</script>
