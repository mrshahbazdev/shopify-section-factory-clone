<section id="section-{{ section.id }}" class="section-store-footer-10 section-style-4">
<style>
.section-store-footer-10 {
  --bg: #ecfeff;
  --fg: #083344;
  --accent: #06b6d4;
  --radius: 24px;
  --align: left;
  --shadow: 0 6px 28px rgba(0,0,0,0.07);
  --sectionPadding: 80px 20px;
  background: var(--bg);
  color: var(--fg);
}
.section-store-footer-10 .ss-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--sectionPadding);
  text-align: var(--align);
}
.section-store-footer-10 .ss-title {
  font-size: clamp(2.2rem, 5vw, 3.75rem);
  font-weight: 800;
  line-height: 1.05;
  margin: 0 0 18px;
  letter-spacing: -0.02em;
}
.section-store-footer-10 .ss-subtitle {
  font-size: 1.15rem;
  line-height: 1.7;
  opacity: 0.85;
  max-width: 680px;
  margin: 0 auto 28px;
}
.section-store-footer-10 .ss-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 32px;
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius);
  text-decoration: none;
  font-weight: 600;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.section-store-footer-10 .ss-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,0.18);
}
.section-store-footer-10 img { max-width: 100%; height: auto; border-radius: var(--radius); }
.section-store-footer-10 .placeholder-image {
  border-radius: var(--radius);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
}
</style>
<div class="ss-wrap">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; text-align: left;">
    <div>
      <h3 style="margin: 0 0 12px; font-size: 1.125rem;">About</h3>
      <p style="margin: 0; opacity: 0.8;">{{ section.settings.subheading }}</p>
    </div>
    <div>
      <h3 style="margin: 0 0 12px; font-size: 1.125rem;">Newsletter</h3>
      <input type="email" placeholder="Email address" style="padding: 10px 14px; border-radius: var(--radius); border: 1px solid rgba(0,0,0,0.2); width: 100%; max-width: 240px;" />
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Footer #10",
  "tag": "section",
  "class": "section-store-footer-10",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Add your subheading here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Footer #10"
    }
  ]
}
{% endschema %}
</section>
