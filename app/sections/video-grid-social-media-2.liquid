            let frame = slides[i].querySelector('iframe');
            let btn = slides[i].querySelector('.video-social-action-template--20528255861065__video_from_social_2_qPHkjj');
            let src3;
            let src2;
            let src1;
            if(frame) {
              src3 = frame.getAttribute('data-src3');
              src2 = frame.getAttribute('data-src2');
              src1 = frame.getAttribute('data-src1');
            }
    
            if (i === this.activeIndex) {
              if (video) {
                video.play();
              }

              if(btn) {
                if(btn.classList.contains('active')) {
                  if(frame) {
                    frame.src = src1;
                  }
                } else {
                  if(frame) {
                    frame.src = src3;
                  }
                }
              } else {
                if(frame) {
                  frame.src = src3;
                }
