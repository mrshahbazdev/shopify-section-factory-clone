<script>
  function isSafari() {  
    const userAgent = navigator.userAgent;  
    return /^((?!chrome|android).)*safari/i.test(userAgent);  
  } 
  
  function initNavigationTabs() {
    let sections = document.querySelectorAll('.shopify-section');  
    let body = document.querySelector('.navigation-tabs-body-template--21626811187529__ss_navigation_tabs_WzE3RC');
    let titles = "Product Details,Design History, Product Benefits,Comparison Chart,Similar Products";
    let titlesArray = titles.split(",");
    let belowThisSection = false;
    let count = 0;
    if (sections) {  
      sections.forEach((el, i) => {
        let itemId = el.id;
        if (![...el.children].some(child => child.tagName === 'TEMPLATE')) {  
          
if(itemId != "shopify-section-header" && !itemId.includes("footer") && itemId != "shopify-section-announcement-bar") {
  if(belowThisSection) {
    let anchorText = titlesArray[count] || "Title";
    let anchor = `<a href="#${itemId}" class="navigation-tabs-item-template--21626811187529__ss_navigation_tabs_WzE3RC">${anchorText}</a>`;
    body.insertAdjacentHTML('beforeend', anchor);   
    count++;
  }
  if(itemId == "shopify-section-template--21626811187529__ss_navigation_tabs_WzE3RC") {
    belowThisSection = true;
  }
}

          
        } 
        
      });  
    }

    setTimeout(() => {
      let items = document.querySelectorAll('.navigation-tabs-item-template--21626811187529__ss_navigation_tabs_WzE3RC');
      
      if (items) {  
        items.forEach(el => {
          
          el.addEventListener('click', (event) => {  
              event.preventDefault();  
              const targetId = el.getAttribute('href');  
              if (targetId) {  
                  const targetElement = document.querySelector(targetId);  
                  if (targetElement) {  
                      const elementPosition = targetElement.getBoundingClientRect().top + window.scrollY;
                      const offsetPosition = elementPosition - 100;
                      
                      window.scrollTo({  
                          top: offsetPosition,  
                          behavior: 'smooth'
                      });  
                  }  
              }  
          });
        });

        
          window.addEventListener('scroll', () => {  
            let foundActive = false;  
        
            items.forEach(el => {  
                const targetId = el.getAttribute('href');  
                if (targetId) {  
                    const targetElement = document.querySelector(targetId);  
                    if (targetElement) {  
                        const rect = targetElement.getBoundingClientRect();  
                        const windowHeight = window.innerHeight;  
        
                        const visibleHeight = Math.max(0, Math.min(rect.bottom, windowHeight) - Math.max(rect.top, 0));  
         
                        if (visibleHeight >= (rect.height / 2)) {  
                            if (!foundActive) {  
                                el.classList.add('active');  
                                foundActive = true;
                                const offsetLeft = el.offsetLeft;
                                if (!isSafari()) {
                                  body.scrollTo({  
                                    left: offsetLeft,  
                                    behavior: 'smooth'
                                  });
                                }
                            }  
                        } else {  
                            el.classList.remove('active');  
                        }  
                    }  
                }  
            });  
        }); 
      
      }

      
        if(sections) {
          sections.forEach(section => {
            if(section.id.includes('template--21626811187529__ss_navigation_tabs_WzE3RC')) {
              section.style.position = 'sticky';
              section.style.top = '0px';
              section.style.backgroundColor = '#faf7f1';
              section.style.backgroundImage = '';
              section.style.zIndex = '3';
            }
          })
        }
      
    }, 400);   
  }

  document.addEventListener('DOMContentLoaded', initNavigationTabs);
</script>
