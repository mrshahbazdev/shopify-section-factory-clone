                    el.classList.remove('hidden-template--21743914549577__ss_comparison_table_8_hyj9Y9');
                  } else {
                    el.classList.add('hidden-template--21743914549577__ss_comparison_table_8_hyj9Y9');
                  }
                })
              }
              
            })
          } 
        } else {
          if(buttonView) {
            buttonView.style.display = "none";
          }
        }
      })
    }

