<script>
  function initScrollingProducts() {
    const slider = new Swiper(".slideshow-slider-template--21155050291529__ss_slideshow_5_7r8J3X", {
      speed: 400,
      spaceBetween: 20,
      loop: true,
      
      autoplay: {
        delay: 6000,
      },
      
      navigation: {
        nextEl: '.slideshow-btn-next-template--21155050291529__ss_slideshow_5_7r8J3X',
        prevEl: '.slideshow-btn-prev-template--21155050291529__ss_slideshow_5_7r8J3X',
      },
      pagination: {
        el: '.slideshow-pagination-template--21155050291529__ss_slideshow_5_7r8J3X',
        type: 'bullets',
        clickable: true,
      },
    });

    let btn = document.querySelector('.slideshow-button-autoplay-template--21155050291529__ss_slideshow_5_7r8J3X');
    if(btn) {
      btn.addEventListener('click', () => {
        const slider = document.querySelector(".slideshow-slider-template--21155050291529__ss_slideshow_5_7r8J3X").swiper;
        if (slider.autoplay.running) {
          slider.autoplay.stop();
          btn.classList.remove('play');
        } else {
          slider.autoplay.start();
          btn.classList.add('play');
        }
      })
    }
  }

  document.addEventListener('DOMContentLoaded', initScrollingProducts);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initScrollingProducts);
     document.addEventListener('shopify:section:load', initScrollingProducts);
  }
</script>
