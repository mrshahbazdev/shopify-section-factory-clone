<script>
  (function () {
    function initGallery() {
      const modal = document.querySelector('.gallery-modal-popup-template--26377091481929__ss_gallery_10_JpJPYY');
      const close = document.querySelector('.gallery-modal-popup-close-template--26377091481929__ss_gallery_10_JpJPYY');
      const mainList = document.querySelector('.gallery-modal-list-template--26377091481929__ss_gallery_10_JpJPYY');
      const leftItems = document.querySelectorAll(
        '.gallery-modal-left-list-template--26377091481929__ss_gallery_10_JpJPYY .gallery-modal-item-template--26377091481929__ss_gallery_10_JpJPYY'
      );

      if (!modal) return;

      function updateActiveItem(activeId) {
        leftItems.forEach((item) => {
          const link = item.querySelector('a');
          if (link) {
            const href = link.getAttribute('href').replace('#', '');
            item.classList.toggle('active', href === activeId);
          }
        });

        const activeLeft = document.querySelector(
          `.gallery-modal-left-list-template--26377091481929__ss_gallery_10_JpJPYY .gallery-modal-item-template--26377091481929__ss_gallery_10_JpJPYY.active`
        );
        if (activeLeft) {
          activeLeft.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              updateActiveItem(entry.target.id);
            }
          });
        },
        {
          root: mainList,
          threshold: 0.5,
        }
      );

      document
        .querySelectorAll('.gallery-modal-list-template--26377091481929__ss_gallery_10_JpJPYY .gallery-modal-item-template--26377091481929__ss_gallery_10_JpJPYY')
        .forEach((item) => {
          observer.observe(item);
        });

      document.querySelectorAll('.gallery-item-template--26377091481929__ss_gallery_10_JpJPYY').forEach((item) => {
        item.addEventListener('click', function () {
          const blockId = this.dataset.id;
          if (!blockId) return;

          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
          document.body.style.transform = 'none';

          setTimeout(() => {
            const target = document.getElementById(blockId);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            updateActiveItem(blockId);
          }, 50);
        });
      });

      leftItems.forEach((item) => {
        item.addEventListener('click', function () {
          const link = this.querySelector('a');
          if (!link) return;
          const targetId = link.getAttribute('href').replace('#', '');
          const target = document.getElementById(targetId);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          updateActiveItem(targetId);
        });
      });

      if (close) {
        close.addEventListener('click', closeModal);
      }

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      function closeModal() {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        document.body.style.transform = '';
      }
    }

    document.addEventListener('DOMContentLoaded', initGallery);

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail.sectionId === 'template--26377091481929__ss_gallery_10_JpJPYY') {
          initGallery();
        }
      });
    }
  })();
</script>
