<script>
  function initTestimonials49() {
    const wrapper = document.querySelector('.testimonial-scrolling-wrapper-template--25378159460681__ss_testimonials_49_pihrwE');
    if (!wrapper) return;
    
    const lists = wrapper.querySelectorAll('.testimonial-scrolling-list-template--25378159460681__ss_testimonials_49_pihrwE');
    
    let isDragging = false;
    let startX = 0;
    let currentLeft = 0;
    let prevLeft = 0;
    
    function getLeft(element) {
      const style = window.getComputedStyle(element);
      return parseFloat(style.left) || 0;
    }
    
    wrapper.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX;
      
      lists.forEach(list => {
        list.style.position = 'relative';
        prevLeft = getLeft(list);
      });
      
      wrapper.style.cursor = 'grabbing';
      wrapper.style.userSelect = 'none';
    });
    
    wrapper.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      
      const currentX = e.pageX;
      const diff = currentX - startX;
      currentLeft = prevLeft + diff;
      
      lists.forEach(list => {
        list.style.left = `${currentLeft}px`;
      });
    });
    
    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      wrapper.style.cursor = 'grab';
      wrapper.style.userSelect = '';
    }
    
    wrapper.addEventListener('mouseup', endDrag);
    wrapper.addEventListener('mouseleave', endDrag);
    wrapper.addEventListener('dragstart', (e) => e.preventDefault());
    
    wrapper.style.cursor = 'grab';
  }

  document.addEventListener('DOMContentLoaded', initTestimonials49);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initTestimonials49);
    document.addEventListener('shopify:section:load', initTestimonials49);
  }
</script>
