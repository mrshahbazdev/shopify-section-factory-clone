<section id="section-{{ section.id }}" class="section-store-404-page section-style-1">
<style>
.section-store-404-page {
  --bg: #111827;
  --fg: #ffffff;
  --accent: #38bdf8;
  --radius: 12px;
  --align: center;
  --shadow: 0 8px 32px rgba(0,0,0,0.25);
  --sectionPadding: 96px 20px;
  background: var(--bg);
  color: var(--fg);
}
.section-store-404-page .ss-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--sectionPadding);
  text-align: var(--align);
}
.section-store-404-page .ss-title {
  font-size: clamp(2.2rem, 5vw, 3.75rem);
  font-weight: 800;
  line-height: 1.05;
  margin: 0 0 18px;
  letter-spacing: -0.02em;
}
.section-store-404-page .ss-subtitle {
  font-size: 1.15rem;
  line-height: 1.7;
  opacity: 0.85;
  max-width: 680px;
  margin: 0 auto 28px;
}
.section-store-404-page .ss-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 32px;
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius);
  text-decoration: none;
  font-weight: 600;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.section-store-404-page .ss-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,0.18);
}
.section-store-404-page img { max-width: 100%; height: auto; border-radius: var(--radius); }
.section-store-404-page .placeholder-image {
  border-radius: var(--radius);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
}
</style>
<div class="ss-wrap">
  <div style="display: flex; flex-wrap: wrap; gap: 32px; align-items: center; flex-direction: row-reverse; text-align: center;">
    <div style="flex: 1 1 320px; min-width: 280px;">
      {% if section.settings.image %}
  <img src="{% section.settings.image | image_url: width: 900 %}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="675" style="border-radius: var(--radius); width: 100%;" />
{% else %}
  <div style="aspect-ratio: 4/3; background: linear-gradient(135deg, rgba(0,0,0,0.05), rgba(0,0,0,0.1)); border-radius: var(--radius); display: grid; place-items: center; color: var(--fg); opacity: 0.5; font-weight: 600;">Image</div>
{% endif %}
    </div>
    <div style="flex: 1 1 320px; min-width: 280px;">
      <h2 class="ss-title">{{ section.settings.heading }}</h2>
      <div class="ss-subtitle">{{ section.settings.subheading }}</div>
      <a class="ss-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section-store-404-page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Add your subheading here.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "404 page"
    }
  ]
}
{% endschema %}
</section>
