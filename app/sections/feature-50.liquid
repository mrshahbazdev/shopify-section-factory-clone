<script>
  function initFeatureLines50template24699290124617__ss_feature_50_qkTeGX() {
    

    function startDraw() {
      let isMobile = window.matchMedia('(max-width: 1024px)').matches;

      if(!isMobile) {      
        const sectionEl = document.querySelector('.section-template--24699290124617__ss_feature_50_qkTeGX');
