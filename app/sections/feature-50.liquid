          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => { 
            resetLinesAndClasses(); 
            updateFeatureState(observer.root !== null && sectionEl.getBoundingClientRect().top < window.innerHeight);
          }, 250);
        });
      } else {
        const featureItems = document.querySelectorAll('.feature-feature-template--24699290124617__ss_feature_50_qkTeGX');
        const dots = document.querySelectorAll('.feature-dot-template--24699290124617__ss_feature_50_qkTeGX');
        const svgContainer = document.querySelector(`.feature-lines-svg-template--24699290124617__ss_feature_50_qkTeGX`);        

        function setActiveFeature(activeElement) {
