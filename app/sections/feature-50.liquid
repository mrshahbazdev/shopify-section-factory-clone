            desktopFeatures.forEach(item => item.classList.remove('active'));
            document.querySelectorAll('.feature-dot-template--24699290124617__ss_feature_50_qkTeGX').forEach(dot => dot.classList.remove('active'));

            featureItem.classList.add('active');
            const activeDot = sectionEl.querySelector(`.feature-dot-template--24699290124617__ss_feature_50_qkTeGX[data-id="${featureItem.id}"]`);
            if (activeDot) {
              activeDot.classList.add('active');
            }
          });
        });

        let resizeTimer;
