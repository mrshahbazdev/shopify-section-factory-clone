# Shopify Partner app credentials (found in Partner Dashboard > App setup)
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://sections.clipvaultz.online"
SCOPES="read_themes,write_themes,read_products,read_metaobjects,write_metaobjects,read_files,write_files,read_orders,read_customers"

# Option A: full MySQL connection string (recommended)
DATABASE_URL="mysql://user:password@host:3306/section_factory"

# Option B: separate DB credentials (used if DATABASE_URL is empty)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="section_factory"

PORT=3000
NODE_ENV=production
