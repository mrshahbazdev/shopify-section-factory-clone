// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id            String   @id @default(cuid()) @db.VarChar(120)
  shop          String   @unique @db.VarChar(120)
  plusEnabled   Boolean  @default(false)
  plusTrialEnds DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Section {
  id          String             @id @default(cuid()) @db.VarChar(120)
  handle      String             @unique @db.VarChar(120)
  title       String             @db.VarChar(200)
  description String?            @db.Text
  price       Int                @default(0) // price in cents
  isPro       Boolean            @default(false)
  imageUrl    String?            @db.VarChar(500)
  category    String             @db.VarChar(120)
  groups      String             @default("") @db.VarChar(500) // comma-separated feature groups
  shopifyUrl  String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  purchases   SectionPurchase[]
  installs    InstalledSection[]
  bundleItems BundleItem[]
}

model Category {
  id        String @id @default(cuid()) @db.VarChar(120)
  handle    String @unique @db.VarChar(120)
  title     String @db.VarChar(200)
  sortOrder Int    @default(99)
}

model SectionPurchase {
  id        String   @id @default(cuid()) @db.VarChar(120)
  shop      String   @db.VarChar(120)
  sectionId String   @db.VarChar(120)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  chargeId  String?
  amount    Int
  currency  String   @default("USD") @db.VarChar(10)
  status    String   @default("paid") @db.VarChar(20) // paid | refunded
  createdAt DateTime @default(now())
}

model InstalledSection {
  id        String   @id @default(cuid()) @db.VarChar(120)
  shop      String   @db.VarChar(120)
  sectionId String   @db.VarChar(120)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  themeId   String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  @@unique([shop, sectionId])
}

model Bundle {
  id          String        @id @default(cuid()) @db.VarChar(120)
  shop        String        @db.VarChar(120)
  title       String        @db.VarChar(200)
  discountPct Int           @default(0)
  items       BundleItem[]
  status      String        @default("draft") @db.VarChar(20) // draft | published
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BundleItem {
  id        String  @id @default(cuid()) @db.VarChar(120)
  bundleId  String  @db.VarChar(120)
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  sectionId String  @db.VarChar(120)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}
